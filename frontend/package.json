{
  "name": "journalm8-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "VITE_APP_STAGE=dev tsc -b && VITE_APP_STAGE=dev vite build --mode development",
    "build:staging": "VITE_APP_STAGE=staging tsc -b && VITE_APP_STAGE=staging vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "build:prod": "npm run build:production",
    "typecheck": "tsc -b",
    "test": "node --test scripts/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
