#!/usr/bin/env bash
set -euo pipefail

: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"

MODEL_ID="${BEDROCK_ANALYSIS_MODEL_ID:-us.anthropic.claude-haiku-4-5-20251001-v1:0}"

MODEL_ID="$(printf '%s' "$MODEL_ID" | tr -d '[:space:]')"

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
POLICY_NAME="${APP_NAME}-${STAGE}-bedrock-analysis"

SCHEMA_VERSION="${ANALYSIS_SCHEMA_VERSION:-2.0}"
PROMPT_VERSION="${ANALYSIS_PROMPT_VERSION:-journal-analysis-v1}"

mkdir -p .build/bedrock

echo "Resolving Bedrock inference profile..."

aws bedrock get-inference-profile \
  --inference-profile-identifier "$MODEL_ID" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --output json \
  > .build/bedrock/inference-profile.json

python3 - \
  .build/bedrock/inference-profile.json \
  .build/bedrock/bedrock-analysis-policy.json <<'PY'
import json
import sys
from pathlib import Path

profile_path = Path(sys.argv[1])
policy_path = Path(sys.argv[2])

profile = json.loads(profile_path.read_text())

profile_arn = str(
    profile.get("inferenceProfileArn") or ""
).strip()

model_arns = sorted({
    str(model.get("modelArn") or "").strip()
    for model in profile.get("models", [])
    if str(model.get("modelArn") or "").strip()
})

if not profile_arn:
    raise SystemExit(
        "The Bedrock inference profile ARN was not returned."
    )

if not model_arns:
    raise SystemExit(
        "The inference profile returned no destination models."
    )

policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadJM8AnalysisInferenceProfile",
            "Effect": "Allow",
            "Action": [
                "bedrock:GetInferenceProfile",
            ],
            "Resource": profile_arn,
        },
        {
            "Sid": "InvokeJM8AnalysisInferenceProfile",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
            ],
            "Resource": profile_arn,
        },
        {
            "Sid": "InvokeJM8AnalysisDestinationModels",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
            ],
            "Resource": model_arns,
            "Condition": {
                "StringEquals": {
                    "bedrock:InferenceProfileArn": profile_arn,
                },
            },
        },
    ],
}

policy_path.write_text(
    json.dumps(policy, indent=2) + "\n"
)

print(
    "Destination model resources:",
    len(model_arns),
)
PY

echo "Attaching Bedrock policy to the JM8 Lambda role..."

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$POLICY_NAME" \
  --policy-document \
    file://.build/bedrock/bedrock-analysis-policy.json \
  --profile "$AWS_PROFILE"

python3 - \
  .env \
  "$MODEL_ID" \
  "$SCHEMA_VERSION" \
  "$PROMPT_VERSION" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])

updates = {
    "BEDROCK_ANALYSIS_MODEL_ID": sys.argv[2],
    "ANALYSIS_SCHEMA_VERSION": sys.argv[3],
    "ANALYSIS_PROMPT_VERSION": sys.argv[4],
}

lines = (
    path.read_text().splitlines()
    if path.exists()
    else []
)

for key, value in updates.items():
    replacement = f"export {key}={value}"
    replaced = False

    for index, line in enumerate(lines):
        stripped = line.strip()

        if (
            stripped.startswith(f"{key}=")
            or stripped.startswith(f"export {key}=")
        ):
            lines[index] = replacement
            replaced = True
            break

    if not replaced:
        lines.append(replacement)

path.write_text("\n".join(lines).rstrip() + "\n")
PY

echo
echo "Bedrock analyzer foundation configured."
echo "Model ID: $MODEL_ID"
echo "Schema version: $SCHEMA_VERSION"
echo "Prompt version: $PROMPT_VERSION"
echo "Lambda role policy attached: $POLICY_NAME"
echo
echo "Run: source .env"
