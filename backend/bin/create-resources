#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
# Every mutating script must validate the environment before proceeding
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${ENTRY_CHUNKS_TABLE_NAME:?ENTRY_CHUNKS_TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${ALLOWED_ORIGINS:?ALLOWED_ORIGINS is required. Run: source .env}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
export JM8_OPERATION="create-resources"
jm8_validate_contract_or_exit

ALLOWED_ORIGINS_JSON="$(python3 "$SCRIPT_DIR/jm8_environment_contract.py" allowed-origins-json)"

mkdir -p .build

# Fetch actual account ID from STS for use in deployment
ACCOUNT_ID=$(aws sts get-caller-identity --profile "$AWS_PROFILE" --query Account --output text)

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
POLICY_NAME="${APP_NAME}-${STAGE}-app-access-policy"
LAMBDA_TRUST_POLICY="$SCRIPT_DIR/../infra/lambda-trust-policy.json"

ensure_lambda_role() {
  local role_lookup_rc
  local role_lookup_error

  echo "Resolving Lambda IAM role: $ROLE_NAME"
  set +e
  aws iam get-role \
    --role-name "$ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/lambda-role.json \
    2> .build/lambda-role-error.txt
  role_lookup_rc=$?
  set -e

  if [ "$role_lookup_rc" -eq 0 ]; then
    echo "Lambda IAM role already exists; preserving role identity."
  else
    role_lookup_error="$(<.build/lambda-role-error.txt)"
    case "$role_lookup_error" in
      *NoSuchEntity*)
        echo "Lambda IAM role is missing; creating $ROLE_NAME."
        aws iam create-role \
          --role-name "$ROLE_NAME" \
          --description "JournalM8 Lambda basic execution role" \
          --assume-role-policy-document "file://${LAMBDA_TRUST_POLICY}" \
          --profile "$AWS_PROFILE" \
          --region "$AWS_REGION" \
          >/dev/null
        aws iam wait role-exists \
          --role-name "$ROLE_NAME" \
          --profile "$AWS_PROFILE" \
          --region "$AWS_REGION"
        ;;
      *)
        echo "Unable to resolve Lambda IAM role: IAM lookup failed."
        return "$role_lookup_rc"
        ;;
    esac
  fi

  aws iam update-assume-role-policy \
    --role-name "$ROLE_NAME" \
    --policy-document "file://${LAMBDA_TRUST_POLICY}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws iam attach-role-policy \
    --role-name "$ROLE_NAME" \
    --policy-arn "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws iam get-role \
    --role-name "$ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  local trust_services
  trust_services="$(aws iam get-role \
    --role-name "$ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query 'Role.AssumeRolePolicyDocument.Statement[?Effect==`Allow`].Principal.Service' \
    --output text)"
  case "$trust_services" in
    *lambda.amazonaws.com*) ;;
    *)
      echo "Lambda IAM role trust policy does not contain lambda.amazonaws.com."
      return 1
      ;;
  esac

  local attached_basic_policy
  attached_basic_policy="$(aws iam list-attached-role-policies \
    --role-name "$ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "AttachedPolicies[?PolicyArn=='arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole'].PolicyArn | [0]" \
    --output text)"
  if [ "$attached_basic_policy" != "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" ]; then
    echo "Required Lambda basic execution policy is not attached."
    return 1
  fi

  echo "Lambda IAM role and required basic execution policy verified."
}

ensure_entry_chunks_table() {
  local describe_rc
  local table_arn
  local pitr_status

  echo "Resolving semantic-memory table: $ENTRY_CHUNKS_TABLE_NAME"
  set +e
  aws dynamodb describe-table \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/entry-chunks-table-before.json \
    2> .build/entry-chunks-table-error.txt
  describe_rc=$?
  set -e

  if [ "$describe_rc" -ne 0 ]; then
    if ! grep -q 'ResourceNotFoundException' .build/entry-chunks-table-error.txt; then
      echo "Unable to resolve semantic-memory table safely." >&2
      return "$describe_rc"
    fi
    aws dynamodb create-table \
      --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
      --attribute-definitions \
        AttributeName=PK,AttributeType=S \
        AttributeName=SK,AttributeType=S \
      --key-schema \
        AttributeName=PK,KeyType=HASH \
        AttributeName=SK,KeyType=RANGE \
      --billing-mode PAY_PER_REQUEST \
      --deletion-protection-enabled \
      --tags \
        Key=App,Value="$APP_NAME" \
        Key=Stage,Value="$STAGE" \
        Key=ManagedBy,Value=aws-cli \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null
    aws dynamodb wait table-exists \
      --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
    aws dynamodb describe-table \
      --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      > .build/entry-chunks-table-before.json
  fi

  table_arn="$(python3 "$SCRIPT_DIR/jm8_environment_contract.py" \
    entry-chunks-description \
    .build/entry-chunks-table-before.json \
    "$APP_NAME" "$STAGE" "$ACCOUNT_ID" "$AWS_REGION" \
    "$ENTRY_CHUNKS_TABLE_NAME" before)"

  aws dynamodb list-tags-of-resource \
    --resource-arn "$table_arn" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/entry-chunks-tags-before.json
  python3 "$SCRIPT_DIR/jm8_environment_contract.py" \
    entry-chunks-tags .build/entry-chunks-tags-before.json \
    "$APP_NAME" "$STAGE" before

  aws dynamodb tag-resource \
    --resource-arn "$table_arn" \
    --tags \
      Key=App,Value="$APP_NAME" \
      Key=Stage,Value="$STAGE" \
      Key=ManagedBy,Value=aws-cli \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws dynamodb update-continuous-backups \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --point-in-time-recovery-specification PointInTimeRecoveryEnabled=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null
  aws dynamodb update-table \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --deletion-protection-enabled \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null
  aws dynamodb wait table-exists \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  pitr_status=""
  for attempt in {1..30}; do
    pitr_status="$(aws dynamodb describe-continuous-backups \
      --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query 'ContinuousBackupsDescription.PointInTimeRecoveryDescription.PointInTimeRecoveryStatus' \
      --output text)"
    if [ "$pitr_status" = "ENABLED" ]; then
      break
    fi
    if [ "$attempt" -eq 30 ]; then
      echo "Semantic-memory table PITR did not become enabled." >&2
      return 1
    fi
    sleep 2
  done

  aws dynamodb describe-table \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/entry-chunks-table-after.json
  aws dynamodb describe-continuous-backups \
    --table-name "$ENTRY_CHUNKS_TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/entry-chunks-pitr-after.json
  aws dynamodb list-tags-of-resource \
    --resource-arn "$table_arn" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    > .build/entry-chunks-tags-after.json

  python3 "$SCRIPT_DIR/jm8_environment_contract.py" \
    entry-chunks-description .build/entry-chunks-table-after.json \
    "$APP_NAME" "$STAGE" "$ACCOUNT_ID" "$AWS_REGION" \
    "$ENTRY_CHUNKS_TABLE_NAME" after \
    >/dev/null
  python3 "$SCRIPT_DIR/jm8_environment_contract.py" \
    entry-chunks-pitr .build/entry-chunks-pitr-after.json
  python3 "$SCRIPT_DIR/jm8_environment_contract.py" \
    entry-chunks-tags .build/entry-chunks-tags-after.json \
    "$APP_NAME" "$STAGE" after

  echo "Semantic-memory table contract verified."
}

echo "Creating DynamoDB table if missing: $TABLE_NAME"

set +e
aws dynamodb describe-table \
  --table-name "$TABLE_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
TABLE_EXISTS=$?
set -e

if [ "$TABLE_EXISTS" -ne 0 ]; then
  aws dynamodb create-table \
    --table-name "$TABLE_NAME" \
    --attribute-definitions \
      AttributeName=PK,AttributeType=S \
      AttributeName=SK,AttributeType=S \
      AttributeName=GSI1PK,AttributeType=S \
      AttributeName=GSI1SK,AttributeType=S \
    --key-schema \
      AttributeName=PK,KeyType=HASH \
      AttributeName=SK,KeyType=RANGE \
    --global-secondary-indexes '[
      {
        "IndexName": "GSI1",
        "KeySchema": [
          {"AttributeName": "GSI1PK", "KeyType": "HASH"},
          {"AttributeName": "GSI1SK", "KeyType": "RANGE"}
        ],
        "Projection": {"ProjectionType": "ALL"}
      }
    ]' \
    --billing-mode PAY_PER_REQUEST \
    --tags \
      Key=App,Value="$APP_NAME" \
      Key=Stage,Value="$STAGE" \
      Key=ManagedBy,Value=aws-cli \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for DynamoDB table to become active..."
  aws dynamodb wait table-exists \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
else
  echo "DynamoDB table already exists."
fi

ensure_entry_chunks_table

echo "Creating S3 bucket if missing: $RAW_BUCKET"

set +e
aws s3api head-bucket \
  --bucket "$RAW_BUCKET" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
BUCKET_EXISTS=$?
set -e

if [ "$BUCKET_EXISTS" -ne 0 ]; then
  if [ "$AWS_REGION" = "us-east-1" ]; then
    aws s3api create-bucket \
      --bucket "$RAW_BUCKET" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null
  else
    aws s3api create-bucket \
      --bucket "$RAW_BUCKET" \
      --create-bucket-configuration LocationConstraint="$AWS_REGION" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null
  fi

  aws s3api put-public-access-block \
    --bucket "$RAW_BUCKET" \
    --public-access-block-configuration \
      BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws s3api put-bucket-encryption \
    --bucket "$RAW_BUCKET" \
    --server-side-encryption-configuration '{
      "Rules": [
        {
          "ApplyServerSideEncryptionByDefault": {
            "SSEAlgorithm": "AES256"
          }
        }
      ]
    }' \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws s3api put-bucket-versioning \
    --bucket "$RAW_BUCKET" \
    --versioning-configuration Status=Enabled \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "S3 bucket created and secured."
else
  echo "S3 bucket already exists."
fi

  echo "Applying DynamoDB and S3 hardening (PITR, deletion protection, HTTPS-only policy, lifecycle, tags, CORS)..."

  # Ensure DynamoDB point-in-time recovery (PITR) is enabled idempotently
  echo "Enabling DynamoDB Point-in-Time Recovery for $TABLE_NAME (idempotent)"
  aws dynamodb update-continuous-backups \
    --table-name "$TABLE_NAME" \
    --point-in-time-recovery-specification PointInTimeRecoveryEnabled=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" >/dev/null

  echo "Enabling DynamoDB deletion protection for $TABLE_NAME (idempotent)"
  aws dynamodb update-table \
    --table-name "$TABLE_NAME" \
    --deletion-protection-enabled \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" >/dev/null

  # --- HTTPS-only bucket policy (deny when aws:SecureTransport is false) ---
  echo "Merging HTTPS-only deny with any existing bucket policy (preserve unrelated statements)"
  set +e
  aws s3api get-bucket-policy --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/existing_policy.json 2>.build/get_policy_err.json
  GET_POLICY_RC=$?
  set -e
  python3 bin/jm8_s3_helpers.py check-error .build/get_policy_err.json NoSuchBucketPolicy || exit $?
  if [ "$GET_POLICY_RC" -ne 0 ] && [ ! -s .build/existing_policy.json ]; then
    : > .build/existing_policy.json
  fi
  python3 bin/jm8_s3_helpers.py merge-policy .build/existing_policy.json "$RAW_BUCKET" .build/https-only-policy.json
  aws s3api put-bucket-policy \
    --bucket "$RAW_BUCKET" \
    --policy file://.build/https-only-policy.json \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  # --- Lifecycle: abort incomplete multipart after 7 days, delete noncurrent versions after 30 days ---
  echo "Ensuring lifecycle rules for $RAW_BUCKET"
  set +e
  aws s3api get-bucket-lifecycle-configuration --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/existing_lifecycle.json 2>.build/get_lifecycle_err.json
  GET_LIFECYCLE_RC=$?
  set -e
  python3 bin/jm8_s3_helpers.py check-error .build/get_lifecycle_err.json NoSuchLifecycleConfiguration || exit $?
  if [ "$GET_LIFECYCLE_RC" -ne 0 ] && [ ! -s .build/existing_lifecycle.json ]; then
    : > .build/existing_lifecycle.json
  fi
  python3 bin/jm8_s3_helpers.py merge-lifecycle .build/existing_lifecycle.json .build/lifecycle.json
  aws s3api put-bucket-lifecycle-configuration \
    --bucket "$RAW_BUCKET" \
    --lifecycle-configuration file://.build/lifecycle.json \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  # --- Tags: App, Stage, ManagedBy=aws-cli, DataClassification=Sensitive ---
  echo "Ensuring bucket tags for $RAW_BUCKET"
  set +e
  aws s3api get-bucket-tagging --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/existing_tags.json 2>.build/get_tags_err.json
  GET_TAGS_RC=$?
  set -e
  python3 bin/jm8_s3_helpers.py check-error .build/get_tags_err.json NoSuchTagSet || exit $?
  if [ "$GET_TAGS_RC" -ne 0 ] && [ ! -s .build/existing_tags.json ]; then
    : > .build/existing_tags.json
  fi
  python3 bin/jm8_s3_helpers.py merge-tags .build/existing_tags.json "$APP_NAME" "$STAGE" .build/tags.json
  aws s3api put-bucket-tagging \
    --bucket "$RAW_BUCKET" \
    --tagging file://.build/tags.json \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  # --- CORS: enforce explicit ALLOWED_ORIGINS for every stage ---
  echo "Ensuring CORS from validated ALLOWED_ORIGINS"
  rm -f .build/cors.json
  set +e
  aws s3api get-bucket-cors --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/existing_cors.json 2>.build/get_cors_err.json
  GET_CORS_RC=$?
  set -e
  python3 bin/jm8_s3_helpers.py check-error .build/get_cors_err.json NoSuchCORSConfiguration || exit $?
  if [ "$GET_CORS_RC" -ne 0 ] && [ ! -s .build/existing_cors.json ]; then
    : > .build/existing_cors.json
  fi
  python3 bin/jm8_s3_helpers.py decide-cors .build/existing_cors.json "$STAGE" "$ALLOWED_ORIGINS_JSON" .build/cors.json
  if [ -f .build/cors.json ]; then
    aws s3api put-bucket-cors \
      --bucket "$RAW_BUCKET" \
      --cors-configuration file://.build/cors.json \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  fi

  echo "S3 hardening complete."

  echo "Running post-deployment verification (enforcing checks)"
  aws dynamodb describe-continuous-backups \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" > .build/describe_continuous_backups.json

  aws dynamodb describe-table \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" > .build/describe_table.json

  set +e
  aws s3api get-bucket-policy --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/effective_policy.json 2>.build/get_policy_err_post.json
  python3 bin/jm8_s3_helpers.py check-error .build/get_policy_err_post.json || exit $?
  aws s3api get-bucket-lifecycle-configuration --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/effective_lifecycle.json 2>.build/get_lifecycle_err_post.json
  python3 bin/jm8_s3_helpers.py check-error .build/get_lifecycle_err_post.json || exit $?
  aws s3api get-bucket-tagging --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/effective_tags.json 2>.build/get_tags_err_post.json
  python3 bin/jm8_s3_helpers.py check-error .build/get_tags_err_post.json || exit $?
  aws s3api get-bucket-cors --bucket "$RAW_BUCKET" --profile "$AWS_PROFILE" --region "$AWS_REGION" > .build/effective_cors.json 2>.build/get_cors_err_post.json
  python3 bin/jm8_s3_helpers.py check-error .build/get_cors_err_post.json || exit $?
  set -e

  python3 bin/jm8_s3_helpers.py verify-postdeploy .build/describe_continuous_backups.json .build/describe_table.json .build/effective_policy.json .build/effective_lifecycle.json .build/effective_tags.json .build/effective_cors.json "$RAW_BUCKET" "$APP_NAME" "$STAGE" "$ALLOWED_ORIGINS_JSON"

echo "Creating Lambda app access policy."

ensure_lambda_role

cat > .build/lambda-app-policy.json <<POLICY
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBJournalM8Access",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:${AWS_REGION}:${ACCOUNT_ID}:table/${TABLE_NAME}",
        "arn:aws:dynamodb:${AWS_REGION}:${ACCOUNT_ID}:table/${TABLE_NAME}/index/*"
      ]
    },
    {
      "Sid": "DynamoDBSemanticMemoryAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${ACCOUNT_ID}:table/${ENTRY_CHUNKS_TABLE_NAME}"
    },
    {
      "Sid": "S3JournalM8RawUploadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::${RAW_BUCKET}/*"
    },
    {
      "Sid": "TextractOCRAccess",
      "Effect": "Allow",
      "Action": [
        "textract:DetectDocumentText"
      ],
      "Resource": "*"
    }
  ]
}
POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$POLICY_NAME" \
  --policy-document file://.build/lambda-app-policy.json \
  --profile "$AWS_PROFILE"

aws iam get-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$POLICY_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "Phase 2 resources ready."
echo "Table: $TABLE_NAME"
echo "Entry chunks table: $ENTRY_CHUNKS_TABLE_NAME"
echo "Raw bucket: $RAW_BUCKET"
