#!/usr/bin/env bash
set -euo pipefail

: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${ACCOUNT_ID:?ACCOUNT_ID is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
POLICY_NAME="${APP_NAME}-${STAGE}-app-access-policy"

echo "Creating DynamoDB table if missing: $TABLE_NAME"

set +e
aws dynamodb describe-table \
  --table-name "$TABLE_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
TABLE_EXISTS=$?
set -e

if [ "$TABLE_EXISTS" -ne 0 ]; then
  aws dynamodb create-table \
    --table-name "$TABLE_NAME" \
    --attribute-definitions \
      AttributeName=PK,AttributeType=S \
      AttributeName=SK,AttributeType=S \
      AttributeName=GSI1PK,AttributeType=S \
      AttributeName=GSI1SK,AttributeType=S \
    --key-schema \
      AttributeName=PK,KeyType=HASH \
      AttributeName=SK,KeyType=RANGE \
    --global-secondary-indexes '[
      {
        "IndexName": "GSI1",
        "KeySchema": [
          {"AttributeName": "GSI1PK", "KeyType": "HASH"},
          {"AttributeName": "GSI1SK", "KeyType": "RANGE"}
        ],
        "Projection": {"ProjectionType": "ALL"}
      }
    ]' \
    --billing-mode PAY_PER_REQUEST \
    --tags \
      Key=App,Value="$APP_NAME" \
      Key=Stage,Value="$STAGE" \
      Key=ManagedBy,Value=aws-cli \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for DynamoDB table to become active..."
  aws dynamodb wait table-exists \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
else
  echo "DynamoDB table already exists."
fi

echo "Creating S3 bucket if missing: $RAW_BUCKET"

set +e
aws s3api head-bucket \
  --bucket "$RAW_BUCKET" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
BUCKET_EXISTS=$?
set -e

if [ "$BUCKET_EXISTS" -ne 0 ]; then
  if [ "$AWS_REGION" = "us-east-1" ]; then
    aws s3api create-bucket \
      --bucket "$RAW_BUCKET" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null
  else
    aws s3api create-bucket \
      --bucket "$RAW_BUCKET" \
      --create-bucket-configuration LocationConstraint="$AWS_REGION" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null
  fi

  aws s3api put-public-access-block \
    --bucket "$RAW_BUCKET" \
    --public-access-block-configuration \
      BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws s3api put-bucket-encryption \
    --bucket "$RAW_BUCKET" \
    --server-side-encryption-configuration '{
      "Rules": [
        {
          "ApplyServerSideEncryptionByDefault": {
            "SSEAlgorithm": "AES256"
          }
        }
      ]
    }' \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws s3api put-bucket-versioning \
    --bucket "$RAW_BUCKET" \
    --versioning-configuration Status=Enabled \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "S3 bucket created and secured."
else
  echo "S3 bucket already exists."
fi

echo "Creating Lambda app access policy."

mkdir -p .build

cat > .build/lambda-app-policy.json <<POLICY
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBJournalM8Access",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:${AWS_REGION}:${ACCOUNT_ID}:table/${TABLE_NAME}",
        "arn:aws:dynamodb:${AWS_REGION}:${ACCOUNT_ID}:table/${TABLE_NAME}/index/*"
      ]
    },
    {
      "Sid": "S3JournalM8RawUploadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::${RAW_BUCKET}/*"
    },
    {
      "Sid": "TextractOCRAccess",
      "Effect": "Allow",
      "Action": [
        "textract:DetectDocumentText"
      ],
      "Resource": "*"
    }
  ]
}
POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$POLICY_NAME" \
  --policy-document file://.build/lambda-app-policy.json \
  --profile "$AWS_PROFILE"

echo "Phase 2 resources ready."
echo "Table: $TABLE_NAME"
echo "Raw bucket: $RAW_BUCKET"
