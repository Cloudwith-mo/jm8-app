#!/usr/bin/env bash
set -euo pipefail
umask 077

# === Environment Contract Validation ===
# create-auth must validate stage and account before proceeding
: "${AWS_REGION:?AWS_REGION is required}"
: "${AWS_PROFILE:?AWS_PROFILE is required}"
: "${STAGE:?STAGE is required. Use: STAGE=dev|staging|prod}"
: "${APP_NAME:?APP_NAME is required. Use: APP_NAME=journalm8}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required}"
: "${CALLBACK_URL:?CALLBACK_URL is required and cannot be localhost outside dev}"
: "${LOGOUT_URL:?LOGOUT_URL is required and cannot be localhost outside dev}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
export JM8_OPERATION="create-auth"
jm8_validate_contract_or_exit

# Use STAGE as the environment name (more consistent with deployment)
ENV_NAME="$STAGE"
APP_NAME="${APP_NAME:-journalm8}"

case "$STAGE" in
  dev|staging|prod) ;;
  *)
    echo "Invalid STAGE: use dev, staging, or prod." >&2
    exit 1
    ;;
esac

COGNITO_ENV_FILE="$SCRIPT_DIR/../infra/environments/generated/${STAGE}.cognito.env"
COGNITO_ENV_DIR="$(dirname "$COGNITO_ENV_FILE")"
COGNITO_ENV_TEMP=""

cleanup_cognito_env_temp() {
  if [ -n "$COGNITO_ENV_TEMP" ]; then
    rm -f -- "$COGNITO_ENV_TEMP"
  fi
}

trap cleanup_cognito_env_temp EXIT HUP INT TERM
mkdir -p "$COGNITO_ENV_DIR"

USER_POOL_NAME="${APP_NAME}-${ENV_NAME}-users"
APP_CLIENT_NAME="${APP_NAME}-${ENV_NAME}-web"

# Fetch actual account ID from STS
AWS_ACCOUNT_ID="$(aws sts get-caller-identity \
  --profile "$AWS_PROFILE" \
  --query Account \
  --output text)"

COGNITO_DOMAIN_PREFIX="${APP_NAME}-${ENV_NAME}-${AWS_ACCOUNT_ID}"

echo "Checking Cognito user pool: $USER_POOL_NAME"

USER_POOL_ID="$(
  aws cognito-idp list-user-pools \
    --max-results 60 \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "UserPools[?Name=='$USER_POOL_NAME'].Id | [0]" \
    --output text
)"

if [[ "$USER_POOL_ID" == "None" || -z "$USER_POOL_ID" ]]; then
  echo "Creating Cognito user pool."

  USER_POOL_ID="$(
    aws cognito-idp create-user-pool \
      --pool-name "$USER_POOL_NAME" \
      --username-attributes email \
      --auto-verified-attributes email \
      --account-recovery-setting 'RecoveryMechanisms=[{Priority=1,Name=verified_email}]' \
      --policies 'PasswordPolicy={MinimumLength=8,RequireUppercase=true,RequireLowercase=true,RequireNumbers=true,RequireSymbols=false,TemporaryPasswordValidityDays=7}' \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query 'UserPool.Id' \
      --output text
  )"
else
  echo "User pool already exists: $USER_POOL_ID"
fi

echo "Checking app client: $APP_CLIENT_NAME"

APP_CLIENT_ID="$(
  aws cognito-idp list-user-pool-clients \
    --user-pool-id "$USER_POOL_ID" \
    --max-results 60 \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "UserPoolClients[?ClientName=='$APP_CLIENT_NAME'].ClientId | [0]" \
    --output text
)"

if [[ "$APP_CLIENT_ID" == "None" || -z "$APP_CLIENT_ID" ]]; then
  echo "Creating app client."

  APP_CLIENT_ID="$(
    aws cognito-idp create-user-pool-client \
      --user-pool-id "$USER_POOL_ID" \
      --client-name "$APP_CLIENT_NAME" \
      --no-generate-secret \
      --supported-identity-providers COGNITO \
      --callback-urls "$CALLBACK_URL" \
      --logout-urls "$LOGOUT_URL" \
      --allowed-o-auth-flows code \
      --allowed-o-auth-scopes openid email profile \
      --allowed-o-auth-flows-user-pool-client \
      --explicit-auth-flows ALLOW_USER_SRP_AUTH ALLOW_REFRESH_TOKEN_AUTH ALLOW_USER_PASSWORD_AUTH \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query 'UserPoolClient.ClientId' \
      --output text
  )"
else
  echo "App client already exists: $APP_CLIENT_ID"
fi

echo "Checking Cognito Hosted UI domain: $COGNITO_DOMAIN_PREFIX"

DOMAIN_USER_POOL_ID="$(
  aws cognito-idp describe-user-pool-domain \
    --domain "$COGNITO_DOMAIN_PREFIX" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query 'DomainDescription.UserPoolId' \
    --output text 2>/dev/null || true
)"

if [[ "$DOMAIN_USER_POOL_ID" == "$USER_POOL_ID" ]]; then
  echo "Domain already exists."
else
  echo "Creating Hosted UI domain."
  aws cognito-idp create-user-pool-domain \
    --domain "$COGNITO_DOMAIN_PREFIX" \
    --user-pool-id "$USER_POOL_ID" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" >/dev/null
fi

COGNITO_ISSUER="https://cognito-idp.${AWS_REGION}.amazonaws.com/${USER_POOL_ID}"
COGNITO_DOMAIN="https://${COGNITO_DOMAIN_PREFIX}.auth.${AWS_REGION}.amazoncognito.com"

COGNITO_ENV_TEMP="$(mktemp "$COGNITO_ENV_DIR/.${STAGE}.cognito.env.XXXXXX")"
{
  printf 'export COGNITO_USER_POOL_ID=%q\n' "$USER_POOL_ID"
  printf 'export COGNITO_APP_CLIENT_ID=%q\n' "$APP_CLIENT_ID"
  printf 'export COGNITO_DOMAIN=%q\n' "$COGNITO_DOMAIN"
  printf 'export COGNITO_ISSUER=%q\n' "$COGNITO_ISSUER"
  printf 'export COGNITO_CALLBACK_URL=%q\n' "$CALLBACK_URL"
  printf 'export COGNITO_LOGOUT_URL=%q\n' "$LOGOUT_URL"
} > "$COGNITO_ENV_TEMP"
chmod 600 "$COGNITO_ENV_TEMP"
mv -f -- "$COGNITO_ENV_TEMP" "$COGNITO_ENV_FILE"
COGNITO_ENV_TEMP=""

echo
echo "Cognito auth foundation ready:"
echo "Saved local config:"
echo "$COGNITO_ENV_FILE"
