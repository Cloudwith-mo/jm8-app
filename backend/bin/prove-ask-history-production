#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(
  cd "$(
    dirname "${BASH_SOURCE[0]}"
  )/.."
  pwd
)"

cd "$ROOT_DIR"

: "${AWS_PROFILE:?AWS_PROFILE is required}"
: "${AWS_REGION:?AWS_REGION is required}"
: "${APP_NAME:?APP_NAME is required}"
: "${STAGE:?STAGE is required}"
: "${TABLE_NAME:?TABLE_NAME is required}"
: "${API_NAME:?API_NAME is required}"
: "${ID_TOKEN:?ID_TOKEN is required}"

export AWS_DEFAULT_REGION="$AWS_REGION"

if ! printf '%s' "$ID_TOKEN" \
  | grep -Eq \
    '^[^.]+\.[^.]+\.[^.]+$'
then
  echo "Fresh access token available: false"
  return 1 2>/dev/null || false
fi

PYTHONPATH=function \
python3 - <<'PY'
from __future__ import annotations

import base64
import json
import os
import secrets
import time
from datetime import (
    datetime,
    timedelta,
    timezone,
)
from typing import Any
from urllib.error import (
    HTTPError,
    URLError,
)
from urllib.parse import (
    quote,
    urlencode,
)
from urllib.request import (
    Request,
    urlopen,
)

import boto3
from boto3.dynamodb.conditions import (
    Key,
)

from ask_history_store import (
    create_ask_history,
    get_ask_history,
)


AWS_PROFILE = os.environ["AWS_PROFILE"]
AWS_REGION = os.environ["AWS_REGION"]
APP_NAME = os.environ["APP_NAME"]
STAGE = os.environ["STAGE"]
TABLE_NAME = os.environ["TABLE_NAME"]
API_NAME = os.environ["API_NAME"]
TOKEN = os.environ["ID_TOKEN"]

FUNCTION_NAME = (
    f"{APP_NAME}-{STAGE}-api"
)

START_TIME_MS = int(
    (time.time() - 5) * 1000
)

SUFFIX = secrets.token_hex(8)

PAGE_HISTORY_IDS = (
    f"askhist_pagea{SUFFIX}",
    f"askhist_pageb{SUFFIX}",
)

ISOLATION_HISTORY_ID = (
    f"askhist_isolation{SUFFIX}"
)

ISOLATION_USER_ID = (
    f"history-isolation-{SUFFIX}"
)


def decode_token_subject(
    token: str,
) -> str:
    sections = token.split(".")

    if len(sections) != 3:
        raise RuntimeError(
            "Access token structure is invalid."
        )

    payload = sections[1]

    payload += (
        "="
        * (-len(payload) % 4)
    )

    try:
        decoded = (
            base64.urlsafe_b64decode(
                payload.encode("ascii")
            )
        )

        claims = json.loads(
            decoded.decode("utf-8")
        )

    except (
        ValueError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as error:
        raise RuntimeError(
            "Access token claims "
            "could not be read."
        ) from error

    subject = claims.get("sub")

    if (
        not isinstance(subject, str)
        or not subject.strip()
    ):
        raise RuntimeError(
            "Access token subject "
            "is unavailable."
        )

    return subject.strip()


AUTHENTICATED_USER_ID = (
    decode_token_subject(TOKEN)
)


session = boto3.Session(
    profile_name=AWS_PROFILE,
    region_name=AWS_REGION,
)

api_gateway = session.client(
    "apigatewayv2"
)

logs_client = session.client(
    "logs"
)

table = session.resource(
    "dynamodb"
).Table(
    TABLE_NAME
)


def resolve_api() -> tuple[
    str,
    str,
]:
    next_token = None
    matched_api = None

    while True:
        arguments: dict[str, Any] = {
            "MaxResults": "100",
        }

        if next_token:
            arguments[
                "NextToken"
            ] = next_token

        page = api_gateway.get_apis(
            **arguments
        )

        for item in page.get(
            "Items",
            [],
        ):
            if (
                item.get("Name")
                == API_NAME
            ):
                matched_api = item
                break

        if matched_api:
            break

        next_token = page.get(
            "NextToken"
        )

        if not next_token:
            break

    if not matched_api:
        raise RuntimeError(
            "The deployed API "
            "could not be resolved."
        )

    api_id = matched_api.get(
        "ApiId"
    )

    endpoint = matched_api.get(
        "ApiEndpoint"
    )

    if (
        not isinstance(api_id, str)
        or not api_id
        or not isinstance(
            endpoint,
            str,
        )
        or not endpoint
    ):
        raise RuntimeError(
            "The deployed API "
            "configuration is incomplete."
        )

    return (
        api_id,
        endpoint.rstrip("/"),
    )


API_ID, API_ENDPOINT = (
    resolve_api()
)


def get_route_map() -> dict[
    str,
    dict[str, Any],
]:
    routes = {}
    next_token = None

    while True:
        arguments: dict[str, Any] = {
            "ApiId": API_ID,
            "MaxResults": "100",
        }

        if next_token:
            arguments[
                "NextToken"
            ] = next_token

        page = api_gateway.get_routes(
            **arguments
        )

        for item in page.get(
            "Items",
            [],
        ):
            route_key = item.get(
                "RouteKey"
            )

            if isinstance(
                route_key,
                str,
            ):
                routes[route_key] = item

        next_token = page.get(
            "NextToken"
        )

        if not next_token:
            break

    return routes


def api_request(
    method: str,
    path: str,
    *,
    payload: Any = None,
    authenticated: bool = True,
    timeout_seconds: int = 45,
) -> tuple[
    int,
    dict[str, Any],
]:
    data = None

    headers = {
        "accept": "application/json",
    }

    if payload is not None:
        data = json.dumps(
            payload
        ).encode("utf-8")

        headers[
            "content-type"
        ] = "application/json"

    if authenticated:
        headers[
            "authorization"
        ] = f"Bearer {TOKEN}"

    request = Request(
        f"{API_ENDPOINT}{path}",
        data=data,
        headers=headers,
        method=method,
    )

    try:
        with urlopen(
            request,
            timeout=timeout_seconds,
        ) as response:
            status = int(
                response.status
            )

            raw_body = (
                response.read()
            )

    except HTTPError as error:
        status = int(error.code)
        raw_body = error.read()

    except URLError as error:
        raise RuntimeError(
            "The API request failed "
            "before receiving a response."
        ) from error

    if not raw_body:
        return status, {}

    try:
        body = json.loads(
            raw_body.decode("utf-8")
        )

    except (
        UnicodeDecodeError,
        json.JSONDecodeError,
    ):
        return status, {}

    if not isinstance(body, dict):
        return status, {}

    return status, body


def public_fields_are_safe(
    body: Any,
) -> bool:
    serialized = json.dumps(
        body,
        sort_keys=True,
    )

    forbidden = (
        '"PK"',
        '"SK"',
        '"GSI1PK"',
        '"GSI1SK"',
        '"userId"',
        '"entryId"',
        '"reservationId"',
        '"rawText"',
        '"cleanText"',
        '"s3RawKey"',
        '"s3RawBucket"',
        '"accessToken"',
        '"idToken"',
        '"refreshToken"',
        '"authorization"',
        '"executionArn"',
        '"executionName"',
    )

    return all(
        value not in serialized
        for value in forbidden
    )


def synthetic_answer(
    *,
    generated_at: str,
    question: str,
) -> dict[str, Any]:
    return {
        "answerVersion": "1.0",
        "generatedAt": generated_at,
        "status": "ANSWERED",
        "question": question,
        "scope": {
            "startDate": None,
            "endDate": None,
            "firstEntryAt": None,
            "latestEntryAt": None,
        },
        "coverage": {
            "totalEntries": 1,
            "analyzedEntries": 1,
            "unanalyzedEntries": 0,
            (
                "analysisCompletionPercent"
            ): 100,
            (
                "sourceSignalsAvailable"
            ): 1,
            (
                "sourceSignalsIncluded"
            ): 1,
            "contextTruncated": False,
        },
        "answer": {
            "headline": (
                "Temporary history proof"
            ),
            "summary": (
                "This temporary record "
                "verifies private history "
                "pagination."
            ),
            "explanation": (
                "The record contains no "
                "journal transcript or "
                "personal journal content."
            ),
        },
        "metrics": {
            "mentionCount": 1,
            "strongestPeriod": (
                "Proof period"
            ),
            "improvementPercent": 0,
            "topTrigger": (
                "Synthetic proof signal"
            ),
        },
        "evidence": [],
        "takeaways": [
            "Temporary proof record."
        ],
        "relatedThemes": [
            "verification"
        ],
        "growthSignals": [],
        "limitations": [
            (
                "This is a temporary "
                "synthetic record."
            )
        ],
        "suggestedFollowUps": [],
    }


authenticated_proof_ids = set(
    PAGE_HISTORY_IDS
)

isolation_proof_ids = {
    ISOLATION_HISTORY_ID
}

generated_history_id = None


def cleanup_partition(
    user_id: str,
    history_ids: set[str],
) -> None:
    if not history_ids:
        return

    query_arguments: dict[
        str,
        Any,
    ] = {
        "KeyConditionExpression": (
            Key("PK").eq(
                f"USER#{user_id}"
            )
            & Key("SK").begins_with(
                "ASK_HISTORY#"
            )
        ),
        "ConsistentRead": True,
    }

    while True:
        result = table.query(
            **query_arguments
        )

        matching_items = [
            item
            for item in result.get(
                "Items",
                [],
            )
            if item.get(
                "historyId"
            )
            in history_ids
        ]

        if matching_items:
            with table.batch_writer() as batch:
                for item in matching_items:
                    batch.delete_item(
                        Key={
                            "PK": item["PK"],
                            "SK": item["SK"],
                        }
                    )

        last_key = result.get(
            "LastEvaluatedKey"
        )

        if not last_key:
            break

        query_arguments[
            "ExclusiveStartKey"
        ] = last_key


def cleanup_proof_records() -> None:
    cleanup_partition(
        AUTHENTICATED_USER_ID,
        authenticated_proof_ids,
    )

    cleanup_partition(
        ISOLATION_USER_ID,
        isolation_proof_ids,
    )


proof_succeeded = False

try:
    routes = get_route_map()

    required_routes = (
        "POST /insights/ask",
        "GET /insights/ask/history",
        (
            "GET "
            "/insights/ask/history/"
            "{historyId}"
        ),
        (
            "DELETE "
            "/insights/ask/history/"
            "{historyId}"
        ),
    )

    routes_protected = all(
        route in routes
        and routes[route].get(
            "AuthorizationType"
        )
        == "JWT"
        for route in required_routes
    )

    print(
        "History routes JWT protected:",
        routes_protected,
    )

    if not routes_protected:
        raise RuntimeError(
            "One or more history routes "
            "are not JWT protected."
        )

    unauthenticated_status, _ = (
        api_request(
            "GET",
            "/insights/ask/history?limit=1",
            authenticated=False,
        )
    )

    unauthenticated_rejected = (
        unauthenticated_status
        in {
            401,
            403,
        }
    )

    print(
        (
            "Unauthenticated history "
            "rejected:"
        ),
        unauthenticated_rejected,
    )

    if not unauthenticated_rejected:
        raise RuntimeError(
            "Unauthenticated history "
            "access was not rejected."
        )

    usage_status, usage_body = (
        api_request(
            "GET",
            "/usage",
        )
    )

    usage_operation = (
        usage_body.get(
            "usage",
            {},
        )
        .get(
            "operations",
            {},
        )
        .get(
            "askJm8",
            {},
        )
    )

    allowance_available = (
        usage_status == 200
        and isinstance(
            usage_operation,
            dict,
        )
        and usage_operation.get(
            "allowed"
        )
        is not False
    )

    print(
        "Ask allowance available:",
        allowance_available,
    )

    if not allowance_available:
        raise RuntimeError(
            "One available Ask JM8 "
            "allowance is required."
        )

    base_time = (
        datetime.now(
            timezone.utc
        )
        - timedelta(
            minutes=1
        )
    )

    for index, history_id in enumerate(
        PAGE_HISTORY_IDS
    ):
        generated_at = (
            base_time
            + timedelta(
                seconds=index
            )
        ).isoformat()

        create_ask_history(
            AUTHENTICATED_USER_ID,
            synthetic_answer(
                generated_at=generated_at,
                question=(
                    "Temporary pagination "
                    f"proof {index + 1}."
                ),
            ),
            history_id=history_id,
            table_resource=table,
        )

    create_ask_history(
        ISOLATION_USER_ID,
        synthetic_answer(
            generated_at=(
                base_time
                + timedelta(
                    seconds=2
                )
            ).isoformat(),
            question=(
                "Temporary isolation proof."
            ),
        ),
        history_id=(
            ISOLATION_HISTORY_ID
        ),
        table_resource=table,
    )

    isolation_record_exists = False

    for _ in range(20):
        isolation_record_exists = (
            get_ask_history(
                ISOLATION_USER_ID,
                ISOLATION_HISTORY_ID,
                table_resource=table,
            )
            is not None
        )

        if isolation_record_exists:
            break

        time.sleep(0.5)

    print(
        (
            "Synthetic isolation record "
            "exists:"
        ),
        isolation_record_exists,
    )

    if not isolation_record_exists:
        raise RuntimeError(
            "The isolation proof record "
            "could not be verified."
        )

    proof_question = (
        "What recurring pattern is most "
        "visible in my analyzed journal "
        f"history? Reference {SUFFIX}."
    )

    ask_status, ask_body = (
        api_request(
            "POST",
            "/insights/ask",
            payload={
                "question": proof_question,
            },
            timeout_seconds=45,
        )
    )

    ask_status_valid = (
        ask_status == 200
    )

    print(
        "Authenticated Ask status 200:",
        ask_status_valid,
    )

    if not ask_status_valid:
        raise RuntimeError(
            "The authenticated Ask request "
            f"returned status {ask_status}."
        )

    history_reference = (
        ask_body.get("history")
    )

    ask_contract_valid = (
        set(ask_body)
        == {
            "answer",
            "history",
        }
        and isinstance(
            ask_body.get("answer"),
            dict,
        )
        and isinstance(
            history_reference,
            dict,
        )
        and set(
            history_reference
        )
        == {
            "historyVersion",
            "historyId",
            "createdAt",
        }
        and isinstance(
            history_reference.get(
                "historyId"
            ),
            str,
        )
    )

    print(
        (
            "Ask persistence contract "
            "valid:"
        ),
        ask_contract_valid,
    )

    if not ask_contract_valid:
        raise RuntimeError(
            "The Ask persistence response "
            "contract is invalid."
        )

    generated_history_id = (
        history_reference[
            "historyId"
        ]
    )

    authenticated_proof_ids.add(
        generated_history_id
    )

    ask_private_fields_absent = (
        public_fields_are_safe(
            ask_body
        )
    )

    print(
        (
            "Ask response private fields "
            "absent:"
        ),
        ask_private_fields_absent,
    )

    if not ask_private_fields_absent:
        raise RuntimeError(
            "The Ask response exposed "
            "private storage fields."
        )

    encoded_generated_id = quote(
        generated_history_id,
        safe="",
    )

    detail_status = None
    detail_body = {}

    for _ in range(20):
        detail_status, detail_body = (
            api_request(
                "GET",
                (
                    "/insights/ask/history/"
                    + encoded_generated_id
                ),
            )
        )

        if detail_status == 200:
            break

        if detail_status != 404:
            break

        time.sleep(0.5)

    detail_readable = (
        detail_status == 200
    )

    print(
        (
            "Saved history detail "
            "readable:"
        ),
        detail_readable,
    )

    if not detail_readable:
        raise RuntimeError(
            "The persisted answer could "
            "not be read through its "
            "secured detail endpoint."
        )

    detail = detail_body.get(
        "history"
    )

    detail_contract_valid = (
        set(detail_body)
        == {
            "history",
        }
        and isinstance(
            detail,
            dict,
        )
        and set(detail)
        == {
            "historyVersion",
            "historyId",
            "createdAt",
            "answer",
        }
        and detail.get(
            "historyId"
        )
        == generated_history_id
        and isinstance(
            detail.get("answer"),
            dict,
        )
        and public_fields_are_safe(
            detail_body
        )
    )

    print(
        (
            "Detail response contract "
            "valid:"
        ),
        detail_contract_valid,
    )

    if not detail_contract_valid:
        raise RuntimeError(
            "The detail response contract "
            "or privacy check failed."
        )

    seen_history_ids = []
    used_cursors = set()
    cursor = None
    pagination_advanced = False
    pagination_private = True

    pagination_targets = {
        generated_history_id,
        *PAGE_HISTORY_IDS,
    }

    for _ in range(25):
        query = {
            "limit": "1",
        }

        if cursor:
            query["cursor"] = cursor

        path = (
            "/insights/ask/history?"
            + urlencode(query)
        )

        page_status, page_body = (
            api_request(
                "GET",
                path,
            )
        )

        if page_status != 200:
            raise RuntimeError(
                "A paginated history "
                "request failed."
            )

        if (
            set(page_body)
            != {
                "count",
                "history",
                "nextCursor",
            }
            or not isinstance(
                page_body.get(
                    "history"
                ),
                list,
            )
        ):
            raise RuntimeError(
                "A paginated history "
                "response was invalid."
            )

        pagination_private = (
            pagination_private
            and public_fields_are_safe(
                page_body
            )
        )

        for item in page_body[
            "history"
        ]:
            if not isinstance(
                item,
                dict,
            ):
                raise RuntimeError(
                    "A history summary "
                    "was invalid."
                )

            history_id = item.get(
                "historyId"
            )

            if isinstance(
                history_id,
                str,
            ):
                seen_history_ids.append(
                    history_id
                )

        next_cursor = page_body.get(
            "nextCursor"
        )

        if cursor:
            used_cursors.add(cursor)

        if next_cursor:
            if (
                next_cursor == cursor
                or next_cursor
                in used_cursors
            ):
                raise RuntimeError(
                    "History pagination "
                    "returned a repeated "
                    "cursor."
                )

            pagination_advanced = True

        if pagination_targets.issubset(
            set(seen_history_ids)
        ):
            break

        if not next_cursor:
            break

        cursor = next_cursor

    pagination_records_found = (
        pagination_targets.issubset(
            set(seen_history_ids)
        )
    )

    pagination_duplicates_absent = (
        len(seen_history_ids)
        == len(
            set(seen_history_ids)
        )
    )

    isolation_absent_from_list = (
        ISOLATION_HISTORY_ID
        not in seen_history_ids
    )

    print(
        "Pagination advanced:",
        pagination_advanced,
    )

    print(
        (
            "Pagination proof records "
            "found:"
        ),
        pagination_records_found,
    )

    print(
        (
            "Pagination duplicates "
            "absent:"
        ),
        pagination_duplicates_absent,
    )

    print(
        (
            "Paginated responses private:"
        ),
        pagination_private,
    )

    if not all([
        pagination_advanced,
        pagination_records_found,
        pagination_duplicates_absent,
        pagination_private,
        isolation_absent_from_list,
    ]):
        raise RuntimeError(
            "The production pagination "
            "proof failed."
        )

    isolation_status, _ = (
        api_request(
            "GET",
            (
                "/insights/ask/history/"
                + quote(
                    ISOLATION_HISTORY_ID,
                    safe="",
                )
            ),
        )
    )

    user_isolated = (
        isolation_status == 404
        and isolation_absent_from_list
    )

    print(
        (
            "Synthetic user isolated from "
            "authenticated user:"
        ),
        user_isolated,
    )

    if not user_isolated:
        raise RuntimeError(
            "Cross-user history isolation "
            "failed."
        )

    delete_status, delete_body = (
        api_request(
            "DELETE",
            (
                "/insights/ask/history/"
                + encoded_generated_id
            ),
        )
    )

    delete_succeeded = (
        delete_status == 200
        and delete_body.get(
            "deleted"
        )
        is True
        and delete_body.get(
            "historyId"
        )
        == generated_history_id
        and public_fields_are_safe(
            delete_body
        )
    )

    print(
        "Delete succeeded:",
        delete_succeeded,
    )

    if not delete_succeeded:
        raise RuntimeError(
            "The secured delete proof "
            "failed."
        )

    deleted_returns_404 = False

    for _ in range(20):
        deleted_status, _ = (
            api_request(
                "GET",
                (
                    "/insights/ask/history/"
                    + encoded_generated_id
                ),
            )
        )

        if deleted_status == 404:
            deleted_returns_404 = True
            break

        time.sleep(0.5)

    print(
        (
            "Deleted history returns 404:"
        ),
        deleted_returns_404,
    )

    if not deleted_returns_404:
        raise RuntimeError(
            "The deleted answer remained "
            "available."
        )

    log_group_name = (
        f"/aws/lambda/{FUNCTION_NAME}"
    )

    history_events_observed = False
    cloudwatch_private = False

    messages = ""

    for _ in range(20):
        collected_messages = []
        next_token = None

        while True:
            arguments: dict[
                str,
                Any,
            ] = {
                "logGroupName": (
                    log_group_name
                ),
                "startTime": (
                    START_TIME_MS
                ),
                "limit": 10_000,
            }

            if next_token:
                arguments[
                    "nextToken"
                ] = next_token

            result = (
                logs_client
                .filter_log_events(
                    **arguments
                )
            )

            collected_messages.extend(
                str(
                    event.get(
                        "message",
                        "",
                    )
                )
                for event in result.get(
                    "events",
                    [],
                )
            )

            returned_token = result.get(
                "nextToken"
            )

            if (
                not returned_token
                or returned_token
                == next_token
            ):
                break

            next_token = (
                returned_token
            )

        messages = "\n".join(
            collected_messages
        )

        history_events_observed = (
            "ask_jm8_history_saved"
            in messages
        )

        if history_events_observed:
            break

        time.sleep(1)

    private_log_values = (
        TOKEN,
        AUTHENTICATED_USER_ID,
        proof_question,
        SUFFIX,
        generated_history_id,
        ISOLATION_HISTORY_ID,
        *PAGE_HISTORY_IDS,
        "rawText",
        "cleanText",
        "reservationId",
        "accessToken",
        "idToken",
        "refreshToken",
    )

    cloudwatch_private = all(
        value not in messages
        for value in private_log_values
        if value
    )

    print(
        (
            "CloudWatch history events "
            "observed:"
        ),
        history_events_observed,
    )

    print(
        (
            "CloudWatch private values "
            "absent:"
        ),
        cloudwatch_private,
    )

    if not all([
        history_events_observed,
        cloudwatch_private,
    ]):
        raise RuntimeError(
            "The CloudWatch privacy "
            "proof failed."
        )

    proof_succeeded = True

finally:
    cleanup_proof_records()

    print(
        (
            "Production proof records "
            "cleaned:"
        ),
        True,
    )


print(
    (
        "Ask JM8 production history "
        "proof passed:"
    ),
    proof_succeeded,
)

if not proof_succeeded:
    raise SystemExit(
        "Ask JM8 production history "
        "proof failed."
    )
PY
