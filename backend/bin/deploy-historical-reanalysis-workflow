#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
jm8_validate_contract_or_exit
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${BEDROCK_ANALYSIS_MODEL_ID:?BEDROCK_ANALYSIS_MODEL_ID is required.}"
: "${ANALYSIS_SCHEMA_VERSION:?ANALYSIS_SCHEMA_VERSION is required.}"
: "${ANALYSIS_PROMPT_VERSION:?ANALYSIS_PROMPT_VERSION is required.}"

WORKER_FUNCTION_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-worker"
)"

COORDINATOR_FUNCTION_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-coordinator"
)"

WORKER_ROLE_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-worker-role"
)"

COORDINATOR_ROLE_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-coordinator-role"
)"

STATE_ROLE_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-step-role"
)"

STATE_MACHINE_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-workflow"
)"

WORKER_POLICY_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-worker-access"
)"

COORDINATOR_POLICY_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-historical-reanalysis-coordinator-access"
)"

STATE_POLICY_NAME="$(
  printf '%s' \
    "${APP_NAME}-${STAGE}-invoke-historical-reanalysis"
)"

STATE_LOG_GROUP="/aws/vendedlogs/states/${STATE_MACHINE_NAME}"

ZIP_FILE="dist/function.zip"

DEFINITION_TEMPLATE=\
"infra/historical-reanalysis-workflow.asl.json"

BUILD_DIR=".build/historical-reanalysis"

RESOLVED_DEFINITION=\
"${BUILD_DIR}/workflow.resolved.json"

LAMBDA_TRUST_POLICY=\
"${BUILD_DIR}/lambda-trust.json"

STATE_TRUST_POLICY=\
"${BUILD_DIR}/step-functions-trust.json"

WORKER_POLICY_FILE=\
"${BUILD_DIR}/worker-policy.json"

COORDINATOR_POLICY_FILE=\
"${BUILD_DIR}/coordinator-policy.json"

STATE_POLICY_FILE=\
"${BUILD_DIR}/state-policy.json"

STATE_POLICY_APPLIED_FILE=\
"${BUILD_DIR}/state-policy-applied.json"

STATE_MACHINE_WRITE_ERROR_FILE=\
"${BUILD_DIR}/state-machine-write.err"

STATE_LOG_GROUP_LOOKUP_FILE=\
"${BUILD_DIR}/state-log-group-lookup.json"

STATE_LOG_GROUP_LOOKUP_ERROR_FILE=\
"${BUILD_DIR}/state-log-group-lookup.err"

INFERENCE_PROFILE_FILE=\
"${BUILD_DIR}/inference-profile.json"

echo "Packaging backend functions..."
./bin/package

# bin/package rebuilds .build from scratch.
mkdir -p "$BUILD_DIR"

echo "Checking AWS identity..."

CALLER_ARN="$(
  aws sts get-caller-identity \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Arn" \
    --output text
)"

if [[ ! "$CALLER_ARN" =~ ^arn:([a-z0-9-]+):(iam|sts)::([0-9]{12}): ]]; then
  echo "AWS caller ARN is malformed." >&2
  exit 1
fi

AWS_PARTITION="${BASH_REMATCH[1]}"
ACCOUNT_ID="${BASH_REMATCH[3]}"

if [ "$ACCOUNT_ID" != "$EXPECTED_AWS_ACCOUNT_ID" ]; then
  echo "AWS caller account does not match the deployment contract." >&2
  exit 1
fi

echo "AWS identity verified."

set +e
aws logs describe-log-groups \
  --log-group-name-prefix "$STATE_LOG_GROUP" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --output json \
  > "$STATE_LOG_GROUP_LOOKUP_FILE" \
  2> "$STATE_LOG_GROUP_LOOKUP_ERROR_FILE"
LOG_GROUP_LOOKUP_STATUS=$?
set -e

if [ "$LOG_GROUP_LOOKUP_STATUS" -ne 0 ]; then
  cat "$STATE_LOG_GROUP_LOOKUP_ERROR_FILE" >&2
  echo "CloudWatch log group lookup failed; refusing to create it." >&2
  exit "$LOG_GROUP_LOOKUP_STATUS"
fi

STATE_LOG_GROUP_STATUS="$(
  python3 - \
    "$STATE_LOG_GROUP_LOOKUP_FILE" \
    "$STATE_LOG_GROUP" <<'PY_LOG_GROUP_LOOKUP'
import json
import sys
from pathlib import Path

response = json.loads(Path(sys.argv[1]).read_text())
expected_name = sys.argv[2]

if not isinstance(response, dict):
    raise SystemExit("CloudWatch log group lookup response is malformed.")

log_groups = response.get("logGroups")
if not isinstance(log_groups, list):
    raise SystemExit("CloudWatch log group lookup response is malformed.")

matches = []
for log_group in log_groups:
    if not isinstance(log_group, dict):
        raise SystemExit("CloudWatch log group lookup response is malformed.")
    name = log_group.get("logGroupName")
    if not isinstance(name, str) or not name:
        raise SystemExit("CloudWatch log group lookup response is malformed.")
    if name == expected_name:
        matches.append(log_group)

if len(matches) > 1:
    raise SystemExit("CloudWatch log group lookup returned duplicates.")

print("PRESENT" if matches else "ABSENT")
PY_LOG_GROUP_LOOKUP
)"

if [ "$STATE_LOG_GROUP_STATUS" = "ABSENT" ]; then
  aws logs create-log-group \
    --log-group-name "$STATE_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
elif [ "$STATE_LOG_GROUP_STATUS" != "PRESENT" ]; then
  echo "CloudWatch log group lookup returned an unexpected status." >&2
  exit 1
fi

aws logs put-retention-policy \
  --log-group-name "$STATE_LOG_GROUP" \
  --retention-in-days 30 \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

STATE_LOG_GROUP_FIELDS="$(
  aws logs describe-log-groups \
    --log-group-name-prefix "$STATE_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "logGroups[?logGroupName=='${STATE_LOG_GROUP}'] | [0] | {logGroupName:logGroupName,arn:arn,logGroupArn:logGroupArn}" \
    --output json
)"

STATE_LOG_GROUP_BASE_ARN="$(
  python3 - \
    "$STATE_LOG_GROUP_FIELDS" \
    "$STATE_LOG_GROUP" \
    "$AWS_PARTITION" \
    "$AWS_REGION" \
    "$ACCOUNT_ID" <<'PY_LOG_GROUP'
import json
import re
import sys

fields = json.loads(sys.argv[1])
expected_name = sys.argv[2]
expected_partition = sys.argv[3]
expected_region = sys.argv[4]
expected_account = sys.argv[5]

if not isinstance(fields, dict) or fields.get("logGroupName") != expected_name:
    raise SystemExit("Expected historical CloudWatch log group was not resolved.")

raw_arn = fields.get("logGroupArn") or fields.get("arn")
if not isinstance(raw_arn, str) or not raw_arn:
    raise SystemExit("Historical CloudWatch log group ARN was not resolved.")

canonical_arn = raw_arn[:-2] if raw_arn.endswith(":*") else raw_arn
arn_pattern = re.compile(
    r"^arn:(?P<partition>[a-z0-9-]+):(?P<service>[^:]+):"
    r"(?P<region>[^:]+):(?P<account>[0-9]{12}):"
    r"log-group:(?P<name>[^:*]+)$"
)
match = arn_pattern.fullmatch(canonical_arn)
if not match:
    raise SystemExit("Historical CloudWatch log group ARN has an invalid format.")
if match.group("partition") != expected_partition:
    raise SystemExit("Historical CloudWatch log group ARN partition is incorrect.")
if match.group("service") != "logs":
    raise SystemExit("Historical CloudWatch log group ARN service is incorrect.")
if match.group("region") != expected_region:
    raise SystemExit("Historical CloudWatch log group ARN region is incorrect.")
if match.group("account") != expected_account:
    raise SystemExit("Historical CloudWatch log group ARN account is incorrect.")
if match.group("name") != expected_name:
    raise SystemExit("Historical CloudWatch log group ARN name is incorrect.")

print(canonical_arn)
PY_LOG_GROUP
)"

STATE_LOG_GROUP_DESTINATION_ARN="${STATE_LOG_GROUP_BASE_ARN}:*"

TABLE_ARN="$(
  aws dynamodb describe-table \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Table.TableArn" \
    --output text
)"

if (
  [ -z "$TABLE_ARN" ] ||
  [ "$TABLE_ARN" = "None" ]
); then
  echo "DynamoDB table could not be resolved."
  exit 1
fi

echo "Resolving Bedrock inference profile..."

aws bedrock get-inference-profile \
  --inference-profile-identifier \
    "$BEDROCK_ANALYSIS_MODEL_ID" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --output json \
  > "$INFERENCE_PROFILE_FILE"

cat > "$LAMBDA_TRUST_POLICY" <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
JSON

cat > "$STATE_TRUST_POLICY" <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "states.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
JSON

python3 - \
  "$TABLE_ARN" \
  "$INFERENCE_PROFILE_FILE" \
  "$WORKER_POLICY_FILE" \
  "$COORDINATOR_POLICY_FILE" <<'PY'
import json
import sys
from pathlib import Path

table_arn = sys.argv[1]
profile_path = Path(sys.argv[2])
worker_policy_path = Path(sys.argv[3])
coordinator_policy_path = Path(
    sys.argv[4]
)

profile = json.loads(
    profile_path.read_text()
)

profile_arn = str(
    profile.get("inferenceProfileArn")
    or ""
).strip()

model_arns = sorted({
    str(
        model.get("modelArn")
        or ""
    ).strip()
    for model in profile.get(
        "models",
        [],
    )
    if str(
        model.get("modelArn")
        or ""
    ).strip()
})

if not profile_arn:
    raise SystemExit(
        "Bedrock inference profile ARN "
        "was not returned."
    )

if not model_arns:
    raise SystemExit(
        "Bedrock inference profile returned "
        "no destination models."
    )

worker_policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadJournalEntries",
            "Effect": "Allow",
            "Action": [
                "dynamodb:Query",
                "dynamodb:GetItem",
            ],
            "Resource": [
                table_arn,
                f"{table_arn}/index/*",
            ],
        },
        {
            "Sid": "WriteAnalysisResults",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:TransactWriteItems",
            ],
            "Resource": table_arn,
        },
        {
            "Sid": "ReadAnalysisInferenceProfile",
            "Effect": "Allow",
            "Action": [
                "bedrock:GetInferenceProfile",
            ],
            "Resource": profile_arn,
        },
        {
            "Sid": "InvokeAnalysisProfile",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
            ],
            "Resource": profile_arn,
        },
        {
            "Sid": "InvokeDestinationModels",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
            ],
            "Resource": model_arns,
            "Condition": {
                "StringEquals": {
                    "bedrock:InferenceProfileArn": (
                        profile_arn
                    ),
                },
            },
        },
    ],
}

coordinator_policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadReanalysisState",
            "Effect": "Allow",
            "Action": [
                "dynamodb:Query",
                "dynamodb:GetItem",
            ],
            "Resource": [
                table_arn,
                f"{table_arn}/index/*",
            ],
        },
        {
            "Sid": "WriteReanalysisState",
            "Effect": "Allow",
            "Action": [
                "dynamodb:DeleteItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:TransactWriteItems",
            ],
            "Resource": table_arn,
        },
    ],
}

worker_policy_path.write_text(
    json.dumps(
        worker_policy,
        indent=2,
    )
    + "\n"
)

coordinator_policy_path.write_text(
    json.dumps(
        coordinator_policy,
        indent=2,
    )
    + "\n"
)

print(
    "Worker and coordinator policies prepared."
)
PY

ensure_lambda_role() {
  local role_name="$1"
  local role_description="$2"
  local policy_name="$3"
  local policy_file="$4"

  if aws iam get-role \
    --role-name "$role_name" \
    --profile "$AWS_PROFILE" \
    >/dev/null 2>&1
  then
    echo "Updating IAM role: $role_name" >&2

    aws iam update-assume-role-policy \
      --role-name "$role_name" \
      --policy-document \
        "file://${LAMBDA_TRUST_POLICY}" \
      --profile "$AWS_PROFILE" \
      >/dev/null
  else
    echo "Creating IAM role: $role_name" >&2

    aws iam create-role \
      --role-name "$role_name" \
      --description "$role_description" \
      --assume-role-policy-document \
        "file://${LAMBDA_TRUST_POLICY}" \
      --profile "$AWS_PROFILE" \
      >/dev/null

    sleep 10
  fi

  aws iam attach-role-policy \
    --role-name "$role_name" \
    --policy-arn \
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" \
    --profile "$AWS_PROFILE" \
    >/dev/null

  aws iam put-role-policy \
    --role-name "$role_name" \
    --policy-name "$policy_name" \
    --policy-document \
      "file://${policy_file}" \
    --profile "$AWS_PROFILE" \
    >/dev/null

  aws iam get-role \
    --role-name "$role_name" \
    --profile "$AWS_PROFILE" \
    --query "Role.Arn" \
    --output text
}

WORKER_ROLE_ARN="$(
  ensure_lambda_role \
    "$WORKER_ROLE_NAME" \
    "JournalM8 historical re-analysis worker role" \
    "$WORKER_POLICY_NAME" \
    "$WORKER_POLICY_FILE"
)"

COORDINATOR_ROLE_ARN="$(
  ensure_lambda_role \
    "$COORDINATOR_ROLE_NAME" \
    "JournalM8 historical re-analysis coordinator role" \
    "$COORDINATOR_POLICY_NAME" \
    "$COORDINATOR_POLICY_FILE"
)"

ensure_lambda_function() {
  local function_name="$1"
  local role_arn="$2"
  local handler="$3"
  local timeout="$4"
  local memory_size="$5"
  local environment="$6"

  if aws lambda get-function \
    --function-name "$function_name" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null 2>&1
  then
    echo "Updating Lambda: $function_name"

    aws lambda update-function-code \
      --function-name "$function_name" \
      --zip-file "fileb://${ZIP_FILE}" \
      --architectures arm64 \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null

    aws lambda wait function-updated \
      --function-name "$function_name" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"

    aws lambda update-function-configuration \
      --function-name "$function_name" \
      --runtime python3.12 \
      --role "$role_arn" \
      --handler "$handler" \
      --timeout "$timeout" \
      --memory-size "$memory_size" \
      --environment "$environment" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null

    aws lambda wait function-updated \
      --function-name "$function_name" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  else
    echo "Creating Lambda: $function_name"

    aws lambda create-function \
      --function-name "$function_name" \
      --runtime python3.12 \
      --architectures arm64 \
      --role "$role_arn" \
      --handler "$handler" \
      --zip-file "fileb://${ZIP_FILE}" \
      --timeout "$timeout" \
      --memory-size "$memory_size" \
      --environment "$environment" \
      --tags \
        "App=${APP_NAME},Stage=${STAGE},ManagedBy=aws-cli" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null

    aws lambda wait function-active-v2 \
      --function-name "$function_name" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  fi
}

WORKER_ENVIRONMENT="$(
  printf '%s' \
    "Variables={APP_NAME=${APP_NAME}," \
    "STAGE=${STAGE}," \
    "TABLE_NAME=${TABLE_NAME}," \
    "RAW_BUCKET=${RAW_BUCKET}," \
    "BEDROCK_ANALYSIS_MODEL_ID=${BEDROCK_ANALYSIS_MODEL_ID}," \
    "ANALYSIS_SCHEMA_VERSION=${ANALYSIS_SCHEMA_VERSION}," \
    "ANALYSIS_PROMPT_VERSION=${ANALYSIS_PROMPT_VERSION}}"
)"

COORDINATOR_ENVIRONMENT="$(
  printf '%s' \
    "Variables={APP_NAME=${APP_NAME}," \
    "STAGE=${STAGE}," \
    "TABLE_NAME=${TABLE_NAME}," \
    "RAW_BUCKET=${RAW_BUCKET}}"
)"

ensure_lambda_function \
  "$WORKER_FUNCTION_NAME" \
  "$WORKER_ROLE_ARN" \
  "historical_reanalysis_worker.lambda_handler" \
  90 \
  512 \
  "$WORKER_ENVIRONMENT"

ensure_lambda_function \
  "$COORDINATOR_FUNCTION_NAME" \
  "$COORDINATOR_ROLE_ARN" \
  "historical_reanalysis_coordinator.lambda_handler" \
  30 \
  256 \
  "$COORDINATOR_ENVIRONMENT"

echo "Applying worker reserved concurrency when available."

CONCURRENCY_ERROR_FILE="${BUILD_DIR}/worker-concurrency-error.txt"

if aws lambda put-function-concurrency \
  --function-name "$WORKER_FUNCTION_NAME" \
  --reserved-concurrent-executions 2 \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null \
  2>"$CONCURRENCY_ERROR_FILE"
then
  WORKER_CONCURRENCY_MODE="reserved"

  echo "Worker reserved concurrency set to 2."
else
  if grep -q \
    "UnreservedConcurrentExecution below its minimum value" \
    "$CONCURRENCY_ERROR_FILE"
  then
    WORKER_CONCURRENCY_MODE="workflow-only"

    echo "Account quota does not allow reserved concurrency."
    echo "Step Functions MaxConcurrency=2 remains enforced."
  else
    cat "$CONCURRENCY_ERROR_FILE" >&2
    exit 1
  fi
fi

rm -f "$CONCURRENCY_ERROR_FILE"

WORKER_ARN="$(
  aws lambda get-function-configuration \
    --function-name "$WORKER_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "FunctionArn" \
    --output text
)"

COORDINATOR_ARN="$(
  aws lambda get-function-configuration \
    --function-name "$COORDINATOR_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "FunctionArn" \
    --output text
)"

python3 - \
  "$DEFINITION_TEMPLATE" \
  "$RESOLVED_DEFINITION" \
  "$WORKER_ARN" \
  "$COORDINATOR_ARN" <<'PY'
import json
import sys
from pathlib import Path

template_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
worker_arn = sys.argv[3]
coordinator_arn = sys.argv[4]

definition = template_path.read_text()

worker_placeholder = (
    "__REANALYSIS_WORKER_ARN__"
)

coordinator_placeholder = (
    "__REANALYSIS_COORDINATOR_ARN__"
)

if worker_placeholder not in definition:
    raise SystemExit(
        "Worker ARN placeholder was not found."
    )

if coordinator_placeholder not in definition:
    raise SystemExit(
        "Coordinator ARN placeholder "
        "was not found."
    )

definition = definition.replace(
    worker_placeholder,
    worker_arn,
)

definition = definition.replace(
    coordinator_placeholder,
    coordinator_arn,
)

parsed = json.loads(definition)

if (
    parsed["States"]["ProcessPage"]
    .get("MaxConcurrency")
    != 2
):
    raise SystemExit(
        "Workflow MaxConcurrency must be 2."
    )

output_path.write_text(
    json.dumps(
        parsed,
        indent=2,
    )
    + "\n"
)

print(
    "Workflow definition resolved."
)
PY

python3 - \
  "$WORKER_ARN" \
  "$COORDINATOR_ARN" \
  "$STATE_POLICY_FILE" <<'PY'
import json
import sys
from pathlib import Path

worker_arn = sys.argv[1]
coordinator_arn = sys.argv[2]
policy_path = Path(sys.argv[3])

policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "InvokeReanalysisFunctions",
            "Effect": "Allow",
            "Action": [
                "lambda:InvokeFunction",
            ],
            "Resource": [
                worker_arn,
                coordinator_arn,
            ],
        },
        {
            "Sid": "StepFunctionsLogDelivery",
            "Effect": "Allow",
            # CloudWatch Logs delivery APIs do not support resource-level
            # authorization, so AWS requires Resource "*" here.
            "Action": [
                "logs:CreateLogDelivery",
                "logs:GetLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery",
                "logs:ListLogDeliveries",
                "logs:PutResourcePolicy",
                "logs:DescribeResourcePolicies",
                "logs:DescribeLogGroups",
            ],
            "Resource": "*",
        },
        {
            "Sid": "StepFunctionsTracing",
            "Effect": "Allow",
            # Step Functions X-Ray integration actions do not support
            # resource-level authorization.
            "Action": [
                "xray:PutTraceSegments",
                "xray:PutTelemetryRecords",
                "xray:GetSamplingRules",
                "xray:GetSamplingTargets",
            ],
            "Resource": "*",
        },
    ],
}

policy_path.write_text(
    json.dumps(
        policy,
        indent=2,
    )
    + "\n"
)
PY

if aws iam get-role \
  --role-name "$STATE_ROLE_NAME" \
  --profile "$AWS_PROFILE" \
  >/dev/null 2>&1
then
  echo "Updating Step Functions IAM role."

  aws iam update-assume-role-policy \
    --role-name "$STATE_ROLE_NAME" \
    --policy-document \
      "file://${STATE_TRUST_POLICY}" \
    --profile "$AWS_PROFILE" \
    >/dev/null
else
  echo "Creating Step Functions IAM role."

  aws iam create-role \
    --role-name "$STATE_ROLE_NAME" \
    --description \
      "JournalM8 historical re-analysis Step Functions role" \
    --assume-role-policy-document \
      "file://${STATE_TRUST_POLICY}" \
    --profile "$AWS_PROFILE" \
    >/dev/null

  sleep 10
fi

aws iam put-role-policy \
  --role-name "$STATE_ROLE_NAME" \
  --policy-name "$STATE_POLICY_NAME" \
  --policy-document \
    "file://${STATE_POLICY_FILE}" \
  --profile "$AWS_PROFILE" \
  >/dev/null

aws iam get-role-policy \
  --role-name "$STATE_ROLE_NAME" \
  --policy-name "$STATE_POLICY_NAME" \
  --profile "$AWS_PROFILE" \
  --query "PolicyDocument" \
  --output json \
  > "$STATE_POLICY_APPLIED_FILE"

python3 - \
  "$STATE_POLICY_FILE" \
  "$STATE_POLICY_APPLIED_FILE" <<'PY_POLICY_VERIFY'
import json
import sys
from pathlib import Path
from urllib.parse import unquote


def load_policy(path_value):
    value = json.loads(Path(path_value).read_text())
    if isinstance(value, str):
        value = json.loads(unquote(value))
    if not isinstance(value, dict):
        raise SystemExit("Step Functions inline role policy is malformed.")
    return value


expected_policy = load_policy(sys.argv[1])
applied_policy = load_policy(sys.argv[2])

if applied_policy != expected_policy:
    raise SystemExit("Step Functions inline role policy was not applied exactly.")
PY_POLICY_VERIFY

run_stepfunctions_write_with_iam_propagation_retry() {
  local operation="$1"
  local error_file="$2"
  shift 2

  local max_attempts=5
  local retry_waits=(5 10 20 30)
  local attempt=1
  local command_status
  local wait_seconds

  while [ "$attempt" -le "$max_attempts" ]; do
    echo \
      "Step Functions ${operation} attempt ${attempt}/${max_attempts}." \
      >&2

    if "$@" 2> "$error_file"; then
      rm -f "$error_file"
      echo \
        "Step Functions ${operation} succeeded on attempt ${attempt}/${max_attempts}." \
        >&2
      return 0
    else
      command_status=$?
    fi

    if (
      grep -Fq \
        "AccessDeniedException" \
        "$error_file" &&
      grep -Fq \
        "state machine IAM Role is not authorized to access the Log Destination" \
        "$error_file"
    ); then
      if [ "$attempt" -eq "$max_attempts" ]; then
        echo \
          "Step Functions ${operation} exhausted ${max_attempts} IAM propagation attempts." \
          >&2
        cat "$error_file" >&2
        return "$command_status"
      fi

      wait_seconds="${retry_waits[$((attempt - 1))]}"
      echo \
        "Known IAM log-destination propagation delay; waiting ${wait_seconds} seconds before retry." \
        >&2
      sleep "$wait_seconds"
      attempt=$((attempt + 1))
    else
      echo \
        "Step Functions ${operation} failed with a non-retryable AWS error." \
        >&2
      cat "$error_file" >&2
      return "$command_status"
    fi
  done

  return 1
}

STATE_ROLE_ARN="$(
  aws iam get-role \
    --role-name "$STATE_ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --query "Role.Arn" \
    --output text
)"

STATE_MACHINE_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${STATE_MACHINE_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if (
  [ -z "$STATE_MACHINE_ARN" ] ||
  [ "$STATE_MACHINE_ARN" = "None" ]
); then
  echo "Creating historical re-analysis state machine."

  STATE_MACHINE_ARN="$(
    run_stepfunctions_write_with_iam_propagation_retry \
      "create-state-machine" \
      "$STATE_MACHINE_WRITE_ERROR_FILE" \
      aws stepfunctions create-state-machine \
      --name "$STATE_MACHINE_NAME" \
      --definition \
        "file://${RESOLVED_DEFINITION}" \
      --role-arn "$STATE_ROLE_ARN" \
      --type STANDARD \
      --logging-configuration \
        "level=ERROR,includeExecutionData=false,destinations=[{cloudWatchLogsLogGroup={logGroupArn=${STATE_LOG_GROUP_DESTINATION_ARN}}}]" \
      --tracing-configuration enabled=true \
      --tags \
        "key=App,value=${APP_NAME}" \
        "key=Stage,value=${STAGE}" \
        "key=ManagedBy,value=aws-cli" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query "stateMachineArn" \
      --output text
  )"
else
  echo "Updating historical re-analysis state machine."

  run_stepfunctions_write_with_iam_propagation_retry \
    "update-state-machine" \
    "$STATE_MACHINE_WRITE_ERROR_FILE" \
    aws stepfunctions update-state-machine \
    --state-machine-arn "$STATE_MACHINE_ARN" \
    --definition \
      "file://${RESOLVED_DEFINITION}" \
    --role-arn "$STATE_ROLE_ARN" \
    --logging-configuration \
      "level=ERROR,includeExecutionData=false,destinations=[{cloudWatchLogsLogGroup={logGroupArn=${STATE_LOG_GROUP_DESTINATION_ARN}}}]" \
    --tracing-configuration enabled=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null
fi

STATE_MACHINE_DESCRIPTION="$(
  aws stepfunctions describe-state-machine \
    --state-machine-arn "$STATE_MACHINE_ARN" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --output json
)"

python3 - \
  "$STATE_MACHINE_DESCRIPTION" \
  "$STATE_ROLE_ARN" \
  "$STATE_LOG_GROUP_DESTINATION_ARN" <<'PY_VERIFY'
import json
import sys

description = json.loads(sys.argv[1])
expected_role_arn = sys.argv[2]
expected_destination_arn = sys.argv[3]

if not isinstance(description, dict):
    raise SystemExit("Historical state machine description is malformed.")
if description.get("status") != "ACTIVE":
    raise SystemExit("Historical state machine is not ACTIVE.")
if description.get("roleArn") != expected_role_arn:
    raise SystemExit("Historical state machine role ARN is incorrect.")

logging = description.get("loggingConfiguration")
if not isinstance(logging, dict):
    raise SystemExit("Historical state machine logging configuration is missing.")
if logging.get("level") != "ERROR":
    raise SystemExit("Historical state machine logging level is incorrect.")
if logging.get("includeExecutionData") is not False:
    raise SystemExit("Historical state machine execution-data logging is enabled.")

destinations = logging.get("destinations")
if not isinstance(destinations, list) or len(destinations) != 1:
    raise SystemExit("Historical state machine must have exactly one log destination.")

destination = destinations[0]
if not isinstance(destination, dict):
    raise SystemExit("Historical state machine log destination is malformed.")
log_group = destination.get("cloudWatchLogsLogGroup")
if not isinstance(log_group, dict):
    raise SystemExit("Historical state machine log destination is malformed.")
actual_destination_arn = log_group.get("logGroupArn")
if actual_destination_arn != expected_destination_arn:
    raise SystemExit("Historical state machine log destination ARN is incorrect.")
if (
    not actual_destination_arn.endswith(":*")
    or actual_destination_arn.endswith(":*:*")
    or actual_destination_arn.count(":*") != 1
):
    raise SystemExit("Historical state machine log destination ARN is not canonical.")

tracing = description.get("tracingConfiguration")
if not isinstance(tracing, dict) or tracing.get("enabled") is not True:
    raise SystemExit("Historical state machine tracing is not enabled.")
PY_VERIFY

echo
echo "Historical re-analysis workflow ready."
echo "Worker Lambda: $WORKER_FUNCTION_NAME"
echo "Coordinator Lambda: $COORDINATOR_FUNCTION_NAME"
echo "State machine: $STATE_MACHINE_NAME"
echo "Worker concurrency mode: $WORKER_CONCURRENCY_MODE"
echo "Workflow MaxConcurrency: 2"
