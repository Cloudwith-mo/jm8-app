#!/usr/bin/env bash
set -euo pipefail

: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${FRONTEND_BUCKET:?FRONTEND_BUCKET is required. Run: source .env}"
: "${CLOUDFRONT_DISTRIBUTION_ID:?CLOUDFRONT_DISTRIBUTION_ID is required. Run: source .env}"
: "${FRONTEND_ORIGIN:?FRONTEND_ORIGIN is required. Run: source .env}"
: "${ALLOWED_ORIGINS:?ALLOWED_ORIGINS is required. Run: source .env}"
: "${VITE_API_ENDPOINT:?VITE_API_ENDPOINT is required. Run: source .env}"
: "${VITE_APP_STAGE:?VITE_APP_STAGE is required. Run: source .env}"
: "${VITE_COGNITO_DOMAIN:?VITE_COGNITO_DOMAIN is required. Run: source .env}"
: "${VITE_COGNITO_CLIENT_ID:?VITE_COGNITO_CLIENT_ID is required. Run: source .env}"
: "${VITE_COGNITO_REDIRECT_URI:?VITE_COGNITO_REDIRECT_URI is required. Run: source .env}"
: "${VITE_COGNITO_LOGOUT_URI:?VITE_COGNITO_LOGOUT_URI is required. Run: source .env}"
: "${STAGING_BASIC_AUTH_USERNAME:?STAGING_BASIC_AUTH_USERNAME is required. Run: source .env}"
: "${STAGING_BASIC_AUTH_PASSWORD:?STAGING_BASIC_AUTH_PASSWORD is required. Run: source .env}"

if [[ "${STAGE}" != "staging" ]]; then
  echo "ERROR: deploy-frontend is staging-only." >&2
  exit 1
fi

if [[ "${FRONTEND_BUCKET}" != "${APP_NAME}-${STAGE}-frontend-${EXPECTED_AWS_ACCOUNT_ID}" ]]; then
  echo "ERROR: FRONTEND_BUCKET must match ${APP_NAME}-${STAGE}-frontend-${EXPECTED_AWS_ACCOUNT_ID}" >&2
  exit 1
fi

if [[ "${FRONTEND_BUCKET}" == "${RAW_BUCKET}" ]]; then
  echo "ERROR: FRONTEND_BUCKET must be distinct from RAW_BUCKET." >&2
  exit 1
fi

if [[ "${FRONTEND_ORIGIN}" != https://* ]]; then
  echo "ERROR: FRONTEND_ORIGIN must use https." >&2
  exit 1
fi

FRONTEND_ORIGIN_URL="${FRONTEND_ORIGIN#https://}"
if [[ "$FRONTEND_ORIGIN_URL" == *"/"* ]] || [[ "$FRONTEND_ORIGIN_URL" == *"?"* ]] || [[ "$FRONTEND_ORIGIN_URL" == *"#"* ]]; then
  echo "ERROR: FRONTEND_ORIGIN must not include a path, query string, or fragment." >&2
  exit 1
fi

ORIGIN_COUNT="$(awk -v target="$FRONTEND_ORIGIN" -F',' '
BEGIN { count = 0 }
{
  for (i = 1; i <= NF; i++) {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
    if ($i == target) {
      count++
    }
  }
}
END { print count + 0 }
' <<< "$ALLOWED_ORIGINS")"
if [[ "$ORIGIN_COUNT" -ne 1 ]]; then
  echo "ERROR: FRONTEND_ORIGIN must appear exactly once in ALLOWED_ORIGINS." >&2
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
export JM8_OPERATION="deploy-frontend"

if ! jm8_validate_contract_or_exit; then
  exit 1
fi

DISTRIBUTION_DOMAIN="$(aws cloudfront get-distribution \
  --id "$CLOUDFRONT_DISTRIBUTION_ID" \
  --query 'Distribution.DomainName' \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")"

if [[ "$FRONTEND_ORIGIN" != "https://${DISTRIBUTION_DOMAIN}" ]]; then
  echo "ERROR: FRONTEND_ORIGIN must match the CloudFront distribution domain." >&2
  exit 1
fi

ORIGIN_BUCKET="$(aws cloudfront get-distribution \
  --id "$CLOUDFRONT_DISTRIBUTION_ID" \
  --query 'Distribution.DistributionConfig.Origins.Items[0].DomainName' \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")"

STACK_NAME="${APP_NAME}-${STAGE}-frontend-hosting"
EXPECTED_ORIGIN_BUCKET="$(aws cloudformation describe-stacks \
  --stack-name "$STACK_NAME" \
  --query 'Stacks[0].Outputs[?OutputKey==`FrontendBucketRegionalDomainName`].OutputValue | [0]' \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")"

if [[ -z "$EXPECTED_ORIGIN_BUCKET" || "$EXPECTED_ORIGIN_BUCKET" == "None" ]]; then
  echo "ERROR: could not resolve frontend bucket regional domain name from stack outputs." >&2
  exit 1
fi

if [[ "$ORIGIN_BUCKET" != "$EXPECTED_ORIGIN_BUCKET" ]]; then
  echo "ERROR: CloudFront origin does not match FRONTEND_BUCKET." >&2
  exit 1
fi

cd "$REPO_ROOT/frontend"
export VITE_API_ENDPOINT VITE_APP_STAGE VITE_COGNITO_DOMAIN VITE_COGNITO_CLIENT_ID VITE_COGNITO_REDIRECT_URI VITE_COGNITO_LOGOUT_URI

npm ci
npm run test
npm run build:staging

if [[ ! -f dist/index.html ]]; then
  echo "ERROR: dist/index.html was not generated." >&2
  exit 1
fi

if [[ ! -d dist/assets ]]; then
  echo "ERROR: dist/assets was not generated." >&2
  exit 1
fi

find dist -type f -name '*.map' -delete

aws s3 sync dist/ "s3://${FRONTEND_BUCKET}" \
  --delete \
  --cache-control "no-cache" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

aws s3 cp dist/assets/ "s3://${FRONTEND_BUCKET}/assets/" \
  --recursive \
  --cache-control "public,max-age=31536000,immutable" \
  --metadata-directive REPLACE \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

aws s3 cp "dist/index.html" "s3://${FRONTEND_BUCKET}/index.html" \
  --cache-control "no-cache,no-store,must-revalidate" \
  --metadata-directive REPLACE \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

INVALIDATION_ID="$(aws cloudfront create-invalidation \
  --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
  --paths '/*' \
  --query 'Invalidation.Id' \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")"

aws cloudfront wait invalidation-deployed \
  --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
  --id "$INVALIDATION_ID" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

tmp_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

UNAUTH_STATUS="$(curl -sS -o "$tmp_dir/unauth.out" -w '%{http_code}' "$FRONTEND_ORIGIN/")"
if [[ "$UNAUTH_STATUS" != "401" ]]; then
  echo "ERROR: unauthenticated frontend request must return 401." >&2
  exit 1
fi

set +x
encoded_credentials="$(printf '%s:%s' "$STAGING_BASIC_AUTH_USERNAME" "$STAGING_BASIC_AUTH_PASSWORD" | base64 | tr -d '\n')"
auth_header="Authorization: Basic ${encoded_credentials}"

authenticated_status() {
  local request_url="$1"
  local output_path="$2"

  curl --config - <<EOF
url = "$request_url"
header = "$auth_header"
silent
show-error
output = "$output_path"
write-out = "%{http_code}"
EOF
}

AUTH_STATUS="$(authenticated_status "$FRONTEND_ORIGIN/" "$tmp_dir/home.out")"
if [[ "$AUTH_STATUS" != "200" ]]; then
  echo "ERROR: authenticated frontend home request must return 200." >&2
  exit 1
fi

ARCHIVE_STATUS="$(authenticated_status "$FRONTEND_ORIGIN/archive" "$tmp_dir/archive.out")"
if [[ "$ARCHIVE_STATUS" != "200" ]]; then
  echo "ERROR: authenticated archive route must return 200." >&2
  exit 1
fi

printf '%s\n%s\n%s\n%s\n' "$FRONTEND_BUCKET" "$CLOUDFRONT_DISTRIBUTION_ID" "$FRONTEND_ORIGIN" "$DISTRIBUTION_DOMAIN"
