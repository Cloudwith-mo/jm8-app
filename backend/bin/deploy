#!/usr/bin/env bash
set -euo pipefail

: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${BEDROCK_ANALYSIS_MODEL_ID:?BEDROCK_ANALYSIS_MODEL_ID is required.}"
: "${ANALYSIS_SCHEMA_VERSION:?ANALYSIS_SCHEMA_VERSION is required.}"
: "${ANALYSIS_PROMPT_VERSION:?ANALYSIS_PROMPT_VERSION is required.}"
: "${STRIPE_SECRET_ARN:?STRIPE_SECRET_ARN is required.}"
: "${STRIPE_WEBHOOK_SECRET:?STRIPE_WEBHOOK_SECRET is required.}"
: "${STRIPE_PRO_MONTHLY_PRICE_ID:?STRIPE_PRO_MONTHLY_PRICE_ID is required.}"
: "${STRIPE_CHECKOUT_SUCCESS_URL:?STRIPE_CHECKOUT_SUCCESS_URL is required.}"
: "${STRIPE_CHECKOUT_CANCEL_URL:?STRIPE_CHECKOUT_CANCEL_URL is required.}"
: "${STRIPE_PORTAL_RETURN_URL:?STRIPE_PORTAL_RETURN_URL is required.}"

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
FUNCTION_NAME="${APP_NAME}-${STAGE}-api"
ZIP_FILE="dist/function.zip"
OCR_WORKFLOW_NAME="${APP_NAME}-${STAGE}-ocr-workflow"
HISTORICAL_REANALYSIS_WORKFLOW_NAME="${APP_NAME}-${STAGE}-historical-reanalysis-workflow"
API_WORKFLOW_POLICY_NAME="${APP_NAME}-${STAGE}-start-ocr-workflow"
API_HISTORICAL_REANALYSIS_WORKFLOW_POLICY_NAME="${APP_NAME}-${STAGE}-start-historical-reanalysis-workflow"
API_BATCH_WRITE_POLICY_NAME="${APP_NAME}-${STAGE}-batch-write-main-table"
API_STRIPE_SECRET_POLICY_NAME="${APP_NAME}-${STAGE}-read-stripe-secret"

FREE_MONTHLY_ASK_QUESTIONS="${FREE_MONTHLY_ASK_QUESTIONS:-5}"
FREE_MONTHLY_ENTRY_ANALYSES="${FREE_MONTHLY_ENTRY_ANALYSES:-10}"
PRO_MONTHLY_ASK_QUESTIONS="${PRO_MONTHLY_ASK_QUESTIONS:-100}"
PRO_MONTHLY_ENTRY_ANALYSES="${PRO_MONTHLY_ENTRY_ANALYSES:-250}"

./bin/package

echo "Checking AWS identity..."
aws sts get-caller-identity \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "AWS identity verified."

echo "Checking IAM role: $ROLE_NAME"

ROLE_ARN=$(aws iam get-role \
  --role-name "$ROLE_NAME" \
  --query "Role.Arn" \
  --output text \
  --profile "$AWS_PROFILE")

echo "Resolving OCR workflow: $OCR_WORKFLOW_NAME"

OCR_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${OCR_WORKFLOW_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if [ -z "$OCR_WORKFLOW_ARN" ] || [ "$OCR_WORKFLOW_ARN" = "None" ]; then
  echo "OCR workflow was not found."
  echo "Run: ./bin/deploy-ocr-workflow"
  exit 1
fi

echo "Resolving historical re-analysis workflow: $HISTORICAL_REANALYSIS_WORKFLOW_NAME"

HISTORICAL_REANALYSIS_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines     --profile "$AWS_PROFILE"     --region "$AWS_REGION"     --query       "stateMachines[?name=='${HISTORICAL_REANALYSIS_WORKFLOW_NAME}'].stateMachineArn | [0]"     --output text
)"

if [ -z "$HISTORICAL_REANALYSIS_WORKFLOW_ARN" ] \
  || [ "$HISTORICAL_REANALYSIS_WORKFLOW_ARN" = "None" ]; then
  echo "Historical re-analysis workflow was not found."
  echo "Run: ./bin/deploy-historical-reanalysis-workflow"
  exit 1
fi

mkdir -p .build

TABLE_ARN="$(
  aws dynamodb describe-table \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query Table.TableArn \
    --output text
)"

if [ -z "$TABLE_ARN" ] || [ "$TABLE_ARN" = "None" ]; then
  echo "DynamoDB table ARN could not be resolved."
  exit 1
fi

python3 - "$TABLE_ARN" \
  > .build/api-batch-write-policy.json <<'PY_POLICY'
import json
import sys

table_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:BatchWriteItem"
            ],
            "Resource": table_arn
        }
    ]
}))
PY_POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_BATCH_WRITE_POLICY_NAME" \
  --policy-document \
    file://.build/api-batch-write-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can batch-delete entry history."

python3 - "$OCR_WORKFLOW_ARN" \
  > .build/api-ocr-workflow-policy.json <<'PY'
import json
import sys

workflow_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "states:StartExecution"
            ],
            "Resource": workflow_arn
        }
    ]
}))
PY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_WORKFLOW_POLICY_NAME" \
  --policy-document file://.build/api-ocr-workflow-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can start the OCR workflow."

python3 - "$HISTORICAL_REANALYSIS_WORKFLOW_ARN"   > .build/api-historical-reanalysis-workflow-policy.json <<'PY_HISTORICAL'
import json
import sys

workflow_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "states:StartExecution"
            ],
            "Resource": workflow_arn
        }
    ]
}))
PY_HISTORICAL

aws iam put-role-policy   --role-name "$ROLE_NAME"   --policy-name     "$API_HISTORICAL_REANALYSIS_WORKFLOW_POLICY_NAME"   --policy-document     file://.build/api-historical-reanalysis-workflow-policy.json   --profile "$AWS_PROFILE"

echo "API role can start the historical re-analysis workflow."

echo "Verifying Stripe secret reference."

aws secretsmanager describe-secret \
  --secret-id "$STRIPE_SECRET_ARN" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "Stripe secret reference verified."

python3 - "$STRIPE_SECRET_ARN" \
  > .build/api-stripe-secret-policy.json <<'PY_STRIPE_POLICY'
import json
import sys


secret_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": secret_arn
        }
    ]
}))
PY_STRIPE_POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_STRIPE_SECRET_POLICY_NAME" \
  --policy-document \
    file://.build/api-stripe-secret-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can retrieve the Stripe secret."

export APP_NAME
export STAGE
export TABLE_NAME
export RAW_BUCKET
export OCR_WORKFLOW_ARN
export HISTORICAL_REANALYSIS_WORKFLOW_ARN
export BEDROCK_ANALYSIS_MODEL_ID
export ANALYSIS_SCHEMA_VERSION
export ANALYSIS_PROMPT_VERSION
export FREE_MONTHLY_ASK_QUESTIONS
export FREE_MONTHLY_ENTRY_ANALYSES
export PRO_MONTHLY_ASK_QUESTIONS
export PRO_MONTHLY_ENTRY_ANALYSES
export STRIPE_SECRET_ARN
export STRIPE_WEBHOOK_SECRET
export STRIPE_PRO_MONTHLY_PRICE_ID
export STRIPE_CHECKOUT_SUCCESS_URL
export STRIPE_CHECKOUT_CANCEL_URL
export STRIPE_PORTAL_RETURN_URL

python3 \
  > .build/api-environment.json <<'PY_API_ENV'
from __future__ import annotations

import json
import os


environment_keys = [
    "APP_NAME",
    "STAGE",
    "TABLE_NAME",
    "RAW_BUCKET",
    "OCR_WORKFLOW_ARN",
    "HISTORICAL_REANALYSIS_WORKFLOW_ARN",
    "BEDROCK_ANALYSIS_MODEL_ID",
    "ANALYSIS_SCHEMA_VERSION",
    "ANALYSIS_PROMPT_VERSION",
    "FREE_MONTHLY_ASK_QUESTIONS",
    "FREE_MONTHLY_ENTRY_ANALYSES",
    "PRO_MONTHLY_ASK_QUESTIONS",
    "PRO_MONTHLY_ENTRY_ANALYSES",
    "STRIPE_SECRET_ARN",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRO_MONTHLY_PRICE_ID",
    "STRIPE_CHECKOUT_SUCCESS_URL",
    "STRIPE_CHECKOUT_CANCEL_URL",
    "STRIPE_PORTAL_RETURN_URL",
]

variables = {}

for key in environment_keys:
    value = str(
        os.environ.get(
            key
        )
        or ""
    ).strip()

    if not value:
        raise SystemExit(
            f"{key} is required."
        )

    variables[key] = value

if "STRIPE_SECRET_KEY" in variables:
    raise SystemExit(
        "The plaintext Stripe secret "
        "must not enter Lambda configuration."
    )

print(json.dumps({
    "Variables": variables,
}))
PY_API_ENV

chmod 600 \
  .build/api-environment.json

echo "Lambda environment configuration prepared."

echo "Checking Lambda function: $FUNCTION_NAME"

set +e
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
FUNCTION_EXISTS=$?
set -e

if [ "$FUNCTION_EXISTS" -ne 0 ]; then
  echo "Creating Lambda function: $FUNCTION_NAME"

  aws lambda create-function \
    --function-name "$FUNCTION_NAME" \
    --runtime python3.12 \
    --architectures arm64 \
    --role "$ROLE_ARN" \
    --handler app.lambda_handler \
    --zip-file "fileb://${ZIP_FILE}" \
    --timeout 28 \
    --memory-size 512 \
    --environment file://.build/api-environment.json \
    --tags "App=${APP_NAME},Stage=${STAGE},ManagedBy=aws-cli" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda function to become active..."
  aws lambda wait function-active-v2 \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "Lambda created."
else
  echo "Updating Lambda code: $FUNCTION_NAME"

  aws lambda update-function-code \
    --function-name "$FUNCTION_NAME" \
    --zip-file "fileb://${ZIP_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda code update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws lambda update-function-configuration \
    --function-name "$FUNCTION_NAME" \
    --timeout 28 \
    --memory-size 512 \
    --environment file://.build/api-environment.json \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda configuration update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "Lambda updated."
fi

echo "Deployed function:"
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --query "Configuration.{FunctionName:FunctionName,Runtime:Runtime,Handler:Handler,State:State,LastModified:LastModified}" \
  --output table \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"
