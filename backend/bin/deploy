#!/usr/bin/env bash
set -euo pipefail

: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
FUNCTION_NAME="${APP_NAME}-${STAGE}-api"
ZIP_FILE="dist/function.zip"

./bin/package

echo "Checking AWS identity..."
aws sts get-caller-identity \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

echo "Checking IAM role: $ROLE_NAME"

ROLE_ARN=$(aws iam get-role \
  --role-name "$ROLE_NAME" \
  --query "Role.Arn" \
  --output text \
  --profile "$AWS_PROFILE")

echo "Checking Lambda function: $FUNCTION_NAME"

set +e
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
FUNCTION_EXISTS=$?
set -e

if [ "$FUNCTION_EXISTS" -ne 0 ]; then
  echo "Creating Lambda function: $FUNCTION_NAME"

  aws lambda create-function \
    --function-name "$FUNCTION_NAME" \
    --runtime python3.12 \
    --architectures arm64 \
    --role "$ROLE_ARN" \
    --handler app.lambda_handler \
    --zip-file "fileb://${ZIP_FILE}" \
    --timeout 15 \
    --memory-size 256 \
    --environment "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --tags "App=${APP_NAME},Stage=${STAGE},ManagedBy=aws-cli" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda function to become active..."
  aws lambda wait function-active-v2 \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "Lambda created."
else
  echo "Updating Lambda code: $FUNCTION_NAME"

  aws lambda update-function-code \
    --function-name "$FUNCTION_NAME" \
    --zip-file "fileb://${ZIP_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda code update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws lambda update-function-configuration \
    --function-name "$FUNCTION_NAME" \
    --timeout 15 \
    --memory-size 256 \
    --environment "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda configuration update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "Lambda updated."
fi

echo "Deployed function:"
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --query "Configuration.{FunctionName:FunctionName,Runtime:Runtime,Handler:Handler,State:State,LastModified:LastModified}" \
  --output table \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"
