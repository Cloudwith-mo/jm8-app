#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${ENTRY_CHUNKS_TABLE_NAME:?ENTRY_CHUNKS_TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${EXPORT_BUCKET:?EXPORT_BUCKET is required. Run: source .env}"
: "${COGNITO_USER_POOL_ID:?COGNITO_USER_POOL_ID is required. Run: source .env}"
: "${COGNITO_USER_POOL_NAME:?COGNITO_USER_POOL_NAME is required. Run: source .env}"
: "${BEDROCK_ANALYSIS_MODEL_ID:?BEDROCK_ANALYSIS_MODEL_ID is required.}"
: "${ANALYSIS_SCHEMA_VERSION:?ANALYSIS_SCHEMA_VERSION is required.}"
: "${ANALYSIS_PROMPT_VERSION:?ANALYSIS_PROMPT_VERSION is required.}"
: "${STRIPE_SECRET_ARN:?STRIPE_SECRET_ARN is required.}"
: "${STRIPE_PRO_MONTHLY_PRICE_ID:?STRIPE_PRO_MONTHLY_PRICE_ID is required.}"
: "${STRIPE_CHECKOUT_SUCCESS_URL:?STRIPE_CHECKOUT_SUCCESS_URL is required.}"
: "${STRIPE_CHECKOUT_CANCEL_URL:?STRIPE_CHECKOUT_CANCEL_URL is required.}"
: "${STRIPE_PORTAL_RETURN_URL:?STRIPE_PORTAL_RETURN_URL is required.}"
: "${SEMANTIC_MEMORY_MAPPING_ENABLED:?SEMANTIC_MEMORY_MAPPING_ENABLED is required.}"
: "${SEMANTIC_EMBEDDING_MAPPING_ENABLED:?SEMANTIC_EMBEDDING_MAPPING_ENABLED is required.}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
source "$SCRIPT_DIR/jm8_bedrock_analysis_policy.sh"
source "$SCRIPT_DIR/jm8_resource_tags.sh"
export JM8_OPERATION="deploy"
jm8_validate_contract_or_exit

ROLE_NAME="${APP_NAME}-${STAGE}-lambda-basic-role"
FUNCTION_NAME="${APP_NAME}-${STAGE}-api"
ZIP_FILE="${JM8_DEPLOY_PACKAGE_PATH:-dist/function.zip}"
OCR_WORKFLOW_NAME="${APP_NAME}-${STAGE}-ocr-workflow"
HISTORICAL_REANALYSIS_WORKFLOW_NAME="${APP_NAME}-${STAGE}-historical-reanalysis-workflow"
ACCOUNT_EXPORT_WORKFLOW_NAME="${APP_NAME}-${STAGE}-account-export-workflow"
ACCOUNT_DELETION_WORKFLOW_NAME="${APP_NAME}-${STAGE}-account-deletion-workflow"
API_WORKFLOW_POLICY_NAME="${APP_NAME}-${STAGE}-start-ocr-workflow"
API_HISTORICAL_REANALYSIS_WORKFLOW_POLICY_NAME="${APP_NAME}-${STAGE}-start-historical-reanalysis-workflow"
API_ACCOUNT_EXPORT_POLICY_NAME="${APP_NAME}-${STAGE}-account-export"
API_ACCOUNT_DELETION_POLICY_NAME="${APP_NAME}-${STAGE}-start-account-deletion-workflow"
API_BATCH_WRITE_POLICY_NAME="${APP_NAME}-${STAGE}-batch-write-main-table"
API_STRIPE_SECRET_POLICY_NAME="${APP_NAME}-${STAGE}-read-stripe-secret"

FREE_MONTHLY_ASK_QUESTIONS="${FREE_MONTHLY_ASK_QUESTIONS:-5}"
FREE_MONTHLY_ENTRY_ANALYSES="${FREE_MONTHLY_ENTRY_ANALYSES:-10}"
PRO_MONTHLY_ASK_QUESTIONS="${PRO_MONTHLY_ASK_QUESTIONS:-100}"
PRO_MONTHLY_ENTRY_ANALYSES="${PRO_MONTHLY_ENTRY_ANALYSES:-250}"

if [[ -n "${JM8_DEPLOY_PACKAGE_PATH:-}" ]]; then
  : "${JM8_EXPECTED_PACKAGE_SHA256:?JM8_EXPECTED_PACKAGE_SHA256 is required with JM8_DEPLOY_PACKAGE_PATH.}"
  if [[ ! -f "$ZIP_FILE" ]]; then
    echo "Prebuilt deployment package was not found." >&2
    exit 1
  fi
  ACTUAL_PACKAGE_SHA256="$(shasum -a 256 "$ZIP_FILE" | awk '{print $1}')"
  if [[ "$ACTUAL_PACKAGE_SHA256" != "$JM8_EXPECTED_PACKAGE_SHA256" ]]; then
    echo "Prebuilt deployment package checksum does not match the release manifest." >&2
    exit 1
  fi
  echo "Verified prebuilt backend deployment package."
else
  ./bin/package
fi

mkdir -p .build

echo "Checking AWS identity..."
aws sts get-caller-identity \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "AWS identity verified."

echo "Checking IAM role: $ROLE_NAME"

ROLE_ARN=$(aws iam get-role \
  --role-name "$ROLE_NAME" \
  --query "Role.Arn" \
  --output text \
  --profile "$AWS_PROFILE")

jm8_reconcile_bedrock_analysis_policy \
  "$BEDROCK_ANALYSIS_MODEL_ID" \
  ".build/bedrock"

# Grant the API evidence reads independently of ingestion worker permissions.
python3 "$SCRIPT_DIR/jm8_api_semantic_policy.py" apply

echo "Resolving OCR workflow: $OCR_WORKFLOW_NAME"

OCR_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${OCR_WORKFLOW_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if [ -z "$OCR_WORKFLOW_ARN" ] || [ "$OCR_WORKFLOW_ARN" = "None" ]; then
  echo "OCR workflow was not found."
  echo "Run: ./bin/deploy-ocr-workflow"
  exit 1
fi

echo "Resolving historical re-analysis workflow: $HISTORICAL_REANALYSIS_WORKFLOW_NAME"

HISTORICAL_REANALYSIS_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines     --profile "$AWS_PROFILE"     --region "$AWS_REGION"     --query       "stateMachines[?name=='${HISTORICAL_REANALYSIS_WORKFLOW_NAME}'].stateMachineArn | [0]"     --output text
)"

if [ -z "$HISTORICAL_REANALYSIS_WORKFLOW_ARN" ] \
  || [ "$HISTORICAL_REANALYSIS_WORKFLOW_ARN" = "None" ]; then
  echo "Historical re-analysis workflow was not found."
  echo "Run: ./bin/deploy-historical-reanalysis-workflow"
  exit 1
fi

echo "Resolving account export workflow: $ACCOUNT_EXPORT_WORKFLOW_NAME"
ACCOUNT_EXPORT_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "stateMachines[?name=='${ACCOUNT_EXPORT_WORKFLOW_NAME}'].stateMachineArn | [0]" \
    --output text
)"
if [ -z "$ACCOUNT_EXPORT_WORKFLOW_ARN" ] || [ "$ACCOUNT_EXPORT_WORKFLOW_ARN" = "None" ]; then
  echo "Account export workflow was not found."
  echo "Run: ./bin/deploy-account-export"
  exit 1
fi

export OCR_WORKFLOW_ARN
export HISTORICAL_REANALYSIS_WORKFLOW_ARN
export ACCOUNT_EXPORT_WORKFLOW_ARN
./bin/deploy-account-deletion

echo "Resolving account deletion workflow: $ACCOUNT_DELETION_WORKFLOW_NAME"
ACCOUNT_DELETION_WORKFLOW_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "stateMachines[?name=='${ACCOUNT_DELETION_WORKFLOW_NAME}'].stateMachineArn | [0]" \
    --output text
)"
if [ -z "$ACCOUNT_DELETION_WORKFLOW_ARN" ] || [ "$ACCOUNT_DELETION_WORKFLOW_ARN" = "None" ]; then
  echo "Account deletion workflow was not found after reconciliation."
  exit 1
fi

TABLE_ARN="$(
  aws dynamodb describe-table \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query Table.TableArn \
    --output text
)"

if [ -z "$TABLE_ARN" ] || [ "$TABLE_ARN" = "None" ]; then
  echo "DynamoDB table ARN could not be resolved."
  exit 1
fi

python3 - "$TABLE_ARN" \
  > .build/api-batch-write-policy.json <<'PY_POLICY'
import json
import sys

table_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:BatchWriteItem"
            ],
            "Resource": table_arn
        }
    ]
}))
PY_POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_BATCH_WRITE_POLICY_NAME" \
  --policy-document \
    file://.build/api-batch-write-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can batch-delete entry history."

python3 - "$OCR_WORKFLOW_ARN" \
  > .build/api-ocr-workflow-policy.json <<'PY'
import json
import sys

workflow_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "states:StartExecution"
            ],
            "Resource": workflow_arn
        }
    ]
}))
PY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_WORKFLOW_POLICY_NAME" \
  --policy-document file://.build/api-ocr-workflow-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can start the OCR workflow."

python3 - "$HISTORICAL_REANALYSIS_WORKFLOW_ARN"   > .build/api-historical-reanalysis-workflow-policy.json <<'PY_HISTORICAL'
import json
import sys

workflow_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "states:StartExecution"
            ],
            "Resource": workflow_arn
        }
    ]
}))
PY_HISTORICAL

aws iam put-role-policy   --role-name "$ROLE_NAME"   --policy-name     "$API_HISTORICAL_REANALYSIS_WORKFLOW_POLICY_NAME"   --policy-document     file://.build/api-historical-reanalysis-workflow-policy.json   --profile "$AWS_PROFILE"

echo "API role can start the historical re-analysis workflow."

python3 - "$ACCOUNT_EXPORT_WORKFLOW_ARN" "$EXPORT_BUCKET" \
  > .build/api-account-export-policy.json <<'PY_ACCOUNT_EXPORT'
import json
import sys

workflow_arn, bucket = sys.argv[1:]
print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": ["states:StartExecution"],
            "Resource": workflow_arn,
        },
        {
            "Effect": "Allow",
            "Action": ["s3:GetObject"],
            "Resource": f"arn:aws:s3:::{bucket}/exports/*",
        },
    ],
}))
PY_ACCOUNT_EXPORT

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_ACCOUNT_EXPORT_POLICY_NAME" \
  --policy-document file://.build/api-account-export-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can coordinate and download completed account exports."

python3 - "$ACCOUNT_DELETION_WORKFLOW_ARN" \
  > .build/api-account-deletion-policy.json <<'PY_ACCOUNT_DELETION'
import json
import sys
print(json.dumps({"Version":"2012-10-17","Statement":[{
    "Effect":"Allow",
    "Action":["states:StartExecution","states:ListExecutions"],
    "Resource":sys.argv[1],
}]}))
PY_ACCOUNT_DELETION
aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_ACCOUNT_DELETION_POLICY_NAME" \
  --policy-document file://.build/api-account-deletion-policy.json \
  --profile "$AWS_PROFILE"

echo "Verifying Stripe secret reference."

aws secretsmanager describe-secret \
  --secret-id "$STRIPE_SECRET_ARN" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "Stripe secret reference verified."

echo "Verifying Stripe secret payload completeness."
aws secretsmanager get-secret-value \
  --secret-id "$STRIPE_SECRET_ARN" \
  --query SecretString \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  | python3 -c '
# BEGIN STRIPE_DEPLOY_SECRET_VERIFIER
from __future__ import annotations

import json
import re
import sys

payload = json.load(sys.stdin)
if not isinstance(payload, dict):
  raise SystemExit("Stripe secret payload is invalid.")
stage = sys.argv[1]
bootstrap_mode = sys.argv[2]
expected_prefix = "sk_live_" if stage == "prod" else "sk_test_"
if not str(payload.get("STRIPE_SECRET_KEY") or "").startswith(expected_prefix) or not re.fullmatch(r"sk_(test|live)_[A-Za-z0-9_]{8,}", str(payload.get("STRIPE_SECRET_KEY") or "")):
  raise SystemExit("Stripe API secret is invalid.")
if stage == "prod":
  if bootstrap_mode == "pre-webhook":
    if "STRIPE_WEBHOOK_SECRET" in payload:
      raise SystemExit("Bootstrap Stripe secret must not contain a webhook secret.")
  elif not re.fullmatch(r"whsec_[A-Za-z0-9_]{8,}", str(payload.get("STRIPE_WEBHOOK_SECRET") or "")):
    raise SystemExit("Production Stripe webhook secret is missing or invalid.")
# END STRIPE_DEPLOY_SECRET_VERIFIER
' "$STAGE" "${JM8_STRIPE_BOOTSTRAP_MODE:-}"

python3 - "$STRIPE_SECRET_ARN" \
  > .build/api-stripe-secret-policy.json <<'PY_STRIPE_POLICY'
import json
import sys


secret_arn = sys.argv[1]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": secret_arn
        }
    ]
}))
PY_STRIPE_POLICY

aws iam put-role-policy \
  --role-name "$ROLE_NAME" \
  --policy-name "$API_STRIPE_SECRET_POLICY_NAME" \
  --policy-document \
    file://.build/api-stripe-secret-policy.json \
  --profile "$AWS_PROFILE"

echo "API role can retrieve the Stripe secret."

export APP_NAME
export STAGE
export EXPECTED_AWS_ACCOUNT_ID
export TABLE_NAME
export ENTRY_CHUNKS_TABLE_NAME
export RAW_BUCKET
export OCR_WORKFLOW_ARN
export HISTORICAL_REANALYSIS_WORKFLOW_ARN
export ACCOUNT_EXPORT_WORKFLOW_ARN
export ACCOUNT_DELETION_WORKFLOW_ARN
export ACCOUNT_DELETION_RECENT_AUTH_SECONDS="${ACCOUNT_DELETION_RECENT_AUTH_SECONDS:-300}"
export EXPORT_BUCKET
export BEDROCK_ANALYSIS_MODEL_ID
export ANALYSIS_SCHEMA_VERSION
export ANALYSIS_PROMPT_VERSION
export FREE_MONTHLY_ASK_QUESTIONS
export FREE_MONTHLY_ENTRY_ANALYSES
export PRO_MONTHLY_ASK_QUESTIONS
export PRO_MONTHLY_ENTRY_ANALYSES
export STRIPE_SECRET_ARN
export STRIPE_PRO_MONTHLY_PRICE_ID
export STRIPE_CHECKOUT_SUCCESS_URL
export STRIPE_CHECKOUT_CANCEL_URL
export STRIPE_PORTAL_RETURN_URL

python3 \
  > .build/api-environment.json <<'PY_API_ENV'
from __future__ import annotations

import json
import os


environment_keys = [
    "APP_NAME",
    "STAGE",
    "EXPECTED_AWS_ACCOUNT_ID",
    "TABLE_NAME",
    "ENTRY_CHUNKS_TABLE_NAME",
    "RAW_BUCKET",
    "OCR_WORKFLOW_ARN",
    "HISTORICAL_REANALYSIS_WORKFLOW_ARN",
    "ACCOUNT_EXPORT_WORKFLOW_ARN",
    "ACCOUNT_DELETION_WORKFLOW_ARN",
    "ACCOUNT_DELETION_RECENT_AUTH_SECONDS",
    "EXPORT_BUCKET",
    "BEDROCK_ANALYSIS_MODEL_ID",
    "ANALYSIS_SCHEMA_VERSION",
    "ANALYSIS_PROMPT_VERSION",
    "FREE_MONTHLY_ASK_QUESTIONS",
    "FREE_MONTHLY_ENTRY_ANALYSES",
    "PRO_MONTHLY_ASK_QUESTIONS",
    "PRO_MONTHLY_ENTRY_ANALYSES",
    "STRIPE_SECRET_ARN",
    "STRIPE_PRO_MONTHLY_PRICE_ID",
    "STRIPE_CHECKOUT_SUCCESS_URL",
    "STRIPE_CHECKOUT_CANCEL_URL",
    "STRIPE_PORTAL_RETURN_URL",
]

variables = {}

for key in environment_keys:
    value = str(
        os.environ.get(
            key
        )
        or ""
    ).strip()

    if not value:
        raise SystemExit(
            f"{key} is required."
        )

    variables[key] = value

if "STRIPE_SECRET_KEY" in variables:
    raise SystemExit(
        "The plaintext Stripe secret "
        "must not enter Lambda configuration."
    )

print(json.dumps({
    "Variables": variables,
}))
PY_API_ENV

chmod 600 \
  .build/api-environment.json

echo "Lambda environment configuration prepared."

echo "Checking Lambda function: $FUNCTION_NAME"

set +e
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
FUNCTION_EXISTS=$?
set -e

if [ "$FUNCTION_EXISTS" -ne 0 ]; then
  echo "Creating Lambda function: $FUNCTION_NAME"

  aws lambda create-function \
    --function-name "$FUNCTION_NAME" \
    --runtime python3.12 \
    --architectures arm64 \
    --role "$ROLE_ARN" \
    --handler app.lambda_handler \
    --zip-file "fileb://${ZIP_FILE}" \
    --timeout 28 \
    --memory-size 512 \
    --environment file://.build/api-environment.json \
    --tags \
      "{\"App\":\"${APP_NAME}\",\"Stage\":\"${STAGE}\",\"ManagedBy\":\"aws-cli\"}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda function to become active..."
  aws lambda wait function-active-v2 \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  jm8_reconcile_lambda_tags "$FUNCTION_NAME"

  echo "Lambda created."
else
  jm8_reconcile_lambda_tags "$FUNCTION_NAME"

  echo "Updating Lambda code: $FUNCTION_NAME"

  aws lambda update-function-code \
    --function-name "$FUNCTION_NAME" \
    --zip-file "fileb://${ZIP_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda code update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws lambda update-function-configuration \
    --function-name "$FUNCTION_NAME" \
    --timeout 28 \
    --memory-size 512 \
    --environment file://.build/api-environment.json \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Waiting for Lambda configuration update to finish..."
  aws lambda wait function-updated \
    --function-name "$FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  echo "Lambda updated."
fi
echo "Lambda tags reconciled and verified."

echo "Deployed function:"
aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --query "Configuration.{FunctionName:FunctionName,Runtime:Runtime,Handler:Handler,State:State,LastModified:LastModified}" \
  --output table \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

# Reconcile the semantic-memory worker and its event-source mapping in the
# intentionally disabled state. Activation requires a future explicit gate.
./bin/deploy-semantic-memory

# Reconcile the exact tenant-partitioned vector index before embeddings can be
# written. Existing incompatible indexes fail closed and are never replaced.
./bin/deploy-semantic-vector-index

# Reconcile the semantic-embedding worker after semantic-memory infrastructure.
# Its EntryChunks mapping is independently gated and disabled by default.
./bin/deploy-semantic-embedding

# Publish the semantic pipeline efficiency dashboard only after the memory,
# vector-index, and embedding-worker infrastructure has been reconciled.
./bin/deploy-semantic-observability

# Publish the stage-isolated alpha telemetry dashboard and its failure alarm
# only after the application and semantic observability are reconciled.
./bin/deploy-product-telemetry-observability

