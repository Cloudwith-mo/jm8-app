#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
jm8_validate_contract_or_exit

ALERT_EMAIL="${ALERT_EMAIL:-}"

API_FUNCTION_NAME="${APP_NAME}-${STAGE}-api"
WORKER_FUNCTION_NAME="${APP_NAME}-${STAGE}-ocr-worker"
FAILURE_FUNCTION_NAME="${APP_NAME}-${STAGE}-ocr-failure-handler"
HISTORICAL_WORKER_FUNCTION_NAME="${APP_NAME}-${STAGE}-historical-reanalysis-worker"
HISTORICAL_COORDINATOR_FUNCTION_NAME="${APP_NAME}-${STAGE}-historical-reanalysis-coordinator"
STATE_MACHINE_NAME="${APP_NAME}-${STAGE}-ocr-workflow"
HISTORICAL_STATE_MACHINE_NAME="${APP_NAME}-${STAGE}-historical-reanalysis-workflow"

API_LOG_GROUP="/aws/lambda/${API_FUNCTION_NAME}"
WORKER_LOG_GROUP="/aws/lambda/${WORKER_FUNCTION_NAME}"
FAILURE_LOG_GROUP="/aws/lambda/${FAILURE_FUNCTION_NAME}"
HISTORICAL_WORKER_LOG_GROUP="/aws/lambda/${HISTORICAL_WORKER_FUNCTION_NAME}"
HISTORICAL_COORDINATOR_LOG_GROUP="/aws/lambda/${HISTORICAL_COORDINATOR_FUNCTION_NAME}"
ANALYZE_ENTRY_FUNCTION_NAME="${APP_NAME}-${STAGE}-analyze-entry"
ANALYZE_ENTRY_LOG_GROUP="/aws/lambda/${ANALYZE_ENTRY_FUNCTION_NAME}"
API_GATEWAY_NAME="${APP_NAME}-${STAGE}-api"
API_ACCESS_LOG_GROUP="/aws/apigateway/${API_GATEWAY_NAME}"

DASHBOARD_NAME="${APP_NAME}-${STAGE}-operations"
TOPIC_NAME="${APP_NAME}-${STAGE}-alerts"
METRIC_NAMESPACE="JM8/OCR"
REANALYSIS_METRIC_NAMESPACE="JM8/HistoricalReanalysis"
BILLING_METRIC_NAMESPACE="JM8/Billing"

API_ERRORS_ALARM="${APP_NAME}-${STAGE}-api-errors"
API_THROTTLES_ALARM="${APP_NAME}-${STAGE}-api-throttles"
WORKER_THROTTLES_ALARM="${APP_NAME}-${STAGE}-ocr-worker-throttles"
FAILURE_HANDLER_ERRORS_ALARM="${APP_NAME}-${STAGE}-failure-handler-errors"
WORKFLOW_FAILED_ALARM="${APP_NAME}-${STAGE}-workflow-failed"
WORKFLOW_TIMEOUT_ALARM="${APP_NAME}-${STAGE}-workflow-timed-out"
REANALYSIS_START_FAILURES_ALARM="${APP_NAME}-${STAGE}-reanalysis-start-failures"
REANALYSIS_ENTRY_FAILURES_ALARM="${APP_NAME}-${STAGE}-reanalysis-entry-failures"
REANALYSIS_WORKER_ERRORS_ALARM="${APP_NAME}-${STAGE}-reanalysis-worker-errors"
REANALYSIS_WORKER_THROTTLES_ALARM="${APP_NAME}-${STAGE}-reanalysis-worker-throttles"
REANALYSIS_COORDINATOR_ERRORS_ALARM="${APP_NAME}-${STAGE}-reanalysis-coordinator-errors"
REANALYSIS_COORDINATOR_THROTTLES_ALARM="${APP_NAME}-${STAGE}-reanalysis-coordinator-throttles"
REANALYSIS_WORKFLOW_FAILED_ALARM="${APP_NAME}-${STAGE}-reanalysis-workflow-failed"
REANALYSIS_WORKFLOW_TIMEOUT_ALARM="${APP_NAME}-${STAGE}-reanalysis-workflow-timed-out"
BILLING_WEBHOOK_FAILURES_ALARM="${APP_NAME}-${STAGE}-billing-webhook-failures"

mkdir -p .build

echo "Checking AWS identity..."

ACCOUNT_ID="$(
  aws sts get-caller-identity \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query Account \
    --output text
)"

STATE_MACHINE_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${STATE_MACHINE_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if [ -z "$STATE_MACHINE_ARN" ] ||
   [ "$STATE_MACHINE_ARN" = "None" ]; then
  echo "OCR state machine was not found: $STATE_MACHINE_NAME"
  exit 1
fi

HISTORICAL_STATE_MACHINE_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${HISTORICAL_STATE_MACHINE_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if [ -z "$HISTORICAL_STATE_MACHINE_ARN" ] ||
   [ "$HISTORICAL_STATE_MACHINE_ARN" = "None" ]; then
  echo "Historical re-analysis state machine was not found: $HISTORICAL_STATE_MACHINE_NAME"
  exit 1
fi

echo "Creating or resolving SNS alert topic..."

TOPIC_ARN="$(
  aws sns create-topic \
    --name "$TOPIC_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query TopicArn \
    --output text
)"

aws sns get-topic-attributes \
  --topic-arn "$TOPIC_ARN" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --query Attributes.Policy \
  --output text \
  > .build/current-alert-topic-policy.json

python3 - \
  "$TOPIC_ARN" \
  "$ACCOUNT_ID" \
  "$AWS_REGION" \
  "$APP_NAME" \
  "$STAGE" \
  .build/current-alert-topic-policy.json \
  > .build/alert-topic-policy.json <<'PY'
import json
import sys
from pathlib import Path

topic_arn = sys.argv[1]
account_id = sys.argv[2]
region = sys.argv[3]
app_name = sys.argv[4]
stage = sys.argv[5]
current_policy_path = Path(sys.argv[6])

raw_policy = current_policy_path.read_text().strip()

if raw_policy and raw_policy != "None":
    policy = json.loads(raw_policy)
else:
    policy = {
        "Version": "2012-10-17",
        "Statement": [],
    }

statements = policy.get("Statement", [])

if isinstance(statements, dict):
    statements = [statements]

statements = [
    statement
    for statement in statements
    if statement.get("Sid") != "AllowJM8CloudWatchAlarms"
]

statements.append({
    "Sid": "AllowJM8CloudWatchAlarms",
    "Effect": "Allow",
    "Principal": {
        "Service": "cloudwatch.amazonaws.com",
    },
    "Action": "SNS:Publish",
    "Resource": topic_arn,
    "Condition": {
        "ArnLike": {
            "aws:SourceArn": (
                f"arn:aws:cloudwatch:{region}:{account_id}:"
                f"alarm:{app_name}-{stage}-*"
            ),
        },
        "StringEquals": {
            "aws:SourceAccount": account_id,
        },
    },
})

policy["Version"] = "2012-10-17"
policy["Statement"] = statements

print(json.dumps(policy))
PY

aws sns set-topic-attributes \
  --topic-arn "$TOPIC_ARN" \
  --attribute-name Policy \
  --attribute-value "$(cat .build/alert-topic-policy.json)" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

echo "SNS alert topic is ready."

if [ -n "$ALERT_EMAIL" ]; then
  SUBSCRIPTION_COUNT="$(
    aws sns list-subscriptions-by-topic \
      --topic-arn "$TOPIC_ARN" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "length(Subscriptions[?Protocol=='email' && Endpoint=='${ALERT_EMAIL}'])" \
      --output text
  )"

  if [ "$SUBSCRIPTION_COUNT" = "0" ]; then
    aws sns subscribe \
      --topic-arn "$TOPIC_ARN" \
      --protocol email \
      --notification-endpoint "$ALERT_EMAIL" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      >/dev/null

    echo "SNS confirmation email requested."
  else
    echo "SNS email subscription already exists."
  fi
else
  echo "ALERT_EMAIL was not set; email subscription skipped."
fi

echo "Configuring Lambda log groups and retention..."

for LOG_GROUP in \
  "$API_LOG_GROUP" \
  "$WORKER_LOG_GROUP" \
  "$FAILURE_LOG_GROUP" \
  "$HISTORICAL_WORKER_LOG_GROUP" \
  "$HISTORICAL_COORDINATOR_LOG_GROUP" \
  "$ANALYZE_ENTRY_LOG_GROUP" \
  "$API_ACCESS_LOG_GROUP"
do
  LOG_GROUP_EXISTS="$(
    aws logs describe-log-groups \
      --log-group-name-prefix "$LOG_GROUP" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "logGroups[?logGroupName=='${LOG_GROUP}'].logGroupName | [0]" \
      --output text
  )"

  if [ -z "$LOG_GROUP_EXISTS" ] ||
     [ "$LOG_GROUP_EXISTS" = "None" ]; then
    aws logs create-log-group \
      --log-group-name "$LOG_GROUP" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  fi

  aws logs put-retention-policy \
    --log-group-name "$LOG_GROUP" \
    --retention-in-days 30 \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
done

echo "Lambda log retention configured for 30 days."
echo "Historical re-analysis worker and coordinator logs are included."
echo "Analysis Lambda log retention is included."
echo "API Gateway access log retention is included."

echo "Configuring API Gateway access logging and detailed metrics..."

API_ID="$(
  aws apigatewayv2 get-apis \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Items[?Name=='${API_GATEWAY_NAME}'].ApiId | [0]" \
    --output text
)"

if [ -z "$API_ID" ] || [ "$API_ID" = "None" ]; then
  echo "HTTP API was not found: $API_GATEWAY_NAME"
  exit 1
fi

API_ACCESS_LOG_GROUP_ARN="arn:aws:logs:${AWS_REGION}:${ACCOUNT_ID}:log-group:${API_ACCESS_LOG_GROUP}"
API_ACCESS_LOG_POLICY_NAME="${API_GATEWAY_NAME}-access-logs"

python3 - \
  "$API_ACCESS_LOG_GROUP_ARN" \
  "$AWS_REGION" \
  "$ACCOUNT_ID" \
  "$API_ID" \
  > .build/api-access-log-resource-policy.json <<'PY'
import json
import sys

log_group_arn = sys.argv[1]
region = sys.argv[2]
account_id = sys.argv[3]
api_id = sys.argv[4]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowJM8ApiGatewayAccessLogs",
            "Effect": "Allow",
            "Principal": {
                "Service": "apigateway.amazonaws.com",
            },
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
            ],
            "Resource": f"{log_group_arn}:*",
            "Condition": {
                "ArnLike": {
                    "aws:SourceArn": (
                        f"arn:aws:apigateway:{region}::/apis/{api_id}/*"
                    ),
                },
                "StringEquals": {
                    "aws:SourceAccount": account_id,
                },
            },
        }
    ],
}))
PY

aws logs put-resource-policy \
  --policy-name "$API_ACCESS_LOG_POLICY_NAME" \
  --policy-document "$(cat .build/api-access-log-resource-policy.json)" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

python3 - \
  "$API_ACCESS_LOG_GROUP_ARN" \
  > .build/api-access-log-settings.json <<'PY'
import json
import sys

print(json.dumps({
    "DestinationArn": sys.argv[1],
    "Format": json.dumps({
        "requestId": "$context.requestId",
        "routeKey": "$context.routeKey",
        "httpMethod": "$context.httpMethod",
        "status": "$context.status",
        "responseLatency": "$context.responseLatency",
        "integrationLatency": "$context.integrationLatency",
        "integrationError": "$context.integrationErrorMessage",
        "sourceIp": "$context.identity.sourceIp",
    }, separators=(",", ":")),
}))
PY

aws apigatewayv2 update-stage \
  --api-id "$API_ID" \
  --stage-name '$default' \
  --auto-deploy \
  --access-log-settings file://.build/api-access-log-settings.json \
  --default-route-settings DetailedMetricsEnabled=true \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "API Gateway access logging and detailed metrics configured."

echo "Creating OCR metric filters..."

aws logs put-metric-filter \
  --log-group-name "$WORKER_LOG_GROUP" \
  --filter-name "${APP_NAME}-${STAGE}-ocr-completed" \
  --filter-pattern '"ocr_workflow_completed"' \
  --metric-transformations \
    "metricName=OcrCompleted,metricNamespace=${METRIC_NAMESPACE},metricValue=1,defaultValue=0" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

aws logs put-metric-filter \
  --log-group-name "$FAILURE_LOG_GROUP" \
  --filter-name "${APP_NAME}-${STAGE}-ocr-failed" \
  --filter-pattern '"ocr_workflow_failure_recorded"' \
  --metric-transformations \
    "metricName=OcrFailed,metricNamespace=${METRIC_NAMESPACE},metricValue=1,defaultValue=0" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

echo "OCR metric filters created."

put_log_metric() {
  local log_group="$1"
  local filter_name="$2"
  local filter_pattern="$3"
  local namespace="$4"
  local metric_name="$5"
  local metric_value="$6"

  aws logs put-metric-filter \
    --log-group-name "$log_group" \
    --filter-name "$filter_name" \
    --filter-pattern "$filter_pattern" \
    --metric-transformations \
      "metricName=${metric_name},metricNamespace=${namespace},metricValue=${metric_value},defaultValue=0" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
}

echo "Creating historical re-analysis metric filters..."

put_log_metric \
  "$API_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-jobs-accepted" \
  '{ $.event = "historical_reanalysis_accepted" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "JobsAccepted" \
  "1"

put_log_metric \
  "$API_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-retries-accepted" \
  '{ $.event = "historical_reanalysis_retry_accepted" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "RetriesAccepted" \
  "1"

put_log_metric \
  "$API_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-start-failed" \
  '{ $.event = "historical_reanalysis_start_failed" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "StartFailures" \
  "1"

put_log_metric \
  "$API_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-retry-start-failed" \
  '{ $.event = "historical_reanalysis_retry_start_failed" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "StartFailures" \
  "1"

put_log_metric \
  "$HISTORICAL_COORDINATOR_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-jobs-completed" \
  '{ $.event = "historical_reanalysis_job_completed" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "JobsCompleted" \
  "1"

put_log_metric \
  "$HISTORICAL_COORDINATOR_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-workflow-failures" \
  '{ $.event = "historical_reanalysis_workflow_failure_recorded" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "WorkflowFailures" \
  "1"

put_log_metric \
  "$HISTORICAL_COORDINATOR_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-entries-processed" \
  '{ $.event = "historical_reanalysis_page_recorded" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "EntriesProcessed" \
  "$.pageProcessedEntries"

put_log_metric \
  "$HISTORICAL_WORKER_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-entries-completed" \
  '{ $.event = "historical_reanalysis_completed" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "EntriesCompleted" \
  "1"

put_log_metric \
  "$HISTORICAL_WORKER_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-entries-failed" \
  '{ $.event = "historical_reanalysis_failed" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "EntriesFailed" \
  "1"

put_log_metric \
  "$HISTORICAL_WORKER_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-reanalysis-entries-skipped" \
  '{ $.event = "historical_reanalysis_skipped" }' \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "EntriesSkipped" \
  "1"

echo "Historical re-analysis metric filters created."

echo "Creating billing webhook metric filters..."

put_log_metric \
  "$API_LOG_GROUP" \
  "${APP_NAME}-${STAGE}-billing-webhook-failed" \
  '{ $.event = "billing_webhook_failed" }' \
  "$BILLING_METRIC_NAMESPACE" \
  "BillingWebhookFailures" \
  "1"

echo "Billing webhook metric filters created."

put_count_alarm() {
  local alarm_name="$1"
  local description="$2"
  local namespace="$3"
  local metric_name="$4"
  local dimension_name="$5"
  local dimension_value="$6"

  aws cloudwatch put-metric-alarm \
    --alarm-name "$alarm_name" \
    --alarm-description "$description" \
    --namespace "$namespace" \
    --metric-name "$metric_name" \
    --dimensions \
      "Name=${dimension_name},Value=${dimension_value}" \
    --statistic Sum \
    --unit Count \
    --period 300 \
    --evaluation-periods 1 \
    --datapoints-to-alarm 1 \
    --threshold 1 \
    --comparison-operator GreaterThanOrEqualToThreshold \
    --treat-missing-data notBreaching \
    --alarm-actions "$TOPIC_ARN" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
}

put_undimensioned_count_alarm() {
  local alarm_name="$1"
  local description="$2"
  local namespace="$3"
  local metric_name="$4"

  aws cloudwatch put-metric-alarm \
    --alarm-name "$alarm_name" \
    --alarm-description "$description" \
    --namespace "$namespace" \
    --metric-name "$metric_name" \
    --statistic Sum \
    --period 300 \
    --evaluation-periods 1 \
    --datapoints-to-alarm 1 \
    --threshold 1 \
    --comparison-operator GreaterThanOrEqualToThreshold \
    --treat-missing-data notBreaching \
    --alarm-actions "$TOPIC_ARN" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
}

echo "Creating CloudWatch alarms..."

put_count_alarm \
  "$API_ERRORS_ALARM" \
  "JM8 API Lambda reported one or more errors in five minutes." \
  "AWS/Lambda" \
  "Errors" \
  "FunctionName" \
  "$API_FUNCTION_NAME"

put_count_alarm \
  "$API_THROTTLES_ALARM" \
  "JM8 API Lambda was throttled." \
  "AWS/Lambda" \
  "Throttles" \
  "FunctionName" \
  "$API_FUNCTION_NAME"

put_count_alarm \
  "$WORKER_THROTTLES_ALARM" \
  "JM8 OCR worker Lambda was throttled." \
  "AWS/Lambda" \
  "Throttles" \
  "FunctionName" \
  "$WORKER_FUNCTION_NAME"

put_count_alarm \
  "$FAILURE_HANDLER_ERRORS_ALARM" \
  "JM8 OCR failure handler could not record a workflow failure." \
  "AWS/Lambda" \
  "Errors" \
  "FunctionName" \
  "$FAILURE_FUNCTION_NAME"

put_count_alarm \
  "$WORKFLOW_FAILED_ALARM" \
  "JM8 OCR Step Functions execution failed." \
  "AWS/States" \
  "ExecutionsFailed" \
  "StateMachineArn" \
  "$STATE_MACHINE_ARN"

put_count_alarm \
  "$WORKFLOW_TIMEOUT_ALARM" \
  "JM8 OCR Step Functions execution timed out." \
  "AWS/States" \
  "ExecutionsTimedOut" \
  "StateMachineArn" \
  "$STATE_MACHINE_ARN"

echo "Creating historical re-analysis alarms..."

put_undimensioned_count_alarm \
  "$REANALYSIS_START_FAILURES_ALARM" \
  "JM8 historical re-analysis could not start one or more jobs in five minutes." \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "StartFailures"

put_undimensioned_count_alarm \
  "$REANALYSIS_ENTRY_FAILURES_ALARM" \
  "JM8 historical re-analysis reported one or more entry failures in five minutes." \
  "$REANALYSIS_METRIC_NAMESPACE" \
  "EntriesFailed"

put_count_alarm \
  "$REANALYSIS_WORKER_ERRORS_ALARM" \
  "JM8 historical re-analysis worker reported one or more Lambda errors in five minutes." \
  "AWS/Lambda" \
  "Errors" \
  "FunctionName" \
  "$HISTORICAL_WORKER_FUNCTION_NAME"

put_count_alarm \
  "$REANALYSIS_WORKER_THROTTLES_ALARM" \
  "JM8 historical re-analysis worker was throttled." \
  "AWS/Lambda" \
  "Throttles" \
  "FunctionName" \
  "$HISTORICAL_WORKER_FUNCTION_NAME"

put_count_alarm \
  "$REANALYSIS_COORDINATOR_ERRORS_ALARM" \
  "JM8 historical re-analysis coordinator reported one or more Lambda errors in five minutes." \
  "AWS/Lambda" \
  "Errors" \
  "FunctionName" \
  "$HISTORICAL_COORDINATOR_FUNCTION_NAME"

put_count_alarm \
  "$REANALYSIS_COORDINATOR_THROTTLES_ALARM" \
  "JM8 historical re-analysis coordinator was throttled." \
  "AWS/Lambda" \
  "Throttles" \
  "FunctionName" \
  "$HISTORICAL_COORDINATOR_FUNCTION_NAME"

put_count_alarm \
  "$REANALYSIS_WORKFLOW_FAILED_ALARM" \
  "JM8 historical re-analysis Step Functions execution failed." \
  "AWS/States" \
  "ExecutionsFailed" \
  "StateMachineArn" \
  "$HISTORICAL_STATE_MACHINE_ARN"

put_count_alarm \
  "$REANALYSIS_WORKFLOW_TIMEOUT_ALARM" \
  "JM8 historical re-analysis Step Functions execution timed out." \
  "AWS/States" \
  "ExecutionsTimedOut" \
  "StateMachineArn" \
  "$HISTORICAL_STATE_MACHINE_ARN"

echo "Historical re-analysis alarms created."

echo "Creating billing webhook alarms..."

put_undimensioned_count_alarm \
  "$BILLING_WEBHOOK_FAILURES_ALARM" \
  "JM8 billing webhook reported one or more failures in five minutes." \
  "$BILLING_METRIC_NAMESPACE" \
  "BillingWebhookFailures"

echo "Billing webhook alarms created."

echo "CloudWatch alarms created."

python3 - \
  "$AWS_REGION" \
  "$ACCOUNT_ID" \
  "$APP_NAME" \
  "$STAGE" \
  "$API_FUNCTION_NAME" \
  "$WORKER_FUNCTION_NAME" \
  "$FAILURE_FUNCTION_NAME" \
  "$STATE_MACHINE_ARN" \
  "$API_LOG_GROUP" \
  "$WORKER_LOG_GROUP" \
  "$FAILURE_LOG_GROUP" \
  "$METRIC_NAMESPACE" \
  "$HISTORICAL_WORKER_FUNCTION_NAME" \
  "$HISTORICAL_COORDINATOR_FUNCTION_NAME" \
  "$HISTORICAL_STATE_MACHINE_ARN" \
  "$HISTORICAL_WORKER_LOG_GROUP" \
  "$HISTORICAL_COORDINATOR_LOG_GROUP" \
  "$REANALYSIS_METRIC_NAMESPACE" \
  > .build/operations-dashboard.json <<'PY'
import json
import sys

region = sys.argv[1]
account_id = sys.argv[2]
app_name = sys.argv[3]
stage = sys.argv[4]
api_function = sys.argv[5]
worker_function = sys.argv[6]
failure_function = sys.argv[7]
state_machine_arn = sys.argv[8]
api_log_group = sys.argv[9]
worker_log_group = sys.argv[10]
failure_log_group = sys.argv[11]
metric_namespace = sys.argv[12]
historical_worker_function = sys.argv[13]
historical_coordinator_function = sys.argv[14]
