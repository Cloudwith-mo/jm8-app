PY

echo "Deploying CloudWatch dashboard..."

aws cloudwatch put-dashboard \
  --dashboard-name "$DASHBOARD_NAME" \
  --dashboard-body file://.build/operations-dashboard.json \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

echo
echo "JM8 observability deployment complete."
echo "Dashboard: $DASHBOARD_NAME"
echo "SNS topic: $TOPIC_NAME"
echo "Metric namespace: $METRIC_NAMESPACE"

if [ -n "$ALERT_EMAIL" ]; then
  echo "Confirm the Amazon SNS subscription email before testing alerts."
fi
