#!/usr/bin/env bash
set -euo pipefail

: "${AWS_REGION:?AWS_REGION is required}"
: "${AWS_PROFILE:?AWS_PROFILE is required}"
: "${API_NAME:=journalm8-dev-api}"
: "${COGNITO_APP_CLIENT_ID:?COGNITO_APP_CLIENT_ID is required}"
: "${COGNITO_ISSUER:?COGNITO_ISSUER is required}"

AUTHORIZER_NAME="${API_NAME}-jwt-authorizer"
PRODUCTION_API_DEPLOYMENT=false

if [ "${STAGE:-}" = "prod" ] || \
   [ "$AWS_PROFILE" = "jm8-prod" ] || \
   [ "$API_NAME" = "journalm8-prod-api" ]; then
  PRODUCTION_API_DEPLOYMENT=true
fi

echo "Finding API: $API_NAME"

if [ "$PRODUCTION_API_DEPLOYMENT" = true ]; then
  : "${APP_NAME:?APP_NAME is required for production API security.}"
  : "${STAGE:?STAGE is required for production API security.}"
  : "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required for production API security.}"
  if [ "$APP_NAME" != "journalm8" ] || \
     [ "$STAGE" != "prod" ] || \
     [ "$AWS_PROFILE" != "jm8-prod" ] || \
     [ "$API_NAME" != "journalm8-prod-api" ]; then
    echo "Production API environment does not match the resource name." >&2
    exit 1
  fi
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  source "$SCRIPT_DIR/jm8_deployment_guard.sh"
  source "$SCRIPT_DIR/jm8_resource_tags.sh"
  export JM8_OPERATION="secure-api"
  jm8_validate_contract_or_exit
  API_ID="$(jm8_resolve_http_api_id "$API_NAME")"
else
  API_ID="$(
    aws apigatewayv2 get-apis \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query "Items[?Name=='$API_NAME'].ApiId | [0]" \
      --output text
  )"
fi

if [[ "$API_ID" == "None" || -z "$API_ID" ]]; then
  echo "API not found: $API_NAME"
  exit 1
fi

echo "API resolved."

if [ "$PRODUCTION_API_DEPLOYMENT" = true ]; then
  jm8_verify_http_api_tags "$API_ID" "$API_NAME"
  echo "Production HTTP API tags verified."
fi

echo "Checking JWT authorizer: $AUTHORIZER_NAME"

AUTHORIZER_ID="$(
  aws apigatewayv2 get-authorizers \
    --api-id "$API_ID" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Items[?Name=='$AUTHORIZER_NAME'].AuthorizerId | [0]" \
    --output text
)"

if [[ "$AUTHORIZER_ID" == "None" || -z "$AUTHORIZER_ID" ]]; then
  echo "Creating JWT authorizer."

  AUTHORIZER_ID="$(
    aws apigatewayv2 create-authorizer \
      --api-id "$API_ID" \
      --name "$AUTHORIZER_NAME" \
      --authorizer-type JWT \
      --identity-source '$request.header.Authorization' \
      --jwt-configuration "Audience=$COGNITO_APP_CLIENT_ID,Issuer=$COGNITO_ISSUER" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query 'AuthorizerId' \
      --output text
  )"
else
  echo "JWT authorizer already exists."
fi

secure_route() {
  local route_key="$1"

  local route_count
  route_count="$(
    aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
      --api-id "$API_ID" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "length(Items[?RouteKey=='$route_key'])" \
      --output text
  )"

  if [[ "$route_count" -ne 1 ]]; then
    echo \
      "Required route missing or duplicated: $route_key"
    return 1
  fi

  local route_id
  route_id="$(
    aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
      --api-id "$API_ID" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "Items[?RouteKey=='$route_key'].RouteId | [0]" \
      --output text
  )"

  if [[
    -z "$route_id"
    || "$route_id" == "None"
    || "$route_id" == "null"
  ]]; then
    echo "Route identifier was not resolved: $route_key"
    return 1
  fi

  aws apigatewayv2 update-route \
    --api-id "$API_ID" \
    --route-id "$route_id" \
    --authorization-type JWT \
    --authorizer-id "$AUTHORIZER_ID" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  local attempt
  local verified_authorization_type
  local verified_authorizer_id

  for attempt in {1..10}; do
    verified_authorization_type="$(
      aws apigatewayv2 get-route \
        --api-id "$API_ID" \
        --route-id "$route_id" \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION" \
        --query "AuthorizationType" \
        --output text
    )"

    verified_authorizer_id="$(
      aws apigatewayv2 get-route \
        --api-id "$API_ID" \
        --route-id "$route_id" \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION" \
        --query "AuthorizerId" \
        --output text
    )"

    if [[
      "$verified_authorization_type" == "JWT"
      && "$verified_authorizer_id" == "$AUTHORIZER_ID"
    ]]; then
      echo "Verified secured route: $route_key"
      return 0
    fi

    sleep 1
  done

  echo "Route authorization verification failed: $route_key"
  return 1
}

public_route() {
  local route_key="$1"

  local route_count
  route_count="$(
    aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
      --api-id "$API_ID" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "length(Items[?RouteKey=='$route_key'])" \
      --output text
  )"

  if [[ "$route_count" -ne 1 ]]; then
    echo "Required public route missing or duplicated: $route_key"
    return 1
  fi

  local route_id
  route_id="$(
    aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
      --api-id "$API_ID" \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query \
        "Items[?RouteKey=='$route_key'].RouteId | [0]" \
      --output text
  )"

  if [[
    -z "$route_id"
    || "$route_id" == "None"
    || "$route_id" == "null"
  ]]; then
    echo "Public route identifier was not resolved: $route_key"
    return 1
  fi

  aws apigatewayv2 update-route \
    --api-id "$API_ID" \
    --route-id "$route_id" \
    --authorization-type NONE \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  local attempt
  local verified_authorization_type

  for attempt in {1..10}; do
    verified_authorization_type="$(
      aws apigatewayv2 get-route \
        --api-id "$API_ID" \
        --route-id "$route_id" \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION" \
        --query "AuthorizationType" \
        --output text
    )"

    if [[ "$verified_authorization_type" == "NONE" ]]; then
      echo "Verified public route: $route_key"
      return 0
    fi

    sleep 1
  done

  echo "Public route authorization verification failed: $route_key"
  return 1
}

public_route "POST /billing/webhook"

secure_route "POST /entries"
secure_route "GET /entries"
secure_route "GET /usage"
secure_route "GET /account/entitlement"
secure_route "POST /billing/checkout"
secure_route "POST /billing/portal"
secure_route "GET /insights/overview"
secure_route "GET /insights/themes"
secure_route "GET /insights/moods"
secure_route "POST /insights/ask"
secure_route "GET /insights/ask/history"
secure_route "GET /insights/ask/history/{historyId}"
secure_route "DELETE /insights/ask/history/{historyId}"
secure_route "GET /reports/weekly"
secure_route "GET /reports/monthly"
secure_route "GET /analysis/reanalysis/dry-run"
secure_route "POST /analysis/reanalysis/jobs"
secure_route "GET /analysis/reanalysis/jobs"
secure_route "POST /analysis/reanalysis/jobs/{jobId}/retry"
secure_route "GET /analysis/reanalysis/jobs/{jobId}"
secure_route "GET /ocr-jobs"
secure_route "GET /entries/{entryId}"
secure_route "GET /entries/{entryId}/analysis-history"
secure_route "POST /entries/{entryId}/analyze"
secure_route "POST /entries/{entryId}/ocr"
secure_route "POST /entries/{entryId}/ocr/retry"
secure_route "PUT /entries/{entryId}/review"
secure_route "DELETE /entries/{entryId}"
secure_route "POST /upload-url"

echo
echo "API is now protected by Cognito JWT authorizer."
echo "JWT authorizer configuration verified."
