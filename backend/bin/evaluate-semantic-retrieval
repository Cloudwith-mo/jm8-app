#!/usr/bin/env python3
"""Evaluate privacy-safe JM8 semantic-retrieval result aliases."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


BACKEND_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(BACKEND_DIR / "function"))

from semantic_retrieval_evaluation import (  # noqa: E402
    SemanticRetrievalEvaluationError,
    evaluate_semantic_retrieval,
    validate_passing_evaluation_report,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument("input", type=Path)
    parser.add_argument("--output", type=Path)
    return parser


def main() -> int:
    args = _parser().parse_args()
    try:
        document = json.loads(args.input.read_text(encoding="utf-8"))
        report = evaluate_semantic_retrieval(document)
    except (OSError, json.JSONDecodeError, SemanticRetrievalEvaluationError):
        print("Semantic retrieval evaluation input is invalid.", file=sys.stderr)
        return 1

    serialized = json.dumps(report, indent=2, sort_keys=True) + "\n"
    if args.output is not None:
        try:
            args.output.write_text(serialized, encoding="utf-8")
        except OSError:
            print("Semantic retrieval evaluation output could not be written.", file=sys.stderr)
            return 1
    print(serialized, end="")

    try:
        validate_passing_evaluation_report(report)
    except SemanticRetrievalEvaluationError:
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
