#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
source "$SCRIPT_DIR/jm8_resource_tags.sh"
jm8_validate_contract_or_exit
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"

WORKER_FUNCTION_NAME="${APP_NAME}-${STAGE}-ocr-worker"
FAILURE_FUNCTION_NAME="${APP_NAME}-${STAGE}-ocr-failure-handler"
WORKER_ROLE_NAME="${APP_NAME}-${STAGE}-ocr-worker-role"
STATE_MACHINE_NAME="${APP_NAME}-${STAGE}-ocr-workflow"
STATE_ROLE_NAME="${APP_NAME}-${STAGE}-step-functions-role"

ZIP_FILE="dist/function.zip"
DEFINITION_TEMPLATE="infra/ocr-workflow.asl.json"
RESOLVED_DEFINITION=".build/ocr-workflow.resolved.json"

WORKER_POLICY_NAME="${APP_NAME}-${STAGE}-ocr-worker-access"
STATE_POLICY_NAME="${APP_NAME}-${STAGE}-invoke-ocr-worker"
STATE_LOG_GROUP="/aws/vendedlogs/states/${STATE_MACHINE_NAME}"

echo "Checking AWS identity..."

ACCOUNT_ID="$(aws sts get-caller-identity \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --query Account \
  --output text)"

./bin/package

TABLE_ARN="$(
  aws dynamodb describe-table \
    --table-name "$TABLE_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Table.TableArn" \
    --output text
)"

mkdir -p .build

set +e
aws logs describe-log-groups \
  --log-group-name-prefix "$STATE_LOG_GROUP" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  --query "logGroups[?logGroupName=='${STATE_LOG_GROUP}'].logGroupName | [0]" \
  --output text > .build/ocr-log-group-lookup.txt 2> .build/ocr-log-group-lookup.err
LOG_GROUP_LOOKUP_STATUS=$?
set -e

if [ "$LOG_GROUP_LOOKUP_STATUS" -ne 0 ]; then
  echo "CloudWatch log group lookup failed; refusing to create it." >&2
  exit "$LOG_GROUP_LOOKUP_STATUS"
fi

if ! grep -Fxq "$STATE_LOG_GROUP" .build/ocr-log-group-lookup.txt; then
  aws logs create-log-group \
    --log-group-name "$STATE_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
fi

aws logs put-retention-policy \
  --log-group-name "$STATE_LOG_GROUP" \
  --retention-in-days 30 \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

STATE_LOG_GROUP_FIELDS="$(
  aws logs describe-log-groups \
    --log-group-name-prefix "$STATE_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "logGroups[?logGroupName=='${STATE_LOG_GROUP}'] | [0] | {logGroupName:logGroupName,arn:arn,logGroupArn:logGroupArn}" \
    --output json
)"

STATE_LOG_GROUP_BASE_ARN="$(python3 - \
    "$STATE_LOG_GROUP_FIELDS" \
    "$STATE_LOG_GROUP" \
    "$AWS_REGION" \
    "$ACCOUNT_ID" <<'PY_LOG_GROUP'
from __future__ import annotations

import json
import re
import sys

fields = json.loads(sys.argv[1])
expected_name = sys.argv[2]
expected_region = sys.argv[3]
expected_account = sys.argv[4]

if not isinstance(fields, dict) or fields.get("logGroupName") != expected_name:
    raise SystemExit("Expected OCR CloudWatch log group was not resolved.")

raw_arn = fields.get("logGroupArn") or fields.get("arn")
if not isinstance(raw_arn, str) or not raw_arn:
    raise SystemExit("OCR CloudWatch log group ARN was not resolved.")

canonical_arn = raw_arn[:-2] if raw_arn.endswith(":*") else raw_arn
arn_pattern = re.compile(
    r"^arn:(?P<partition>[^:]+):logs:(?P<region>[^:]+):"
    r"(?P<account>[^:]+):log-group:(?P<name>[^:]+)$"
  )
match = arn_pattern.fullmatch(canonical_arn)
if not match:
    raise SystemExit("OCR CloudWatch log group ARN has an invalid format.")
if match.group("region") != expected_region or match.group("account") != expected_account:
    raise SystemExit("OCR CloudWatch log group ARN account or region is incorrect.")
if match.group("name") != expected_name or ":" in match.group("name") or "*" in match.group("name"):
    raise SystemExit("OCR CloudWatch log group ARN name is incorrect.")

print(canonical_arn)
PY_LOG_GROUP
)"

STATE_LOG_GROUP_DESTINATION_ARN="${STATE_LOG_GROUP_BASE_ARN}:*"

cat > .build/lambda-worker-trust.json <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "lambda.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
JSON

python3 - \
  "$TABLE_ARN" \
  "$RAW_BUCKET" \
  > .build/ocr-worker-policy.json <<'PY'
import json
import sys

table_arn = sys.argv[1]
raw_bucket = sys.argv[2]

policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "JournalEntryAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:Query",
                "dynamodb:UpdateItem"
            ],
            "Resource": [
                table_arn,
                f"{table_arn}/index/*"
            ]
        },
        {
            "Sid": "ReadPrivateJournalImages",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                f"arn:aws:s3:::{raw_bucket}/users/*"
            ]
        },
        {
            "Sid": "RunTextract",
            "Effect": "Allow",
            "Action": [
                "textract:DetectDocumentText"
            ],
            "Resource": "*"
        }
    ]
}

print(json.dumps(policy))
PY

echo "Checking OCR worker IAM role: $WORKER_ROLE_NAME"

if aws iam get-role \
  --role-name "$WORKER_ROLE_NAME" \
  --profile "$AWS_PROFILE" \
  >/dev/null 2>&1
then
  echo "OCR worker role already exists."

  aws iam update-assume-role-policy \
    --role-name "$WORKER_ROLE_NAME" \
    --policy-document file://.build/lambda-worker-trust.json \
    --profile "$AWS_PROFILE"
else
  aws iam create-role \
    --role-name "$WORKER_ROLE_NAME" \
    --description "JournalM8 OCR worker Lambda role" \
    --assume-role-policy-document file://.build/lambda-worker-trust.json \
    --profile "$AWS_PROFILE" \
    >/dev/null

  echo "Created OCR worker role."
  sleep 10
fi

aws iam attach-role-policy \
  --role-name "$WORKER_ROLE_NAME" \
  --policy-arn "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" \
  --profile "$AWS_PROFILE"

aws iam put-role-policy \
  --role-name "$WORKER_ROLE_NAME" \
  --policy-name "$WORKER_POLICY_NAME" \
  --policy-document file://.build/ocr-worker-policy.json \
  --profile "$AWS_PROFILE"

WORKER_ROLE_ARN="$(
  aws iam get-role \
    --role-name "$WORKER_ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --query "Role.Arn" \
    --output text
)"

echo "Checking OCR worker Lambda: $WORKER_FUNCTION_NAME"

if aws lambda get-function \
  --function-name "$WORKER_FUNCTION_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
then
  jm8_reconcile_lambda_tags "$WORKER_FUNCTION_NAME"

  echo "Updating OCR worker code."

  aws lambda update-function-code \
    --function-name "$WORKER_FUNCTION_NAME" \
    --zip-file "fileb://${ZIP_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-updated \
    --function-name "$WORKER_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws lambda update-function-configuration \
    --function-name "$WORKER_FUNCTION_NAME" \
    --role "$WORKER_ROLE_ARN" \
    --handler ocr_worker.lambda_handler \
    --timeout 60 \
    --memory-size 512 \
    --environment \
      "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-updated \
    --function-name "$WORKER_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
else
  echo "Creating OCR worker Lambda."

  aws lambda create-function \
    --function-name "$WORKER_FUNCTION_NAME" \
    --runtime python3.12 \
    --architectures arm64 \
    --role "$WORKER_ROLE_ARN" \
    --handler ocr_worker.lambda_handler \
    --zip-file "fileb://${ZIP_FILE}" \
    --timeout 60 \
    --memory-size 512 \
    --environment \
      "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --tags \
      "App=${APP_NAME},Stage=${STAGE},ManagedBy=aws-cli" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-active-v2 \
    --function-name "$WORKER_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  jm8_reconcile_lambda_tags "$WORKER_FUNCTION_NAME"
fi

WORKER_ARN="$(
  aws lambda get-function \
    --function-name "$WORKER_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Configuration.FunctionArn" \
    --output text
)"

echo "Checking OCR failure handler Lambda: $FAILURE_FUNCTION_NAME"

if aws lambda get-function \
  --function-name "$FAILURE_FUNCTION_NAME" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
then
  jm8_reconcile_lambda_tags "$FAILURE_FUNCTION_NAME"

  echo "Updating OCR failure handler code."

  aws lambda update-function-code \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --zip-file "fileb://${ZIP_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-updated \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  aws lambda update-function-configuration \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --role "$WORKER_ROLE_ARN" \
    --handler ocr_failure_handler.lambda_handler \
    --timeout 30 \
    --memory-size 256 \
    --environment \
      "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-updated \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
else
  echo "Creating OCR failure handler Lambda."

  aws lambda create-function \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --runtime python3.12 \
    --architectures arm64 \
    --role "$WORKER_ROLE_ARN" \
    --handler ocr_failure_handler.lambda_handler \
    --zip-file "fileb://${ZIP_FILE}" \
    --timeout 30 \
    --memory-size 256 \
    --environment \
      "Variables={APP_NAME=${APP_NAME},STAGE=${STAGE},TABLE_NAME=${TABLE_NAME},RAW_BUCKET=${RAW_BUCKET}}" \
    --tags \
      "App=${APP_NAME},Stage=${STAGE},ManagedBy=aws-cli" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  aws lambda wait function-active-v2 \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"

  jm8_reconcile_lambda_tags "$FAILURE_FUNCTION_NAME"
fi

FAILURE_HANDLER_ARN="$(
  aws lambda get-function \
    --function-name "$FAILURE_FUNCTION_NAME" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query "Configuration.FunctionArn" \
    --output text
)"

python3 - \
  "$DEFINITION_TEMPLATE" \
  "$RESOLVED_DEFINITION" \
  "$WORKER_ARN" \
  "$FAILURE_HANDLER_ARN" <<'PY'
from pathlib import Path
import sys

template_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
worker_arn = sys.argv[3]
failure_handler_arn = sys.argv[4]

definition = template_path.read_text()

if "__OCR_WORKER_ARN__" not in definition:
    raise SystemExit("Worker ARN placeholder was not found.")

definition = definition.replace(
    "__OCR_WORKER_ARN__",
    worker_arn,
)

if "__OCR_FAILURE_HANDLER_ARN__" not in definition:
    raise SystemExit(
        "Failure handler ARN placeholder was not found."
    )

definition = definition.replace(
    "__OCR_FAILURE_HANDLER_ARN__",
    failure_handler_arn,
)

output_path.write_text(definition)
print(f"Resolved workflow definition: {output_path}")
PY

cat > .build/step-functions-trust.json <<'JSON'
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "states.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
JSON

python3 - "$WORKER_ARN" "$FAILURE_HANDLER_ARN" \
  > .build/step-functions-policy.json <<'PY'
import json
import sys

worker_arn = sys.argv[1]
failure_handler_arn = sys.argv[2]

policy = {
    "Version": "2012-10-17",
    "Statement": [
        {
          "Sid": "StepFunctionsLogDelivery",
            "Effect": "Allow",
          # CloudWatch Logs delivery APIs do not support resource-level
          # authorization, so AWS requires Resource "*" for this statement.
            "Action": [
                "lambda:InvokeFunction"
            ],
            "Resource": [
                worker_arn,
                failure_handler_arn
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogDelivery",
                "logs:GetLogDelivery",
                "logs:UpdateLogDelivery",
                "logs:DeleteLogDelivery",
                "logs:ListLogDeliveries",
                "logs:PutResourcePolicy",
                "logs:DescribeResourcePolicies",
                "logs:DescribeLogGroups"
              ],
              "Resource": "*"
            },
            {
              "Sid": "StepFunctionsTracing",
              "Effect": "Allow",
              "Action": [
                "xray:PutTraceSegments",
                "xray:PutTelemetryRecords",
                "xray:GetSamplingRules",
                "xray:GetSamplingTargets"
            ],
            "Resource": "*"
        }
    ]
}

print(json.dumps(policy))
PY

echo "Checking Step Functions IAM role: $STATE_ROLE_NAME"

set +e
aws iam get-role \
  --role-name "$STATE_ROLE_NAME" \
  --profile "$AWS_PROFILE" \
  >/dev/null 2> .build/step-functions-role-lookup.err
STATE_ROLE_LOOKUP_STATUS=$?
set -e

if [ "$STATE_ROLE_LOOKUP_STATUS" -eq 0 ]; then
  echo "Step Functions role already exists."

  aws iam update-assume-role-policy \
    --role-name "$STATE_ROLE_NAME" \
    --policy-document file://.build/step-functions-trust.json \
    --profile "$AWS_PROFILE"
elif grep -q "NoSuchEntity" .build/step-functions-role-lookup.err; then
  aws iam create-role \
    --role-name "$STATE_ROLE_NAME" \
    --description "JournalM8 Step Functions execution role" \
    --assume-role-policy-document file://.build/step-functions-trust.json \
    --profile "$AWS_PROFILE" \
    >/dev/null

  echo "Created Step Functions role."
  sleep 10
else
  echo "Step Functions role lookup failed; refusing to create it." >&2
  exit "$STATE_ROLE_LOOKUP_STATUS"
fi

aws iam put-role-policy \
  --role-name "$STATE_ROLE_NAME" \
  --policy-name "$STATE_POLICY_NAME" \
  --policy-document file://.build/step-functions-policy.json \
  --profile "$AWS_PROFILE"

aws iam get-role-policy \
  --role-name "$STATE_ROLE_NAME" \
  --policy-name "$STATE_POLICY_NAME" \
  --profile "$AWS_PROFILE" \
  >/dev/null

STATE_ROLE_ARN="$(
  aws iam get-role \
    --role-name "$STATE_ROLE_NAME" \
    --profile "$AWS_PROFILE" \
    --query "Role.Arn" \
    --output text
)"

STATE_MACHINE_ARN="$(
  aws stepfunctions list-state-machines \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "stateMachines[?name=='${STATE_MACHINE_NAME}'].stateMachineArn | [0]" \
    --output text
)"

if [ -z "$STATE_MACHINE_ARN" ] || [ "$STATE_MACHINE_ARN" = "None" ]; then
  echo "Creating state machine: $STATE_MACHINE_NAME"

  STATE_MACHINE_ARN="$(
    aws stepfunctions create-state-machine \
      --name "$STATE_MACHINE_NAME" \
      --definition "file://${RESOLVED_DEFINITION}" \
      --role-arn "$STATE_ROLE_ARN" \
      --type STANDARD \
      --logging-configuration \
        "level=ERROR,includeExecutionData=false,destinations=[{cloudWatchLogsLogGroup={logGroupArn=${STATE_LOG_GROUP_DESTINATION_ARN}}}]" \
      --tracing-configuration enabled=true \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION" \
      --query "stateMachineArn" \
      --output text
  )"

  echo "State machine created."
else
  echo "Updating state machine: $STATE_MACHINE_NAME"

  aws stepfunctions update-state-machine \
    --state-machine-arn "$STATE_MACHINE_ARN" \
    --definition "file://${RESOLVED_DEFINITION}" \
    --role-arn "$STATE_ROLE_ARN" \
    --logging-configuration \
      "level=ERROR,includeExecutionData=false,destinations=[{cloudWatchLogsLogGroup={logGroupArn=${STATE_LOG_GROUP_DESTINATION_ARN}}}]" \
    --tracing-configuration enabled=true \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "State machine updated."
fi

STATE_MACHINE_DESCRIPTION="$({
    aws stepfunctions describe-state-machine \
    --state-machine-arn "$STATE_MACHINE_ARN" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --output json
})"

python3 - "$STATE_MACHINE_DESCRIPTION" "$STATE_ROLE_ARN" "$STATE_LOG_GROUP_DESTINATION_ARN" <<'PY_VERIFY'
from __future__ import annotations

import json
import sys

description = json.loads(sys.argv[1])
if description.get("status") != "ACTIVE":
    raise SystemExit("OCR state machine is not ACTIVE.")
if description.get("roleArn") != sys.argv[2]:
    raise SystemExit("OCR state machine role ARN is incorrect.")
logging = description.get("loggingConfiguration") or {}
if logging.get("level") != "ERROR" or logging.get("includeExecutionData") is not False:
    raise SystemExit("OCR state machine logging configuration is incorrect.")
destinations = logging.get("destinations") or []
if len(destinations) != 1:
    raise SystemExit("OCR state machine logging destination is incorrect.")
actual = ((destinations[0].get("cloudWatchLogsLogGroup") or {}).get("logGroupArn"))
if actual != sys.argv[3]:
    raise SystemExit("OCR state machine logging destination ARN is incorrect.")
PY_VERIFY

echo
echo "OCR workflow ready."
echo "Worker Lambda: $WORKER_FUNCTION_NAME"
echo "Worker ARN: $WORKER_ARN"
echo "Failure handler Lambda: $FAILURE_FUNCTION_NAME"
echo "Failure handler ARN: $FAILURE_HANDLER_ARN"
echo "State machine: $STATE_MACHINE_NAME"
echo "State machine ARN: $STATE_MACHINE_ARN"
