#!/usr/bin/env bash
set -euo pipefail

: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"
: "${TABLE_NAME:?TABLE_NAME is required. Run: source .env}"
: "${RAW_BUCKET:?RAW_BUCKET is required. Run: source .env}"
: "${DEPLOY_CONFIRMATION:?DEPLOY_CONFIRMATION is required for staging. Run: source .env}"
: "${FRONTEND_BUCKET:?FRONTEND_BUCKET is required. Run: source .env}"
: "${STAGING_BASIC_AUTH_USERNAME:?STAGING_BASIC_AUTH_USERNAME is required. Run: source .env}"
: "${STAGING_BASIC_AUTH_PASSWORD:?STAGING_BASIC_AUTH_PASSWORD is required. Run: source .env}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
TEMPLATE_PATH="$SCRIPT_DIR/../infra/cloudfront/frontend-hosting.yaml"
DIAGNOSTICS_DIR="$REPO_ROOT/backend/.build/diagnostics"
DIAGNOSTIC_TIMESTAMP="$(date -u '+%Y%m%dT%H%M%SZ')"
DIAGNOSTIC_PATH="$DIAGNOSTICS_DIR/frontend-hosting-${STAGE}-${DIAGNOSTIC_TIMESTAMP}.json"
DIAGNOSTICS_HELPER="$SCRIPT_DIR/jm8_frontend_hosting_diagnostics.py"
STACK_NAME="${APP_NAME}-${STAGE}-frontend-hosting"
TEMP_DIR="$(mktemp -d)"
PRE_STATUS=""
POST_STATUS=""
LOCAL_TEMPLATE_CHECKSUM=""
DEPLOYED_TEMPLATE_CHECKSUM=""
VERIFICATION_PHASE="initialization"
FINAL_CODE="IN_PROGRESS"
STACK_JSON="$TEMP_DIR/stack.json"
RESOURCE_JSON="$TEMP_DIR/resources.json"
EVENTS_JSON="$TEMP_DIR/events.json"

sha256_hex() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
  else log_error "neither shasum nor sha256sum is available"; return 1; fi
}
timestamp() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
log_info() { printf '%s INFO %s\n' "$(timestamp)" "$*"; }
log_warn() { printf '%s WARN %s\n' "$(timestamp)" "$*" >&2; }
log_error() { printf '%s ERROR %s\n' "$(timestamp)" "$*" >&2; }
log_aws_error() { if [[ -s "$1" ]]; then python3 "$DIAGNOSTICS_HELPER" sanitize-error "$1" >&2; fi; }
cleanup() { rm -rf "$TEMP_DIR"; }
trap cleanup EXIT

write_report() {
  python3 "$DIAGNOSTICS_HELPER" write-report "$DIAGNOSTIC_PATH" \
    --operation create-frontend-hosting --stage "$STAGE" --stack-name "$STACK_NAME" \
    --template-path "$TEMPLATE_PATH" --local-checksum "$LOCAL_TEMPLATE_CHECKSUM" \
    --deployed-checksum "$DEPLOYED_TEMPLATE_CHECKSUM" --pre-status "$PRE_STATUS" \
    --post-status "$POST_STATUS" --phase "$VERIFICATION_PHASE" --final-code "$FINAL_CODE" \
    --stack-json "$STACK_JSON" --resource-json "$RESOURCE_JSON" >/dev/null
}

fail() {
  FINAL_CODE="$1"
  log_error "$2"
  if [[ "$1" == OUTPUT_OriginAccessControlId* ]]; then
    log_warn "OriginAccessControlId output validation failed; correlating physical resource."
    set +e
    aws cloudformation list-stack-resources --stack-name "$STACK_NAME" --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$RESOURCE_JSON" 2>/dev/null
    RESOURCE_STATUS=$?
    set -e
    if [[ "$RESOURCE_STATUS" -eq 0 ]]; then
      RESOURCE_SUMMARY="$(python3 "$DIAGNOSTICS_HELPER" resource-check "$RESOURCE_JSON")"
      log_warn "Physical OAC: $(printf '%s' "$RESOURCE_SUMMARY" | python3 -c 'import json,sys; print(json.load(sys.stdin))')"
      PHYSICAL_ID="$(printf '%s' "$RESOURCE_SUMMARY" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("PhysicalResourceId") or "<absent>")')"
      if [[ "$PHYSICAL_ID" == "<absent>" ]]; then log_error "Remediation: FrontendOriginAccessControl is absent; do not substitute a physical ID."; else log_error "Remediation: FrontendOriginAccessControl exists with physical ID $PHYSICAL_ID, but the required stack output is absent or invalid; do not substitute it."; fi
    else
      log_warn "Physical OAC correlation was unavailable; the output contract remains fail-closed."
    fi
  fi
  set +e
  aws cloudformation describe-stack-events --stack-name "$STACK_NAME" --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$EVENTS_JSON" 2>/dev/null
  EVENTS_STATUS=$?
  set -e
  if [[ "$EVENTS_STATUS" -eq 0 ]]; then
    log_warn "Recent relevant CloudFormation events:"
    python3 "$DIAGNOSTICS_HELPER" events "$EVENTS_JSON" | python3 -c 'import json,sys; [print("  {Timestamp} {LogicalResourceId} {ResourceType} {ResourceStatus} {ResourceStatusReason}".format(**e)) for e in json.load(sys.stdin)]'
  fi
  write_report
  log_error "Sanitized diagnostic report: $DIAGNOSTIC_PATH"
  exit 1
}

require_output() {
  # require_output "OriginAccessControlId" is intentionally fail-closed.
  local output_name="$1" output_status="$2" output_reason="$3" output_value="$4"
  case "$output_value" in
    ""|None|null) output_reason="empty value" ;;
  esac
  [[ "$output_status" == "PRESENT" ]] || fail "OUTPUT_${output_name}_${output_reason}" "CloudFormation output $output_name failed validation: $output_reason; output_keys=${OUTPUT_KEYS:-<unavailable>}."
}

if [[ "$STAGE" != "staging" ]]; then fail "INVALID_STAGE" "create-frontend-hosting is staging-only."; fi
if [[ "$FRONTEND_BUCKET" != "$APP_NAME-$STAGE-frontend-$EXPECTED_AWS_ACCOUNT_ID" ]]; then fail "INVALID_FRONTEND_BUCKET" "FRONTEND_BUCKET does not match the staging contract."; fi
if [[ "$FRONTEND_BUCKET" == "$RAW_BUCKET" ]]; then fail "FRONTEND_RAW_BUCKET_COLLISION" "FRONTEND_BUCKET must be distinct from RAW_BUCKET."; fi

source "$SCRIPT_DIR/jm8_deployment_guard.sh"
export JM8_OPERATION="create-frontend-hosting"
log_info "Environment contract validation started"
if ! jm8_validate_contract_or_exit; then fail "ENVIRONMENT_CONTRACT_INVALID" "Environment contract validation failed."; fi
log_info "Environment contract validation completed"

log_info "Local template preflight started: $(cd "$(dirname "$TEMPLATE_PATH")" && pwd)/$(basename "$TEMPLATE_PATH")"
LOCAL_TEMPLATE_CHECKSUM="$(sha256_hex < "$TEMPLATE_PATH")"
LOCAL_TEMPLATE_RESULT="$(python3 "$DIAGNOSTICS_HELPER" template-check "$TEMPLATE_PATH")"
LOCAL_HAS_OUTPUTS="$(printf '%s' "$LOCAL_TEMPLATE_RESULT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["has_outputs"])')"
LOCAL_HAS_OAC_OUTPUT="$(printf '%s' "$LOCAL_TEMPLATE_RESULT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["has_origin_output"])')"
LOCAL_TEMPLATE_CODE="$(printf '%s' "$LOCAL_TEMPLATE_RESULT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["code"])')"
if [[ "$LOCAL_HAS_OUTPUTS" != "True" || "$LOCAL_HAS_OAC_OUTPUT" != "True" ]]; then fail "LOCAL_TEMPLATE_OUTPUT_MISSING" "Local template output contract is missing; local_checksum=$LOCAL_TEMPLATE_CHECKSUM"; fi
if [[ "$LOCAL_TEMPLATE_CODE" != "OK" ]]; then fail "LOCAL_TEMPLATE_OUTPUT_INVALID" "Local template OriginAccessControlId intrinsic is invalid; local_checksum=$LOCAL_TEMPLATE_CHECKSUM"; fi
log_info "Local template preflight completed; checksum=$LOCAL_TEMPLATE_CHECKSUM"

set +x
AUTH_HEADER="$(printf '%s:%s' "$STAGING_BASIC_AUTH_USERNAME" "$STAGING_BASIC_AUTH_PASSWORD" | base64)"
AUTH_DIGEST="$(printf '%s' "Basic ${AUTH_HEADER}" | sha256_hex)"
unset AUTH_HEADER

PRE_EXISTS="false"
PRE_ERROR="$TEMP_DIR/pre-error"
set +e
aws cloudformation describe-stacks --stack-name "$STACK_NAME" --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$TEMP_DIR/pre-stack.json" 2>"$PRE_ERROR"
PRE_DESCRIBE_STATUS=$?
set -e
if [[ "$PRE_DESCRIBE_STATUS" -eq 0 ]]; then
  PRE_EXISTS="true"
  PRE_STATUS="$(python3 "$DIAGNOSTICS_HELPER" stack-check "$TEMP_DIR/pre-stack.json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])')"
  log_info "Stack existed before deployment; pre-deployment status=$PRE_STATUS"
  set +e
  aws cloudformation get-template --stack-name "$STACK_NAME" --template-stage Original --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$TEMP_DIR/pre-template.json" 2>/dev/null
  PRE_TEMPLATE_STATUS=$?
  set -e
  if [[ "$PRE_TEMPLATE_STATUS" -eq 0 ]]; then log_info "Pre-deployment template checksum=$(sha256_hex < "$TEMP_DIR/pre-template.json")"; else log_warn "Pre-deployment template checksum unavailable"; fi
else
  if grep -q 'ValidationError' "$PRE_ERROR" && grep -qi 'does not exist' "$PRE_ERROR"; then log_info "Stack did not exist before deployment"; else log_aws_error "$PRE_ERROR"; fail "PRE_DEPLOYMENT_STACK_LOOKUP_FAILED" "Unable to determine whether the stack existed before deployment."; fi
fi

log_info "CloudFormation deploy started; stack=$STACK_NAME existed_before=$PRE_EXISTS"
set +e
aws cloudformation deploy --stack-name "$STACK_NAME" --template-file "$TEMPLATE_PATH" --capabilities CAPABILITY_NAMED_IAM \
  --parameter-overrides "AppName=$APP_NAME" "Stage=$STAGE" "FrontendBucketName=$FRONTEND_BUCKET" "AuthorizationDigest=$AUTH_DIGEST" \
  --profile "$AWS_PROFILE" --region "$AWS_REGION" >"$TEMP_DIR/deploy-output" 2>"$TEMP_DIR/deploy-error"
DEPLOY_STATUS=$?
set -e
log_info "CloudFormation deploy completed; exit_status=$DEPLOY_STATUS"
if [[ "$DEPLOY_STATUS" -ne 0 ]]; then log_aws_error "$TEMP_DIR/deploy-error"; fail "CLOUDFORMATION_DEPLOY_FAILED" "CloudFormation deployment failed; sanitized diagnostics follow."; fi

aws cloudformation describe-stacks --stack-name "$STACK_NAME" --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$STACK_JSON" 2>"$TEMP_DIR/stack-error" || { log_aws_error "$TEMP_DIR/stack-error"; fail "POST_DEPLOYMENT_STACK_LOOKUP_FAILED" "Unable to read the deployed stack."; }
STACK_SUMMARY="$(python3 "$DIAGNOSTICS_HELPER" stack-check "$STACK_JSON")"
POST_STATUS="$(printf '%s' "$STACK_SUMMARY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])')"
POST_TIMESTAMP="$(printf '%s' "$STACK_SUMMARY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["last_updated"] or "")')"
log_info "Resulting stack status=$POST_STATUS last_updated=$POST_TIMESTAMP"
case "$POST_STATUS" in CREATE_COMPLETE|UPDATE_COMPLETE) ;; *) fail "STACK_NOT_STABLE" "CloudFormation stack did not reach a stable completed state: $POST_STATUS" ;; esac

log_info "Deployed-template verification started"
aws cloudformation get-template --stack-name "$STACK_NAME" --template-stage Original --profile "$AWS_PROFILE" --region "$AWS_REGION" --output json >"$TEMP_DIR/deployed-template.json" 2>"$TEMP_DIR/deployed-template-error" || { log_aws_error "$TEMP_DIR/deployed-template-error"; fail "DEPLOYED_TEMPLATE_UNAVAILABLE" "Unable to retrieve the deployed CloudFormation template."; }
DEPLOYED_TEMPLATE_CHECKSUM="$(sha256_hex < "$TEMP_DIR/deployed-template.json")"
TEMPLATE_RESULT="$(python3 "$DIAGNOSTICS_HELPER" template-check "$TEMP_DIR/deployed-template.json")"
TEMPLATE_CODE="$(printf '%s' "$TEMPLATE_RESULT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["code"])')"
[[ "$TEMPLATE_CODE" == "OK" ]] || fail "$TEMPLATE_CODE" "Deployed template verification failed: $TEMPLATE_CODE; local_checksum=$LOCAL_TEMPLATE_CHECKSUM deployed_checksum=$DEPLOYED_TEMPLATE_CHECKSUM"
log_info "Deployed-template verification completed; checksum=$DEPLOYED_TEMPLATE_CHECKSUM"

log_info "Output validation started"
OUTPUT_KEYS="$(printf '%s' "$STACK_SUMMARY" | python3 -c 'import json,sys; print(", ".join(json.load(sys.stdin)["output_keys"]))')"
log_info "CloudFormation output keys: $OUTPUT_KEYS"
OUTPUT_JSON="$(printf '%s' "$STACK_SUMMARY" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin)["outputs"]))')"
for OUTPUT_NAME in FrontendBucketName FrontendBucketRegionalDomainName DistributionId DistributionDomainName FrontendOrigin OriginAccessControlId; do
  OUTPUT_STATUS="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]]["status"])' "$OUTPUT_NAME")"
  OUTPUT_REASON="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]]["reason"])' "$OUTPUT_NAME")"
  OUTPUT_VALUE="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]].get("value") or "<missing>")' "$OUTPUT_NAME")"
  log_info "Output $OUTPUT_NAME: $OUTPUT_STATUS ($OUTPUT_REASON) value=$OUTPUT_VALUE"
  require_output "$OUTPUT_NAME" "$OUTPUT_STATUS" "$OUTPUT_REASON" "$OUTPUT_VALUE"
done
BUCKET_NAME="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["FrontendBucketName"]["value"])')"
DISTRIBUTION_ID="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["DistributionId"]["value"])')"
DISTRIBUTION_DOMAIN="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["DistributionDomainName"]["value"])')"
FRONTEND_BUCKET_REGIONAL_DOMAIN="$(printf '%s' "$OUTPUT_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["FrontendBucketRegionalDomainName"]["value"])')"
if [[ "$BUCKET_NAME" != "$FRONTEND_BUCKET" ]]; then fail "FRONTEND_BUCKET_OUTPUT_MISMATCH" "CloudFormation frontend bucket output does not match FRONTEND_BUCKET."; fi
if [[ "$DISTRIBUTION_DOMAIN" != *.cloudfront.net ]]; then fail "INVALID_DISTRIBUTION_DOMAIN" "Distribution domain must end exactly in .cloudfront.net."; fi
log_info "Output validation completed"

log_info "S3 verification started"
read -r BLOCK_PUBLIC_ACLS IGNORE_PUBLIC_ACLS BLOCK_PUBLIC_POLICY RESTRICT_PUBLIC_BUCKETS <<< "$(aws s3api get-public-access-block --bucket "$BUCKET_NAME" --query '[PublicAccessBlockConfiguration.BlockPublicAcls, PublicAccessBlockConfiguration.IgnorePublicAcls, PublicAccessBlockConfiguration.BlockPublicPolicy, PublicAccessBlockConfiguration.RestrictPublicBuckets]' --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
if [[ "$BLOCK_PUBLIC_ACLS" != "True" || "$IGNORE_PUBLIC_ACLS" != "True" || "$BLOCK_PUBLIC_POLICY" != "True" || "$RESTRICT_PUBLIC_BUCKETS" != "True" ]]; then fail "S3_PUBLIC_ACCESS_BLOCK_INVALID" "Frontend bucket Public Access Block is not fully enabled."; fi
ENCRYPTION_ALGORITHM="$(aws s3api get-bucket-encryption --bucket "$BUCKET_NAME" --query 'ServerSideEncryptionConfiguration.Rules[0].ApplyServerSideEncryptionByDefault.SSEAlgorithm' --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
if [[ "$ENCRYPTION_ALGORITHM" != "AES256" ]]; then fail "S3_ENCRYPTION_INVALID" "Frontend bucket encryption must use AES256."; fi
OBJECT_OWNERSHIP="$(aws s3api get-bucket-ownership-controls --bucket "$BUCKET_NAME" --query 'OwnershipControls.Rules[0].ObjectOwnership' --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
if [[ "$OBJECT_OWNERSHIP" != "BucketOwnerEnforced" ]]; then fail "S3_OWNERSHIP_INVALID" "Frontend bucket ownership must be BucketOwnerEnforced."; fi
VERSIONING_STATUS="$(aws s3api get-bucket-versioning --bucket "$BUCKET_NAME" --query Status --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
if [[ "$VERSIONING_STATUS" != "Enabled" ]]; then fail "S3_VERSIONING_INVALID" "Frontend bucket versioning must be Enabled."; fi
log_info "S3 verification completed"

WEBSITE_ERROR_FILE="$TEMP_DIR/website-error"
set +e
aws s3api get-bucket-website --bucket "$BUCKET_NAME" --profile "$AWS_PROFILE" --region "$AWS_REGION" > /dev/null 2>"$WEBSITE_ERROR_FILE"
WEBSITE_STATUS=$?
set -e
if [[ "$WEBSITE_STATUS" -eq 0 ]]; then fail "S3_WEBSITE_ENABLED" "Frontend bucket must not be configured for website hosting."; fi
if ! grep -q "NoSuchWebsiteConfiguration" "$WEBSITE_ERROR_FILE"; then cat "$WEBSITE_ERROR_FILE" >&2; fail "S3_WEBSITE_CHECK_FAILED" "Unable to verify that website hosting is disabled."; fi

log_info "CloudFront/OAC verification started"
DISTRIBUTION_STATUS="$(aws cloudfront get-distribution --id "$DISTRIBUTION_ID" --query Distribution.Status --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
[[ "$DISTRIBUTION_STATUS" == Deployed ]] || fail "CLOUDFRONT_NOT_DEPLOYED" "CloudFront distribution is not Deployed."
DISTRIBUTION_CONFIG="$(aws cloudfront get-distribution --id "$DISTRIBUTION_ID" --output json --profile "$AWS_PROFILE" --region "$AWS_REGION")"
printf '%s' "$DISTRIBUTION_CONFIG" >"$TEMP_DIR/distribution.json"
python3 - "$TEMP_DIR/distribution.json" <<'PY'
import json, sys
# Required postconditions: Distribution.Status, Distribution.DistributionConfig.Enabled,
# DefaultRootObject, ViewerProtocolPolicy, CachePolicyId, viewer-request, ERROR_CODE.
d = json.load(open(sys.argv[1]))["Distribution"]["DistributionConfig"]
assert d.get("Enabled") is True and d.get("DefaultRootObject") == "index.html"
assert d["DefaultCacheBehavior"].get("ViewerProtocolPolicy") == "redirect-to-https"
assert d["DefaultCacheBehavior"].get("CachePolicyId") == "658327ea-f89d-4fab-a63d-7e88639e58f6"
assert sum(1 for x in d["DefaultCacheBehavior"].get("FunctionAssociations", {}).get("Items", []) if x.get("EventType") == "viewer-request") == 1
PY
for ERROR_CODE in 403 404; do
  python3 - "$TEMP_DIR/distribution.json" "$ERROR_CODE" <<'PY'
import json, sys
items = json.load(open(sys.argv[1]))["Distribution"]["DistributionConfig"].get("CustomErrorResponses", {}).get("Items", [])
assert sum(1 for x in items if str(x.get("ErrorCode")) == sys.argv[2] and x.get("ResponseCode") == 200 and x.get("ResponsePagePath") == "/index.html") == 1
PY
done
ORIGIN_MATCH_COUNT="$(python3 - "$TEMP_DIR/distribution.json" "$FRONTEND_BUCKET_REGIONAL_DOMAIN" <<'PY'
import json, sys
d=json.load(open(sys.argv[1]))["Distribution"]["DistributionConfig"]["Origins"].get("Items", [])
print(sum(1 for x in d if x.get("DomainName") == sys.argv[2]))
PY
)"
[[ "$ORIGIN_MATCH_COUNT" == 1 ]] || fail "CLOUDFRONT_ORIGIN_MISMATCH" "Exactly one CloudFront origin must match the frontend bucket regional domain."
ORIGIN_OAC_ID="$(python3 - "$TEMP_DIR/distribution.json" "$FRONTEND_BUCKET_REGIONAL_DOMAIN" <<'PY'
import json, sys
d=json.load(open(sys.argv[1]))["Distribution"]["DistributionConfig"]["Origins"]["Items"]
print(next(x.get("OriginAccessControlId", "") for x in d if x.get("DomainName") == sys.argv[2]))
PY
)"
[[ "$ORIGIN_OAC_ID" =~ ^[A-Za-z0-9_-]{3,64}$ ]] || fail "CLOUDFRONT_OAC_ID_INVALID" "Attached CloudFront OAC ID is malformed."
read -r OAC_ORIGIN_TYPE OAC_SIGNING_BEHAVIOR OAC_SIGNING_PROTOCOL <<< "$(aws cloudfront get-origin-access-control --id "$ORIGIN_OAC_ID" --query '[OriginAccessControl.OriginAccessControlConfig.OriginAccessControlOriginType, OriginAccessControl.OriginAccessControlConfig.SigningBehavior, OriginAccessControl.OriginAccessControlConfig.SigningProtocol]' --output text --profile "$AWS_PROFILE" --region "$AWS_REGION")"
[[ "$OAC_ORIGIN_TYPE" == s3 && "$OAC_SIGNING_BEHAVIOR" == always && "$OAC_SIGNING_PROTOCOL" == sigv4 ]] || fail "CLOUDFRONT_OAC_CONFIG_INVALID" "Attached CloudFront OAC configuration is invalid."
log_info "CloudFront/OAC verification completed"
FINAL_CODE="SUCCESS"
VERIFICATION_PHASE="completed"
write_report
printf '%s\n%s\n%s\n%s\n%s\n' "$STACK_NAME" "$BUCKET_NAME" "$DISTRIBUTION_ID" "$DISTRIBUTION_DOMAIN" "https://${DISTRIBUTION_DOMAIN}"
