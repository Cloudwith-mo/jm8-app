#!/usr/bin/env bash
set -euo pipefail

: "${AWS_PROFILE:?AWS_PROFILE is required.}"
: "${AWS_REGION:?AWS_REGION is required.}"
: "${APP_NAME:?APP_NAME is required.}"
: "${STAGE:?STAGE is required.}"
: "${STRIPE_SECRET_KEY:?A Stripe test secret key is required.}"

if [[ "$STRIPE_SECRET_KEY" != sk_test_* ]]; then
  echo "Only a Stripe test-mode secret key is allowed."
  exit 1
fi

SECRET_NAME="${APP_NAME}/${STAGE}/stripe"
WORK_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$WORK_DIR"
}

trap cleanup EXIT

SECRET_PAYLOAD_FILE="$WORK_DIR/stripe-secret.json"
DESCRIBE_ERROR_FILE="$WORK_DIR/describe-secret.err"

python3 - "$SECRET_PAYLOAD_FILE" <<'PY'
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


output_path = Path(
    sys.argv[1]
)

secret_key = str(
    os.environ.get(
        "STRIPE_SECRET_KEY"
    )
    or ""
).strip()

if not secret_key.startswith(
    "sk_test_"
):
    raise SystemExit(
        "Only a Stripe test-mode "
        "secret key is permitted."
    )

output_path.write_text(
    json.dumps({
        "STRIPE_SECRET_KEY":
            secret_key,
    })
)

output_path.chmod(
    0o600
)
PY

set +e

SECRET_ARN="$(
  aws secretsmanager describe-secret \
    --secret-id "$SECRET_NAME" \
    --query ARN \
    --output text \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    2>"$DESCRIBE_ERROR_FILE"
)"

DESCRIBE_STATUS=$?

set -e

SECRET_CREATED="False"
SECRET_UPDATED="False"

if [[ "$DESCRIBE_STATUS" -eq 0 ]]; then
  if [[ -z "$SECRET_ARN" || "$SECRET_ARN" == "None" ]]; then
    echo "The Stripe secret reference could not be resolved."
    exit 1
  fi

  aws secretsmanager put-secret-value \
    --secret-id "$SECRET_ARN" \
    --secret-string "file://${SECRET_PAYLOAD_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  SECRET_UPDATED="True"

else
  if ! grep -q \
    "ResourceNotFoundException" \
    "$DESCRIBE_ERROR_FILE"; then

    echo "The Stripe secret could not be inspected."
    exit 1
  fi

  SECRET_ARN="$(
    aws secretsmanager create-secret \
      --name "$SECRET_NAME" \
      --description \
        "JM8 Stripe test-mode API credential" \
      --secret-string \
        "file://${SECRET_PAYLOAD_FILE}" \
      --tags \
        "Key=App,Value=${APP_NAME}" \
        "Key=Stage,Value=${STAGE}" \
        "Key=ManagedBy,Value=aws-cli" \
      --query ARN \
      --output text \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  )"

  SECRET_CREATED="True"
fi

if [[ -z "$SECRET_ARN" || "$SECRET_ARN" == "None" ]]; then
  echo "The Stripe secret could not be provisioned."
  exit 1
fi

python3 - "$SECRET_ARN" <<'PY'
from __future__ import annotations

import os
import shlex
import sys
import tempfile
from pathlib import Path


environment_path = Path(
    ".env"
)

secret_arn = str(
    sys.argv[1]
).strip()

if not secret_arn:
    raise SystemExit(
        "The Stripe secret ARN is missing."
    )

key = "STRIPE_SECRET_ARN"

existing_lines = []

if environment_path.exists():
    existing_lines = (
        environment_path
        .read_text()
        .splitlines()
    )

replacement = (
    key
    + "="
    + shlex.quote(
        secret_arn
    )
)

updated_lines = []
replaced = False

for line in existing_lines:
    if line.startswith(
        key + "="
    ):
        if not replaced:
            updated_lines.append(
                replacement
            )

            replaced = True

        continue

    updated_lines.append(
        line
    )

if not replaced:
    updated_lines.append(
        replacement
    )

rendered = (
    "\n".join(
        updated_lines
    ).rstrip()
    + "\n"
)

environment_path.parent.mkdir(
    parents=True,
    exist_ok=True,
)

with tempfile.NamedTemporaryFile(
    mode="w",
    encoding="utf-8",
    dir=environment_path.parent,
    prefix=".env.",
    delete=False,
) as temporary:
    temporary.write(
        rendered
    )

    temporary_path = Path(
        temporary.name
    )

os.chmod(
    temporary_path,
    0o600,
)

os.replace(
    temporary_path,
    environment_path,
)

os.chmod(
    environment_path,
    0o600,
)
PY

echo "stripeModeIsTest: True"
echo "secretReady: True"
echo "secretCreated: ${SECRET_CREATED}"
echo "secretUpdated: ${SECRET_UPDATED}"
echo "localEnvironmentUpdated: True"
