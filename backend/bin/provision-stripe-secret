#!/usr/bin/env bash
set -euo pipefail
umask 077

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required.}"
: "${AWS_REGION:?AWS_REGION is required.}"
: "${APP_NAME:?APP_NAME is required.}"
: "${STAGE:?STAGE is required.}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required.}"
: "${STRIPE_SECRET_KEY:?A Stripe secret key is required.}"

# Validate contract before proceeding with any AWS operations
export JM8_OPERATION="provision-stripe-secret"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
jm8_validate_contract_or_exit

case "$STAGE" in
    dev|staging|prod) ;;
    *) echo "Invalid STAGE: use dev, staging, or prod." >&2; exit 1 ;;
esac

STRIPE_WEBHOOK_SECRET="${STRIPE_WEBHOOK_SECRET:-}"
STRIPE_ENV_FILE="$SCRIPT_DIR/../infra/environments/generated/${STAGE}.stripe.env"

SECRET_NAME="${APP_NAME}/${STAGE}/stripe"
WORK_DIR="$(mktemp -d)"

cleanup() {
  rm -rf "$WORK_DIR"
}

trap cleanup EXIT

SECRET_PAYLOAD_FILE="$WORK_DIR/stripe-secret.json"
EXISTING_SECRET_FILE="$WORK_DIR/existing-stripe-secret.json"
DESCRIBE_ERROR_FILE="$WORK_DIR/describe-secret.err"
SECRET_VALUE_ERROR_FILE="$WORK_DIR/get-secret-value.err"

python3 - "$SECRET_PAYLOAD_FILE" <<'PY'
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path


output_path = Path(
    sys.argv[1]
)

secret_key = str(
    os.environ.get(
        "STRIPE_SECRET_KEY"
    )
    or ""
).strip()

stage = str(
    os.environ.get(
        "STAGE"
    )
    or ""
).strip()

expected_prefix_by_stage = {
    "dev": "sk_test_",
    "staging": "sk_test_",
    "prod": "sk_live_",
}

expected_prefix = (
    expected_prefix_by_stage.get(
        stage
    )
)

if expected_prefix is None:
    raise SystemExit(
        "Invalid STAGE for Stripe "
        "secret provisioning."
    )

if not secret_key.startswith(
    expected_prefix
):
    raise SystemExit(
        "Stripe secret key mode "
        "does not match STAGE."
    )

webhook_secret = str(
    os.environ.get("STRIPE_WEBHOOK_SECRET") or ""
).strip()

if webhook_secret and not re.fullmatch(r"whsec_[A-Za-z0-9_]{8,}", webhook_secret):
    raise SystemExit("Stripe webhook secret format is invalid.")

output_path.write_text(
    json.dumps({
        "STRIPE_SECRET_KEY":
            secret_key,
        **({"STRIPE_WEBHOOK_SECRET": webhook_secret} if webhook_secret else {}),
    })
)

output_path.chmod(
    0o600
)
PY

set +e

SECRET_ARN="$(
  aws secretsmanager describe-secret \
    --secret-id "$SECRET_NAME" \
    --query ARN \
    --output text \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    2>"$DESCRIBE_ERROR_FILE"
)"

DESCRIBE_STATUS=$?

set -e

SECRET_CREATED="False"
SECRET_UPDATED="False"

if [[ "$DESCRIBE_STATUS" -eq 0 ]]; then
  if [[ -z "$SECRET_ARN" || "$SECRET_ARN" == "None" ]]; then
    echo "The Stripe secret reference could not be resolved."
    exit 1
  fi

    aws secretsmanager get-secret-value \
        --secret-id "$SECRET_ARN" \
        --query SecretString \
        --output text \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION" \
        >"$EXISTING_SECRET_FILE" \
        2>"$SECRET_VALUE_ERROR_FILE"

    python3 - "$SECRET_PAYLOAD_FILE" "$EXISTING_SECRET_FILE" <<'PY_MERGE'
import json
import re
import sys
from pathlib import Path

payload_path = Path(sys.argv[1])
existing_path = Path(sys.argv[2])
payload = json.loads(payload_path.read_text())
existing = json.loads(existing_path.read_text())
if not isinstance(existing, dict):
        raise SystemExit("Existing Stripe secret payload is invalid.")
existing_webhook = str(existing.get("STRIPE_WEBHOOK_SECRET") or "").strip()
if existing_webhook and not re.fullmatch(r"whsec_[A-Za-z0-9_]{8,}", existing_webhook):
        raise SystemExit("Existing Stripe webhook secret is invalid.")
if existing_webhook and "STRIPE_WEBHOOK_SECRET" not in payload:
        payload["STRIPE_WEBHOOK_SECRET"] = existing_webhook
payload_path.write_text(json.dumps(payload))
PY_MERGE

    aws secretsmanager put-secret-value \
    --secret-id "$SECRET_ARN" \
    --secret-string "file://${SECRET_PAYLOAD_FILE}" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  SECRET_UPDATED="True"

else
    if ! grep -q \
    "ResourceNotFoundException" \
    "$DESCRIBE_ERROR_FILE"; then

    echo "The Stripe secret could not be inspected."
    exit 1
  fi

  SECRET_ARN="$(
    aws secretsmanager create-secret \
      --name "$SECRET_NAME" \
      --description \
                    "JM8 Stripe API credential" \
      --secret-string \
        "file://${SECRET_PAYLOAD_FILE}" \
      --tags \
        "Key=App,Value=${APP_NAME}" \
        "Key=Stage,Value=${STAGE}" \
        "Key=ManagedBy,Value=aws-cli" \
      --query ARN \
      --output text \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  )"

  SECRET_CREATED="True"
fi

python3 - "$SECRET_PAYLOAD_FILE" <<'PY_VALIDATE_PAYLOAD'
import json
import os
import re
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text())
if not isinstance(payload, dict):
    raise SystemExit("Stripe secret payload is invalid.")
if not re.fullmatch(r"sk_(test|live)_[A-Za-z0-9_]{8,}", str(payload.get("STRIPE_SECRET_KEY") or "")):
    raise SystemExit("Stripe API secret is invalid.")
if os.environ.get("STAGE") == "prod" and not re.fullmatch(r"whsec_[A-Za-z0-9_]{8,}", str(payload.get("STRIPE_WEBHOOK_SECRET") or "")):
    raise SystemExit("Production requires STRIPE_WEBHOOK_SECRET.")
PY_VALIDATE_PAYLOAD

if [[ -z "$SECRET_ARN" || "$SECRET_ARN" == "None" ]]; then
  echo "The Stripe secret could not be provisioned."
  exit 1
fi

python3 - "$SECRET_ARN" "$STRIPE_ENV_FILE" <<'PY'
from __future__ import annotations

import os
import shlex
import sys
import tempfile
from pathlib import Path


secret_arn = str(
    sys.argv[1]
).strip()

if not secret_arn:
    raise SystemExit(
        "The Stripe secret ARN is missing."
    )

key = "STRIPE_SECRET_ARN"
environment_path = Path(sys.argv[2]).resolve()
environment_path.parent.mkdir(parents=True, exist_ok=True)
rendered = f"export {key}={shlex.quote(secret_arn)}\n"

with tempfile.NamedTemporaryFile(
    mode="w",
    encoding="utf-8",
    dir=environment_path.parent,
    prefix=".stripe.env.",
    delete=False,
) as temporary:
    temporary.write(
        rendered
    )

    temporary_path = Path(
        temporary.name
    )

os.chmod(
    temporary_path,
    0o600,
)

try:
    os.replace(temporary_path, environment_path)
finally:
    if temporary_path.exists():
        temporary_path.unlink()

os.chmod(
    environment_path,
    0o600,
)
PY

echo "stripeModeIsTest: True"
echo "secretReady: True"
echo "secretCreated: ${SECRET_CREATED}"
echo "secretUpdated: ${SECRET_UPDATED}"
echo "generatedConfigPath: $STRIPE_ENV_FILE"
