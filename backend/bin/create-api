#!/usr/bin/env bash
set -euo pipefail

# === Environment Contract Validation ===
: "${AWS_PROFILE:?AWS_PROFILE is required. Run: source .env}"
: "${AWS_REGION:?AWS_REGION is required. Run: source .env}"
: "${APP_NAME:?APP_NAME is required. Run: source .env}"
: "${STAGE:?STAGE is required. Run: source .env}"
: "${EXPECTED_AWS_ACCOUNT_ID:?EXPECTED_AWS_ACCOUNT_ID is required. Run: source .env}"
: "${ACCOUNT_ID:?ACCOUNT_ID is required. Run: source .env}"
: "${API_NAME:?API_NAME is required. Run: source .env}"
: "${ALLOWED_ORIGINS:?ALLOWED_ORIGINS is required. Run: source .env}"

# Validate contract before proceeding with any AWS operations
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/jm8_deployment_guard.sh"
export JM8_OPERATION="create-api"
jm8_validate_contract_or_exit

ALLOWED_ORIGINS_JSON="$(python3 "$SCRIPT_DIR/jm8_environment_contract.py" allowed-origins-json)"

CORS_CONFIGURATION="$(python3 - "$ALLOWED_ORIGINS_JSON" <<'PY'
import json
import sys

allowed_origins = json.loads(sys.argv[1])
print(json.dumps({
  "AllowOrigins": allowed_origins,
  "AllowMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
  "AllowHeaders": ["content-type", "x-user-id", "authorization"],
  "MaxAge": 300,
}))
PY
)"

FUNCTION_NAME="${APP_NAME}-${STAGE}-api"

FUNCTION_ARN=$(aws lambda get-function \
  --function-name "$FUNCTION_NAME" \
  --query "Configuration.FunctionArn" \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")

echo "Checking API Gateway HTTP API: $API_NAME"

API_ID=$(aws apigatewayv2 get-apis \
  --query "Items[?Name=='${API_NAME}'].ApiId | [0]" \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")

if [ "$API_ID" = "None" ] || [ -z "$API_ID" ]; then
  API_ID=$(aws apigatewayv2 create-api \
    --name "$API_NAME" \
    --protocol-type HTTP \
    --cors-configuration "$CORS_CONFIGURATION" \
    --query "ApiId" \
    --output text \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION")

  echo "Created API: $API_ID"
else
  echo "API already exists: $API_ID"
fi

aws apigatewayv2 update-api   --api-id "$API_ID"   --cors-configuration "$CORS_CONFIGURATION"   --profile "$AWS_PROFILE"   --region "$AWS_REGION"   >/dev/null

echo "API CORS configuration updated."

echo "Checking Lambda integration."

INTEGRATION_ID=$(aws apigatewayv2 get-integrations \
  --api-id "$API_ID" \
  --query "Items[?IntegrationUri=='${FUNCTION_ARN}'].IntegrationId | [0]" \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")

if [ "$INTEGRATION_ID" = "None" ] || [ -z "$INTEGRATION_ID" ]; then
  INTEGRATION_ID=$(aws apigatewayv2 create-integration \
    --api-id "$API_ID" \
    --integration-type AWS_PROXY \
    --integration-uri "$FUNCTION_ARN" \
    --payload-format-version "2.0" \
    --timeout-in-millis 30000 \
    --query "IntegrationId" \
    --output text \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION")

  echo "Created integration: $INTEGRATION_ID"
else
  echo "Integration already exists: $INTEGRATION_ID"
fi

aws apigatewayv2 update-integration \
  --api-id "$API_ID" \
  --integration-id "$INTEGRATION_ID" \
  --timeout-in-millis 30000 \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "Integration timeout configured for 30 seconds."

create_route_if_missing () {
  local ROUTE_KEY="$1"
  local TARGET="integrations/${INTEGRATION_ID}"

  local ROUTE_COUNT
  ROUTE_COUNT="$(
    aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
      --api-id "$API_ID" \
      --query \
        "length(Items[?RouteKey=='${ROUTE_KEY}'])" \
      --output text \
      --profile "$AWS_PROFILE" \
      --region "$AWS_REGION"
  )"

  if [[ "$ROUTE_COUNT" -gt 1 ]]; then
    echo "Duplicate route detected: $ROUTE_KEY"
    return 1
  fi

  local ROUTE_ID

  if [[ "$ROUTE_COUNT" -eq 0 ]]; then
    ROUTE_ID="$(
      aws apigatewayv2 create-route \
        --api-id "$API_ID" \
        --route-key "$ROUTE_KEY" \
        --target "$TARGET" \
        --query "RouteId" \
        --output text \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION"
    )"

    echo "Created route: $ROUTE_KEY"

  else
    ROUTE_ID="$(
      aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
        --api-id "$API_ID" \
        --query \
          "Items[?RouteKey=='${ROUTE_KEY}'].RouteId | [0]" \
        --output text \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION"
    )"

    echo "Reusing route: $ROUTE_KEY"
  fi

  if [[
    -z "$ROUTE_ID"
    || "$ROUTE_ID" == "None"
    || "$ROUTE_ID" == "null"
  ]]; then
    echo "Route identifier was not resolved: $ROUTE_KEY"
    return 1
  fi

  aws apigatewayv2 update-route \
    --api-id "$API_ID" \
    --route-id "$ROUTE_ID" \
    --target "$TARGET" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  local ATTEMPT
  local VERIFIED_COUNT
  local VERIFIED_TARGET

  for ATTEMPT in {1..10}; do
    VERIFIED_COUNT="$(
      aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
        --api-id "$API_ID" \
        --query \
          "length(Items[?RouteKey=='${ROUTE_KEY}'])" \
        --output text \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION"
    )"

    VERIFIED_TARGET="$(
      aws apigatewayv2 get-routes \
      --no-paginate \
      --max-results 500 \
        --api-id "$API_ID" \
        --query \
          "Items[?RouteKey=='${ROUTE_KEY}'].Target | [0]" \
        --output text \
        --profile "$AWS_PROFILE" \
        --region "$AWS_REGION"
    )"

    if [[
      "$VERIFIED_COUNT" == "1"
      && "$VERIFIED_TARGET" == "$TARGET"
    ]]; then
      echo "Verified route: $ROUTE_KEY"
      return 0
    fi

    sleep 1
  done

  echo "Route verification failed: $ROUTE_KEY"
  return 1
}

create_route_if_missing "POST /entries"
create_route_if_missing "GET /entries"
create_route_if_missing "GET /usage"
create_route_if_missing "GET /account/entitlement"
create_route_if_missing "POST /billing/checkout"
create_route_if_missing "POST /billing/portal"
create_route_if_missing "POST /billing/webhook"
create_route_if_missing "GET /insights/overview"
create_route_if_missing "GET /insights/themes"
create_route_if_missing "GET /insights/moods"
create_route_if_missing "POST /insights/ask"
create_route_if_missing "GET /insights/ask/history"
create_route_if_missing "GET /insights/ask/history/{historyId}"
create_route_if_missing "DELETE /insights/ask/history/{historyId}"
create_route_if_missing "GET /reports/weekly"
create_route_if_missing "GET /reports/monthly"
create_route_if_missing "GET /analysis/reanalysis/dry-run"
create_route_if_missing "POST /analysis/reanalysis/jobs"
create_route_if_missing "GET /analysis/reanalysis/jobs"
create_route_if_missing "POST /analysis/reanalysis/jobs/{jobId}/retry"
create_route_if_missing "GET /analysis/reanalysis/jobs/{jobId}"
create_route_if_missing "GET /ocr-jobs"
create_route_if_missing "GET /entries/{entryId}"
create_route_if_missing "GET /entries/{entryId}/analysis-history"
create_route_if_missing "POST /entries/{entryId}/analyze"
create_route_if_missing "POST /entries/{entryId}/ocr"
create_route_if_missing "POST /entries/{entryId}/ocr/retry"
create_route_if_missing "PUT /entries/{entryId}/review"
create_route_if_missing "DELETE /entries/{entryId}"
create_route_if_missing "POST /upload-url"

echo "Checking default stage."

STAGE_ID=$(aws apigatewayv2 get-stages \
  --api-id "$API_ID" \
  --query "Items[?StageName=='\$default'].StageName | [0]" \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")

if [ "$STAGE_ID" = "None" ] || [ -z "$STAGE_ID" ]; then
  aws apigatewayv2 create-stage \
    --api-id "$API_ID" \
    --stage-name '$default' \
    --auto-deploy \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    >/dev/null

  echo "Created default stage."
else
  echo "Default stage already exists."
fi

ACCESS_LOG_GROUP="/aws/apigateway/${API_NAME}"
ACCESS_LOG_GROUP_ARN="arn:aws:logs:${AWS_REGION}:${ACCOUNT_ID}:log-group:${ACCESS_LOG_GROUP}"
ACCESS_LOG_POLICY_NAME="${API_NAME}-access-logs"

mkdir -p .build

echo "Configuring API Gateway access logs and detailed metrics."

ACCESS_LOG_GROUP_EXISTS="$(
  aws logs describe-log-groups \
    --log-group-name-prefix "$ACCESS_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION" \
    --query \
      "logGroups[?logGroupName=='${ACCESS_LOG_GROUP}'].logGroupName | [0]" \
    --output text
)"

if [ -z "$ACCESS_LOG_GROUP_EXISTS" ] ||
   [ "$ACCESS_LOG_GROUP_EXISTS" = "None" ]; then
  aws logs create-log-group \
    --log-group-name "$ACCESS_LOG_GROUP" \
    --profile "$AWS_PROFILE" \
    --region "$AWS_REGION"
fi

aws logs put-retention-policy \
  --log-group-name "$ACCESS_LOG_GROUP" \
  --retention-in-days 30 \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION"

python3 - \
  "$ACCESS_LOG_GROUP_ARN" \
  "$AWS_REGION" \
  "$ACCOUNT_ID" \
  "$API_ID" \
  "$ACCESS_LOG_POLICY_NAME" \
  > .build/api-access-log-resource-policy.json <<'PY'
import json
import sys

log_group_arn = sys.argv[1]
region = sys.argv[2]
account_id = sys.argv[3]
api_id = sys.argv[4]

print(json.dumps({
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowJM8ApiGatewayAccessLogs",
            "Effect": "Allow",
            "Principal": {
                "Service": "apigateway.amazonaws.com",
            },
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents",
            ],
            "Resource": f"{log_group_arn}:*",
            "Condition": {
                "ArnLike": {
                    "aws:SourceArn": (
                        f"arn:aws:apigateway:{region}::/apis/{api_id}/*"
                    ),
                },
                "StringEquals": {
                    "aws:SourceAccount": account_id,
                },
            },
        }
    ],
}))
PY

aws logs put-resource-policy \
  --policy-name "$ACCESS_LOG_POLICY_NAME" \
  --policy-document "$(cat .build/api-access-log-resource-policy.json)" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

python3 - \
  "$ACCESS_LOG_GROUP_ARN" \
  > .build/api-access-log-settings.json <<'PY'
import json
import sys

print(json.dumps({
    "DestinationArn": sys.argv[1],
    "Format": json.dumps({
        "requestId": "$context.requestId",
        "routeKey": "$context.routeKey",
        "httpMethod": "$context.httpMethod",
        "status": "$context.status",
        "responseLatency": "$context.responseLatency",
        "integrationLatency": "$context.integrationLatency",
        "integrationError": "$context.integrationErrorMessage",
        "sourceIp": "$context.identity.sourceIp",
    }, separators=(",", ":")),
}))
PY

aws apigatewayv2 update-stage \
  --api-id "$API_ID" \
  --stage-name '$default' \
  --auto-deploy \
  --access-log-settings file://.build/api-access-log-settings.json \
  --default-route-settings DetailedMetricsEnabled=true \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null

echo "API Gateway access logging and detailed metrics configured."

echo "Adding Lambda permission for API Gateway."

SOURCE_ARN="arn:aws:execute-api:${AWS_REGION}:${ACCOUNT_ID}:${API_ID}/*/*"

set +e
aws lambda add-permission \
  --function-name "$FUNCTION_NAME" \
  --statement-id "${API_NAME}-invoke-permission" \
  --action lambda:InvokeFunction \
  --principal apigateway.amazonaws.com \
  --source-arn "$SOURCE_ARN" \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION" \
  >/dev/null 2>&1
PERMISSION_RESULT=$?
set -e

if [ "$PERMISSION_RESULT" -eq 0 ]; then
  echo "Lambda permission added."
else
  echo "Lambda permission may already exist. Continuing."
fi

API_ENDPOINT=$(aws apigatewayv2 get-api \
  --api-id "$API_ID" \
  --query "ApiEndpoint" \
  --output text \
  --profile "$AWS_PROFILE" \
  --region "$AWS_REGION")

echo ""
echo "API ready:"
echo "$API_ENDPOINT"
echo ""
echo "Save it:"
echo "export API_ENDPOINT=$API_ENDPOINT"
