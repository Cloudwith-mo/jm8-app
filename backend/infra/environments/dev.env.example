# JM8 Development Environment Configuration
# Copy this file to backend/.env and fill in actual values
# WARNING: Never commit secrets to git. backend/.env should be in .gitignore

# === Core Configuration (Required) ===
export APP_NAME=journalm8
export STAGE=dev
export AWS_PROFILE=jm8-dev
export AWS_REGION=us-east-1

# === AWS Account Validation (Required) ===
# EXPECTED_AWS_ACCOUNT_ID must match the actual account ID for jm8-dev profile
# Fetch with: aws sts get-caller-identity --profile jm8-dev --query Account --output text
export EXPECTED_AWS_ACCOUNT_ID=114743615542

# === Derived Resource Names (Auto-Populated, Do Not Change) ===
# These are computed from APP_NAME, STAGE, and actual AWS account ID
# Deployment scripts will validate these match expected patterns
export TABLE_NAME=journalm8-dev-main
export RAW_BUCKET=journalm8-dev-raw-114743615542
export EXPORT_BUCKET=journalm8-dev-exports-114743615542
export FRONTEND_BUCKET=journalm8-dev-frontend-114743615542
export CLOUDFRONT_DISTRIBUTION_ID=REPLACE_AFTER_FRONTEND_HOSTING_PROVISION
export FRONTEND_ORIGIN=https://REPLACE_AFTER_FRONTEND_HOSTING_PROVISION.cloudfront.net

# === API Configuration (Required) ===
# API_ENDPOINT is populated by create-api after infrastructure is provisioned
# For initial development, can be http://localhost:3000 for local testing
export API_ENDPOINT=https://a1b2c3d4e5.execute-api.us-east-1.amazonaws.com
export ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Bedrock Configuration ===
export BEDROCK_ANALYSIS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
export ANALYSIS_SCHEMA_VERSION=2.0
export ANALYSIS_PROMPT_VERSION=journal-analysis-v1

# === Stripe Test Mode Configuration (Required) ===
# Dev stage MUST use Stripe test mode credentials (sk_test_*)
# These values should be populated from your local Stripe test account
# DO NOT COMMIT REAL CREDENTIALS - these are examples only
# Real values belong in backend/.env (git-ignored)

# Stripe test secret key
export STRIPE_SECRET_KEY=REPLACE_WITH_DEV_STRIPE_SECRET_KEY

# Stripe test webhook secret
export STRIPE_WEBHOOK_SECRET=REPLACE_WITH_DEV_STRIPE_WEBHOOK_SECRET

# Stripe test pricing
export STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_DEV_PRICE_ID

# Stripe test checkout/portal URLs (localhost for dev)
export STRIPE_CHECKOUT_SUCCESS_URL='http://localhost:5173/?checkout=success&session_id={CHECKOUT_SESSION_ID}'
export STRIPE_CHECKOUT_CANCEL_URL='http://localhost:5173/?checkout=cancelled'
export STRIPE_PORTAL_RETURN_URL='http://localhost:5173/'

# Stripe Secrets Manager ARN (populated after provision-stripe-secret)
export STRIPE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:114743615542:secret:journalm8/dev/stripe-XXXXXXX

# === Cognito Configuration ===
# These values are populated by create-auth script
# Initially, you may need to create these manually or run create-auth first
export COGNITO_USER_POOL_NAME=journalm8-dev-users
export COGNITO_USER_POOL_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_APP_CLIENT_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_DOMAIN=https://dev-auth-fake.example.com
export COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL_ID

# === Optional: Deployment Confirmation ===
# Dev does not require confirmation (can be omitted)
# export DEPLOY_CONFIRMATION=dev
