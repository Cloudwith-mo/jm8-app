# JM8 Production Environment Configuration
# Phase 1 contract for the owner-approved same-account production design.
# This file contains safe configuration only. Production remains NO-GO until
# every remaining promotion gate is resolved.

# === Core Configuration (Required) ===
export APP_NAME=journalm8
export STAGE=prod
export AWS_PROFILE=jm8-prod
export AWS_REGION=us-east-1

# === Same-Account Production Isolation (Required) ===
# Production initially shares account 114743615542 with dev and staging.
# Isolation is enforced through prod-scoped names and the separate jm8-prod
# deployment profile/role. Every value below is validated exactly.
# Verify the profile's account with:
#   aws sts get-caller-identity --profile jm8-prod --query Account --output text
export EXPECTED_AWS_ACCOUNT_ID=114743615542
export ACCOUNT_ID=114743615542
export PRODUCTION_ISOLATION_MODE=stage-scoped-same-account
export DEPLOY_CONFIRMATION=prod

# === Exact Production Resource Names ===
export TABLE_NAME=journalm8-prod-main
export RAW_BUCKET=journalm8-prod-raw-114743615542
export EXPORT_BUCKET=journalm8-prod-exports-114743615542
export FRONTEND_BUCKET=journalm8-prod-frontend-114743615542
export CLOUDFRONT_DISTRIBUTION_ID=REPLACE_AFTER_HOSTING_PROVISION
export FRONTEND_ORIGIN=https://REPLACE_AFTER_HOSTING_PROVISION.cloudfront.net

# === API Configuration (Required) ===
export API_NAME=journalm8-prod-api
export API_ENDPOINT=https://REPLACE_WITH_PROD_API_ID.execute-api.us-east-1.amazonaws.com
export ALLOWED_ORIGINS=https://app.journalm8.com

# === Bedrock Configuration ===
export BEDROCK_ANALYSIS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
export ANALYSIS_SCHEMA_VERSION=2.0
export ANALYSIS_PROMPT_VERSION=journal-analysis-v1

# === Stripe Live-Mode Safe Configuration ===
# Enter live API and webhook secret material interactively only while running
# the provisioning workflow. Store it in Secrets Manager; never write it here.
export STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_PROD_PRICE_ID

export STRIPE_CHECKOUT_SUCCESS_URL='https://app.journalm8.com/settings?checkout=success&session_id={CHECKOUT_SESSION_ID}'
export STRIPE_CHECKOUT_CANCEL_URL='https://app.journalm8.com/settings?checkout=cancelled'
export STRIPE_PORTAL_RETURN_URL='https://app.journalm8.com/settings'

export STRIPE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:114743615542:secret:journalm8/prod/stripe-XXXXXX

# === Cognito Configuration ===
# Production Cognito pool and client must be completely isolated from dev/staging
# These values are populated by create-auth script
export COGNITO_USER_POOL_NAME=journalm8-prod-users
export COGNITO_USER_POOL_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_APP_CLIENT_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_DOMAIN=https://journalm8-prod-114743615542.auth.us-east-1.amazoncognito.com
export COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL_ID
export CALLBACK_URL=https://app.journalm8.com
export LOGOUT_URL=https://app.journalm8.com

# === Additional Production Safety Requirements ===
# Before production deployment, ensure:
# 1. jm8-prod is a separate deployment role/profile in account 114743615542
# 2. The exact isolation acknowledgment and prod confirmation are set
# 3. Every resource reference is prod-scoped
# 4. Production Stripe material is live mode and stored only in Secrets Manager
# 5. DynamoDB has point-in-time recovery and deletion protection enabled
# 6. S3 bucket has versioning, encryption, and HTTPS-only policy enabled
# 7. CloudTrail logging is enabled for all API calls
# 8. CloudWatch alarms are configured for critical metrics
# 9. Backup and disaster recovery procedures are documented
