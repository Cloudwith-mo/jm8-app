# JM8 Production Environment Configuration
# DO NOT USE YET - Production requires a separate AWS account
# This template documents the configuration structure for future production setup

# === Core Configuration (Required) ===
export APP_NAME=journalm8
export STAGE=prod
export AWS_PROFILE=jm8-prod
export AWS_REGION=us-east-1

# === AWS Account Validation (REQUIRED - MUST BE SET) ===
# Production MUST use a separate AWS account (NOT 114743615542)
# This account must be created, secured, and distinct from dev/staging
# Fetch the production account ID with:
#   aws sts get-caller-identity --profile jm8-prod --query Account --output text
#
# Once the production account is provisioned:
# 1. Set EXPECTED_AWS_ACCOUNT_ID to the actual production account ID
# 2. Ensure AWS_PROFILE=jm8-prod is configured with credentials for that account
# 3. Verify this file is never committed to git
#
# Until then, deployments to prod will fail with:
#   "STAGE=prod is not yet configured. Production requires a separate AWS account."
export EXPECTED_AWS_ACCOUNT_ID=PRODUCTION_ACCOUNT_ID_NOT_YET_CONFIGURED

# === Derived Resource Names (Will Match Production Account) ===
# These are computed from APP_NAME, STAGE, and actual AWS account ID
# Deployment scripts will validate these match expected patterns
export TABLE_NAME=journalm8-prod-main
export RAW_BUCKET=journalm8-prod-raw-PRODUCTION_ACCOUNT_ID

# === API Configuration (Required) ===
# API_ENDPOINT is populated by create-api after infrastructure is provisioned
# Should be the production API Gateway endpoint
export API_ENDPOINT=https://REPLACE_WITH_PROD_API_ID.execute-api.us-east-1.amazonaws.com
export ALLOWED_ORIGINS=https://app.journalm8.com

# === Bedrock Configuration ===
export BEDROCK_ANALYSIS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
export ANALYSIS_SCHEMA_VERSION=2.0
export ANALYSIS_PROMPT_VERSION=journal-analysis-v1

# === Stripe LIVE Mode Configuration (REQUIRED for Production) ===
# Production MUST use Stripe LIVE MODE credentials (sk_live_*)
# Live mode credentials must be:
# - Stored securely in AWS Secrets Manager
# - Never committed to git
# - Never logged or printed in deployment output
# - Treated as highly sensitive
#
# Real production Stripe keys belong in AWS Secrets Manager only.
# This file should contain safe placeholders like 'REPLACE_WITH_PROD_STRIPE_SECRET_KEY'
# Real values are loaded at runtime from AWS Secrets Manager via provision-stripe-secret

# Stripe LIVE secret key - DO NOT COMMIT REAL VALUES
export STRIPE_SECRET_KEY=REPLACE_WITH_PROD_STRIPE_SECRET_KEY

# Stripe LIVE webhook secret - DO NOT COMMIT REAL VALUES
export STRIPE_WEBHOOK_SECRET=REPLACE_WITH_PROD_STRIPE_WEBHOOK_SECRET

# Stripe LIVE pricing - must match production catalog
export STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_PROD_PRICE_ID

# Stripe LIVE checkout/portal URLs (production domain only, never localhost)
export STRIPE_CHECKOUT_SUCCESS_URL='https://app.journalm8.com/checkout=success&session_id={CHECKOUT_SESSION_ID}'
export STRIPE_CHECKOUT_CANCEL_URL='https://app.journalm8.com/checkout=cancelled'
export STRIPE_PORTAL_RETURN_URL='https://app.journalm8.com/'

# Stripe Secrets Manager ARN (populated after provision-stripe-secret in prod account)
export STRIPE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:PRODUCTION_ACCOUNT_ID:secret:journalm8/prod/stripe-XXXXXXX

# === Cognito Configuration ===
# Production Cognito pool and client must be completely isolated from dev/staging
# These values are populated by create-auth script
export COGNITO_USER_POOL_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_APP_CLIENT_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_DOMAIN=https://journalm8-prod-PRODUCTION_ACCOUNT_ID.auth.us-east-1.amazoncognito.com
export COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL_ID

# === REQUIRED: Production Deployment Confirmation ===
# Production deployments require explicit confirmation AND a separate account
# This prevents accidental production changes
# Set BEFORE running any production deployment scripts
export DEPLOY_CONFIRMATION=prod

# === Additional Production Safety Requirements ===
# Before production deployment, ensure:
# 1. Separate AWS account is provisioned (jm8-prod)
# 2. EXPECTED_AWS_ACCOUNT_ID is set to actual production account
# 3. AWS_PROFILE=jm8-prod is configured with prod credentials
# 4. DEPLOY_CONFIRMATION=prod is set
# 5. All production Stripe keys are live mode (sk_live_*)
# 6. DynamoDB has point-in-time recovery and deletion protection enabled
# 7. S3 bucket has versioning, encryption, and HTTPS-only policy enabled
# 8. CloudTrail logging is enabled for all API calls
# 9. CloudWatch alarms are configured for critical metrics
# 10. Backup and disaster recovery procedures are documented
