# JM8 Staging Environment Configuration
# Copy this file to a staging/.env and fill in actual values
# WARNING: Never commit secrets to git. Secrets should be loaded from AWS Secrets Manager

# === Core Configuration (Required) ===
export APP_NAME=journalm8
export STAGE=staging
export AWS_PROFILE=jm8-dev
export AWS_REGION=us-east-1

# === AWS Account Validation (Required) ===
# EXPECTED_AWS_ACCOUNT_ID must match the actual account ID for jm8-staging profile
# During MVP, staging shares account 114743615542 with dev
# Fetch with: aws sts get-caller-identity --profile jm8-staging --query Account --output text
export EXPECTED_AWS_ACCOUNT_ID=114743615542

# === Derived Resource Names (Auto-Populated, Do Not Change) ===
# These are computed from APP_NAME, STAGE, and actual AWS account ID
# Deployment scripts will validate these match expected patterns
export TABLE_NAME=journalm8-staging-main
export RAW_BUCKET=journalm8-staging-raw-114743615542
export EXPORT_BUCKET=journalm8-staging-exports-114743615542
export FRONTEND_BUCKET=journalm8-staging-frontend-114743615542
export CLOUDFRONT_DISTRIBUTION_ID=REPLACE_AFTER_HOSTING_PROVISION
export FRONTEND_ORIGIN=https://REPLACE_AFTER_HOSTING_PROVISION.cloudfront.net

# === API Configuration (Required) ===
# API_ENDPOINT is populated by create-api after infrastructure is provisioned
# Should be the staging API Gateway endpoint (not localhost)
export API_ENDPOINT=https://REPLACE_WITH_STAGING_API_ID.execute-api.us-east-1.amazonaws.com
export ALLOWED_ORIGINS=https://REPLACE_AFTER_HOSTING_PROVISION.cloudfront.net

# === Bedrock Configuration ===
export BEDROCK_ANALYSIS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
export ANALYSIS_SCHEMA_VERSION=2.0
export ANALYSIS_PROMPT_VERSION=journal-analysis-v1

# === Stripe Test Mode Configuration (Required for Staging) ===
# Staging must also use Stripe test mode credentials (sk_test_*)
# This allows testing production workflows without affecting live Stripe data
# Real values belong in secrets management (AWS Secrets Manager), not here

# Stripe test secret key
export STRIPE_SECRET_KEY=REPLACE_WITH_STAGING_STRIPE_SECRET_KEY

# Stripe test webhook secret (must be staging-specific webhook)
export STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STAGING_STRIPE_WEBHOOK_SECRET

# Stripe test pricing (may differ from dev for staging-specific testing)
export STRIPE_PRO_MONTHLY_PRICE_ID=price_REPLACE_WITH_STAGING_PRICE_ID

# Stripe test checkout/portal URLs (staging domain, NOT localhost)
export STRIPE_CHECKOUT_SUCCESS_URL='https://staging.example.com/checkout=success&session_id={CHECKOUT_SESSION_ID}'
export STRIPE_CHECKOUT_CANCEL_URL='https://staging.example.com/checkout=cancelled'
export STRIPE_PORTAL_RETURN_URL='https://staging.example.com/'

# Stripe Secrets Manager ARN (populated after provision-stripe-secret)
export STRIPE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:114743615542:secret:journalm8/staging/stripe-XXXXXXX

# === Cognito Configuration ===
# These values are populated by create-auth script
# Staging Cognito pool and client must be separate from dev
export COGNITO_USER_POOL_NAME=journalm8-staging-users
export COGNITO_USER_POOL_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_APP_CLIENT_ID=REPLACE_AFTER_CREATE_AUTH
export COGNITO_DOMAIN=https://staging-auth-fake.example.com
export COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_POOL_ID

# === Required: Deployment Confirmation ===
# Staging requires explicit confirmation to prevent accidental deployments
# Set this before running any deployment scripts
export DEPLOY_CONFIRMATION=staging
